<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.javaclaw</groupId>
        <artifactId>javaclaw-parent</artifactId>
        <version>5.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>javaclaw-native-hosts</artifactId>
    <name>JavaClaw Native Hosts</name>
    <dependencies>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-extension-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>native-hosts-unix-coverage</id>
            <activation>
                <os>
                    <family>unix</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>verify-coverage</id>
                                <configuration>
                                    <excludes>
                                        <exclude>com/javaclaw/nativehost/ffm/Windows*</exclude>
                                        <exclude>com/javaclaw/nativehost/sandbox/Windows*</exclude>
                                        <exclude>com/javaclaw/nativehost/transport/Windows*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-hosts-windows-coverage</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>verify-coverage</id>
                                <configuration>
                                    <excludes>
                                        <exclude>com/javaclaw/nativehost/ffm/Posix*</exclude>
                                        <exclude>com/javaclaw/nativehost/sandbox/Linux*</exclude>
                                        <exclude>com/javaclaw/nativehost/sandbox/Mac*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
