{
  "manifestVersion": 2,
  "id": "echo-model",
  "name": "Echo 协议验证模型",
  "version": "2.0.0",
  "description": "确定性回声与哈希向量夹具，用于验证独立 MODEL 插件；不是真实语言模型。",
  "publisher": "JavaClaw samples",
  "protocol": {
    "major": 2,
    "minor": 0
  },
  "entrypoint": "com.javaclaw.plugins.echo.EchoModelPlugin",
  "artifact": "plugin.jar",
  "permissions": [],
  "capabilities": [
    "MODEL"
  ],
  "inference": {
    "engine": "deterministic-echo-fixture",
    "engineVersion": "1",
    "adapterVersion": "2",
    "protocol": {
      "major": 1,
      "minor": 2
    },
    "capabilities": [
      "chat",
      "streaming",
      "embeddings",
      "cancellation",
      "exact_usage",
      "terminal_usage",
      "model-type:generation:echo",
      "model-type:embedding:echo"
    ],
    "parameterSchema": {
      "type": "object",
      "properties": {
        "load": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "generation": {
          "type": "object",
          "properties": {
            "maxTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536,
              "default": 1024,
              "title": "最大输出字符数"
            },
            "delayMillis": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 0,
              "title": "验证流取消的每字符延迟毫秒"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "model-types": [
      "echo"
    ]
  },
  "contributions": [
    {
      "id": "inference",
      "capability": "MODEL",
      "contractVersion": "2.0",
      "name": "Echo 协议验证模型",
      "description": "确定性回声与哈希向量，不执行语言模型推理",
      "inputSchema": {
        "type": "object"
      },
      "metadata": {
        "engine": "deterministic-echo-fixture",
        "engineVersion": "1",
        "adapterVersion": "2",
        "protocol": {
          "major": 1,
          "minor": 2
        },
        "capabilities": [
          "chat",
          "streaming",
          "embeddings",
          "cancellation",
          "exact_usage",
          "terminal_usage",
          "model-type:generation:echo",
          "model-type:embedding:echo"
        ],
        "parameterSchema": {
          "type": "object",
          "properties": {
            "load": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            },
            "generation": {
              "type": "object",
              "properties": {
                "maxTokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536,
                  "default": 1024,
                  "title": "最大输出字符数"
                },
                "delayMillis": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 0,
                  "title": "验证流取消的每字符延迟毫秒"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "model-types": [
          "echo"
        ]
      }
    }
  ],
  "configurationSchema": {
    "type": "object",
    "properties": {
      "prefix": {
        "type": "string",
        "maxLength": 128,
        "title": "回复前缀"
      }
    },
    "additionalProperties": false
  },
  "uiSchema": {
    "schemaVersion": 1,
    "pages": [
      {
        "id": "models",
        "title": "模型",
        "description": "从本地导入 fixtures/minimal 目录；模型只用于协议验证。",
        "sections": [
          {
            "id": "catalog",
            "type": "INFERENCE_CATALOG",
            "title": "本地模型",
            "description": "模型格式为 echo-model.json，没有远端权重下载。"
          }
        ]
      },
      {
        "id": "service",
        "title": "服务",
        "sections": [
          {
            "id": "runtime",
            "type": "SERVICE_RUNTIME",
            "title": "进程与资源"
          },
          {
            "id": "inference",
            "type": "INFERENCE_SERVICE",
            "title": "模型加载与验证"
          }
        ]
      }
    ]
  },
  "runtime": {
    "minimumJavaVersion": 25
  },
  "resources": {
    "heapMiB": 128,
    "exclusive": false
  }
}
