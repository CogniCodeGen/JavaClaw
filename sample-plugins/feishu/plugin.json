{
  "id": "feishu",
  "name": "飞书消息助手",
  "version": "2.0.0",
  "publisher": "JavaClaw 示例",
  "description": "在独立进程接收飞书消息，通过受限宿主能力回复。",
  "protocol": {
    "major": 2,
    "minor": 0
  },
  "entrypoint": "com.javaclaw.plugins.feishu.FeishuPlugin",
  "artifact": "plugin.jar",
  "permissions": [
    "host.agent.chat"
  ],
  "capabilities": [
    "TOOL",
    "SKILL"
  ],
  "contributions": [
    {
      "id": "feishu_send",
      "capability": "TOOL",
      "contractVersion": "2.0",
      "name": "发送飞书消息",
      "description": "主动发送文本",
      "inputSchema": {
        "type": "object",
        "required": [
          "receive_id",
          "text"
        ],
        "properties": {
          "receive_id": {
            "type": "string"
          },
          "id_type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "feishu_messages",
      "capability": "TOOL",
      "contractVersion": "2.0",
      "name": "飞书消息历史",
      "description": "查看最近收到的文本",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "id": "feishu_reply_style",
      "capability": "SKILL",
      "contractVersion": "2.0",
      "name": "飞书回复规范",
      "description": "飞书纯文本回复风格",
      "inputSchema": {}
    }
  ],
  "configurationSchema": {
    "type": "object",
    "required": [
      "appId",
      "appSecret"
    ],
    "properties": {
      "appId": {
        "type": "string",
        "title": "App ID",
        "minLength": 1
      },
      "appSecret": {
        "type": "string",
        "title": "App Secret",
        "minLength": 1,
        "format": "password",
        "x-secret": true,
        "writeOnly": true,
        "x-javaclaw-secret": true
      }
    }
  },
  "uiSchema": {
    "pages": [
      {
        "id": "configuration",
        "title": "飞书配置",
        "type": "SCHEMA_FORM"
      }
    ]
  }
}
