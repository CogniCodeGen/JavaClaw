{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/instruction-v3.schema.json",
  "title": "JavaClaw Protocol v3 project instruction methods",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "worktreeId"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/uuid"},
        "worktreeId": {"anyOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]}
      }
    },
    "settingsReadParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId"],
      "properties": {"workspaceId": {"$ref": "#/$defs/uuid"}}
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "fallbackBasename", "revision", "updatedAt"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/uuid"},
        "fallbackBasename": {
          "anyOf": [
            {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
            {"type": "null"}
          ]
        },
        "revision": {"type": "integer", "minimum": 1},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "settingsUpdateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 1},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspaceId", "fallbackBasename"],
          "properties": {
            "workspaceId": {"$ref": "#/$defs/uuid"},
            "fallbackBasename": {
              "anyOf": [
                {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
                {"type": "null"}
              ]
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "relativePath", "digest", "byteCount", "includedBytes", "truncated", "errorCode"],
      "properties": {
        "scope": {"enum": ["GLOBAL", "PROJECT"]},
        "relativePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "byteCount": {"type": "integer", "minimum": 0},
        "includedBytes": {"type": "integer", "minimum": 0, "maximum": 32768},
        "truncated": {"type": "boolean"},
        "errorCode": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$"}, {"type": "null"}]}
      },
      "oneOf": [
        {"properties": {"digest": {"$ref": "#/$defs/digest"}, "errorCode": {"type": "null"}}},
        {"properties": {"digest": {"type": "null"}, "errorCode": {"type": "string"}, "includedBytes": {"const": 0}, "truncated": {"const": false}}}
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "digest", "globalIncludedBytes", "projectIncludedBytes", "warnings", "resolvedAt"],
      "properties": {
        "sources": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/source"}},
        "digest": {"$ref": "#/$defs/digest"},
        "globalIncludedBytes": {"type": "integer", "minimum": 0, "maximum": 32768},
        "projectIncludedBytes": {"type": "integer", "minimum": 0, "maximum": 32768},
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1024,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$"}
        },
        "resolvedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
