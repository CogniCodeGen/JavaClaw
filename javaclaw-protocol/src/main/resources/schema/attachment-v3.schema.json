{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/attachment-v3.schema.json",
  "title": "JavaClaw Protocol v3 chunked Attachment methods",
  "$defs": {
    "downloadChunkPayload": {"type": "object", "additionalProperties": false, "required": ["scope", "digest", "offsetBytes", "maximumBytes"], "properties": {"scope": {"$ref": "#/$defs/scope"}, "digest": {"$ref": "#/$defs/digest"}, "offsetBytes": {"type": "integer", "minimum": 0}, "maximumBytes": {"type": "integer", "minimum": 1, "maximum": 262144}}},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uploadId": {"type": "string", "format": "uuid"},
    "workspaceId": {"type": "string", "format": "uuid"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workspaceId"],
      "properties": {
        "kind": {"enum": ["GLOBAL", "WORKSPACE"]},
        "workspaceId": {"anyOf": [{"$ref": "#/$defs/workspaceId"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "GLOBAL"}}}, "then": {"properties": {"workspaceId": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "WORKSPACE"}}}, "then": {"properties": {"workspaceId": {"$ref": "#/$defs/workspaceId"}}}}
      ]
    },
    "writeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      }
    },
    "beginPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "mediaType", "expectedDigest", "expectedSizeBytes"],
      "properties": {
        "scope": {"$ref": "#/$defs/scope"},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 240},
        "expectedDigest": {"$ref": "#/$defs/digest"},
        "expectedSizeBytes": {"type": "integer", "minimum": 1, "maximum": 67108864}
      }
    },
    "chunkPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "uploadId", "chunkIndex", "content"],
      "properties": {
        "scope": {"$ref": "#/$defs/scope"},
        "uploadId": {"$ref": "#/$defs/uploadId"},
        "chunkIndex": {"type": "integer", "minimum": 0, "maximum": 1023},
        "content": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 4,
          "maxLength": 349528
        }
      }
    },
    "completePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "uploadId"],
      "properties": {"scope": {"$ref": "#/$defs/scope"}, "uploadId": {"$ref": "#/$defs/uploadId"}}
    },
    "abortPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "uploadId", "reason"],
      "properties": {
        "scope": {"$ref": "#/$defs/scope"},
        "uploadId": {"$ref": "#/$defs/uploadId"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "readUploadPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "uploadId"],
      "properties": {"scope": {"$ref": "#/$defs/scope"}, "uploadId": {"$ref": "#/$defs/uploadId"}}
    },
    "readAttachmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "digest"],
      "properties": {"scope": {"$ref": "#/$defs/scope"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "attachmentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "mediaType", "sizeBytes", "createdAt"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 240},
        "sizeBytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "uploadSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "scope", "state", "mediaType", "expectedDigest", "expectedSizeBytes",
        "receivedSizeBytes", "nextChunkIndex", "revision", "createdAt", "updatedAt",
        "expiresAt", "attachment", "failureReason"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uploadId"},
        "scope": {"$ref": "#/$defs/scope"},
        "state": {"enum": ["ACTIVE", "COMPLETED", "ABORTED", "FAILED", "EXPIRED"]},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 240},
        "expectedDigest": {"$ref": "#/$defs/digest"},
        "expectedSizeBytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "receivedSizeBytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "nextChunkIndex": {"type": "integer", "minimum": 0, "maximum": 1024},
        "revision": {"type": "integer", "minimum": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "attachment": {"anyOf": [{"$ref": "#/$defs/attachmentMetadata"}, {"type": "null"}]},
        "failureReason": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "attachmentContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata", "content"],
      "properties": {
        "metadata": {"$ref": "#/$defs/attachmentMetadata"},
        "content": {"type": "string", "contentEncoding": "base64", "maxLength": 89478488}
      }
    },
    "beginCommand": {"allOf": [{"$ref": "#/$defs/writeCommand"}, {"properties": {"payload": {"$ref": "#/$defs/beginPayload"}}}]},
    "chunkCommand": {"allOf": [{"$ref": "#/$defs/writeCommand"}, {"properties": {"payload": {"$ref": "#/$defs/chunkPayload"}}}]},
    "completeCommand": {"allOf": [{"$ref": "#/$defs/writeCommand"}, {"properties": {"payload": {"$ref": "#/$defs/completePayload"}}}]},
    "abortCommand": {"allOf": [{"$ref": "#/$defs/writeCommand"}, {"properties": {"payload": {"$ref": "#/$defs/abortPayload"}}}]}
  }
}
