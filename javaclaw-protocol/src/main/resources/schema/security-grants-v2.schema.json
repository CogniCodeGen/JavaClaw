{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/security-grants-v2.schema.json",
  "title": "JavaClaw Protocol v2 security grant methods",
  "type": "object",
  "additionalProperties": false,
  "required": ["methods"],
  "properties": {
    "methods": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privateNetworkGrant/preview",
        "privateNetworkGrant/list",
        "privateNetworkGrant/history",
        "privateNetworkGrant/create",
        "privateNetworkGrant/revoke",
        "unattendedToolGrant/list",
        "unattendedToolGrant/history",
        "unattendedToolGrant/create",
        "unattendedToolGrant/revoke",
        "permissionDecision/list"
      ],
      "properties": {
        "privateNetworkGrant/preview": {"$ref": "#/$defs/privateNetworkPreviewMethod"},
        "privateNetworkGrant/list": {"$ref": "#/$defs/privateNetworkListMethod"},
        "privateNetworkGrant/history": {"$ref": "#/$defs/privateNetworkHistoryMethod"},
        "privateNetworkGrant/create": {"$ref": "#/$defs/privateNetworkCreateMethod"},
        "privateNetworkGrant/revoke": {"$ref": "#/$defs/privateNetworkRevokeMethod"},
        "unattendedToolGrant/list": {"$ref": "#/$defs/unattendedListMethod"},
        "unattendedToolGrant/history": {"$ref": "#/$defs/unattendedHistoryMethod"},
        "unattendedToolGrant/create": {"$ref": "#/$defs/unattendedCreateMethod"},
        "unattendedToolGrant/revoke": {"$ref": "#/$defs/unattendedRevokeMethod"},
        "permissionDecision/list": {"$ref": "#/$defs/permissionDecisionListMethod"}
      }
    }
  },
  "$defs": {
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["params", "result"],
      "properties": {
        "params": {"type": "object"},
        "result": {}
      }
    },
    "workspaceId": {"type": "string", "format": "uuid"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "origin": {"type": "string", "pattern": "^https://[^/?#]+/?$"},
    "addresses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 45}
    },
    "workspaceQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId"],
      "properties": {"workspaceId": {"$ref": "#/$defs/workspaceId"}}
    },
    "historyQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantId"],
      "properties": {"grantId": {"$ref": "#/$defs/identifier"}}
    },
    "writeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      }
    },
    "privateNetworkPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "purpose", "origin", "dnsAddresses", "expiresAt", "confirmationDigest"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/workspaceId"},
        "purpose": {"enum": ["MCP", "SITE"]},
        "origin": {"$ref": "#/$defs/origin"},
        "dnsAddresses": {"$ref": "#/$defs/addresses"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "confirmationDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "privateNetworkPreviewParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "purpose", "origin", "dnsAddresses", "validity"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/workspaceId"},
        "purpose": {"enum": ["MCP", "SITE"]},
        "origin": {"$ref": "#/$defs/origin"},
        "dnsAddresses": {"$ref": "#/$defs/addresses"},
        "validity": {"type": ["string", "null"], "format": "duration"}
      }
    },
    "privateNetworkCreateCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"expectedRevision": {"const": 0}, "payload": {
          "type": "object", "additionalProperties": false, "required": ["preview"],
          "properties": {"preview": {"$ref": "#/$defs/privateNetworkPreview"}}
        }}}
      ]
    },
    "revokeCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"expectedRevision": {"type": "integer", "minimum": 1}, "payload": {
          "type": "object", "additionalProperties": false, "required": ["grantId"],
          "properties": {"grantId": {"$ref": "#/$defs/identifier"}}
        }}}
      ]
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producerId", "name", "revision"],
      "properties": {
        "producerId": {"type": "string", "minLength": 1, "maxLength": 240},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "unattendedDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId", "scheduleId", "scheduleRevision", "tool", "catalogRevision", "schemaHash",
        "fixedArguments", "variableStringFields", "maximumUses", "validity"
      ],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/workspaceId"},
        "scheduleId": {"$ref": "#/$defs/identifier"},
        "scheduleRevision": {"type": "integer", "minimum": 1},
        "tool": {"$ref": "#/$defs/toolIdentity"},
        "catalogRevision": {"type": "integer", "minimum": 1},
        "schemaHash": {"$ref": "#/$defs/digest"},
        "fixedArguments": {"type": "object"},
        "variableStringFields": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "maximumUses": {"type": "integer", "minimum": 1, "maximum": 100},
        "validity": {"type": "string", "format": "duration"}
      }
    },
    "unattendedCreateCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"expectedRevision": {"const": 0}, "payload": {
          "type": "object", "additionalProperties": false, "required": ["draft"],
          "properties": {"draft": {"$ref": "#/$defs/unattendedDraft"}}
        }}}
      ]
    },
    "permissionDecisionListParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "grantKind", "grantId", "limit"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/workspaceId"},
        "grantKind": {"type": ["string", "null"], "enum": ["PRIVATE_NETWORK", "UNATTENDED_TOOL", null]},
        "grantId": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    },
    "privateNetworkPreviewMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/privateNetworkPreviewParams"}, "result": {"$ref": "#/$defs/privateNetworkPreview"}}
    },
    "privateNetworkListMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/workspaceQuery"}, "result": {"type": "object", "required": ["grants"]}}
    },
    "privateNetworkHistoryMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/historyQuery"}, "result": {"type": "object", "required": ["grants"]}}
    },
    "privateNetworkCreateMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/privateNetworkCreateCommand"}, "result": {"type": "object"}}
    },
    "privateNetworkRevokeMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/revokeCommand"}, "result": {"type": "object"}}
    },
    "unattendedListMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/workspaceQuery"}, "result": {"type": "object", "required": ["grants"]}}
    },
    "unattendedHistoryMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/historyQuery"}, "result": {"type": "object", "required": ["grants"]}}
    },
    "unattendedCreateMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/unattendedCreateCommand"}, "result": {"type": "object"}}
    },
    "unattendedRevokeMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/revokeCommand"}, "result": {"type": "object"}}
    },
    "permissionDecisionListMethod": {
      "allOf": [{"$ref": "#/$defs/method"}],
      "properties": {"params": {"$ref": "#/$defs/permissionDecisionListParams"}, "result": {"type": "object", "required": ["traces"]}}
    }
  }
}
