{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.dev/schema/extension-secret-v1.schema.json",
  "title": "扩展宿主密封命令",
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 0},
        "payload": {"$ref": "#/$defs/payload"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call", "secret"],
      "properties": {
        "call": {
          "allOf": [
            {"$ref": "extension-v3.schema.json#/$defs/callPayload"},
            {"properties": {"threadId": {"type": "null"}, "turnId": {"type": "null"}}}
          ]
        },
        "secret": {"$ref": "credential-v3.schema.json#/$defs/sealedSecret"}
      }
    }
  }
}
