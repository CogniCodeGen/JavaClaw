{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/view-schema-v3.schema.json",
  "title": "JavaClaw ViewSchema v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "viewId", "title", "dataSources", "nodes"],
  "properties": {
    "schemaVersion": {"const": 2},
    "viewId": {"$ref": "#/$defs/identifier"},
    "title": {"$ref": "#/$defs/text"},
    "dataSources": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/dataSource"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "operation": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{0,63}(/[a-z][a-z0-9._-]{0,63}){0,3}$"
    },
    "fieldName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "arguments": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {"type": "string", "maxLength": 4000}
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "query", "arguments", "argumentBindings", "pageSize"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "query": {"$ref": "#/$defs/operation"},
        "arguments": {"$ref": "#/$defs/arguments"},
        "argumentBindings": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/argumentBinding"}
        },
        "pageSize": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "argumentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argument", "sourceId", "rowField"],
      "properties": {
        "argument": {"$ref": "#/$defs/fieldName"},
        "sourceId": {"$ref": "#/$defs/identifier"},
        "rowField": {"$ref": "#/$defs/fieldName"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "field"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/identifier"},
        "field": {"$ref": "#/$defs/fieldName"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "command",
        "arguments",
        "rowArguments",
        "commandBindings",
        "expectedRevision",
        "dangerous"
      ],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "command": {"$ref": "#/$defs/operation"},
        "arguments": {"$ref": "#/$defs/arguments"},
        "rowArguments": {"$ref": "#/$defs/arguments"},
        "commandBindings": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/commandBinding"}
        },
        "expectedRevision": {"$ref": "#/$defs/expectedRevision"},
        "dangerous": {"type": "boolean"}
      }
    },
    "commandBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argumentName", "binding"],
      "properties": {
        "argumentName": {"$ref": "#/$defs/fieldName"},
        "binding": {"$ref": "#/$defs/binding"}
      }
    },
    "expectedRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sourceId", "field"],
      "properties": {
        "type": {"enum": ["none", "source", "row"]},
        "sourceId": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "field": {"oneOf": [{"$ref": "#/$defs/fieldName"}, {"type": "null"}]}
      },
      "oneOf": [
        {
          "properties": {
            "type": {"const": "none"},
            "sourceId": {"type": "null"},
            "field": {"type": "null"}
          }
        },
        {
          "properties": {
            "type": {"const": "source"},
            "sourceId": {"$ref": "#/$defs/identifier"},
            "field": {"type": "null"}
          }
        },
        {
          "properties": {
            "type": {"const": "row"},
            "sourceId": {"type": "null"},
            "field": {"$ref": "#/$defs/fieldName"}
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "minLength", "maxLength", "minimum", "maximum", "attachment"],
      "properties": {
        "required": {"type": "boolean"},
        "minLength": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "maxLength": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "attachment": {
          "oneOf": [{"$ref": "#/$defs/attachmentPolicy"}, {"type": "null"}]
        }
      }
    },
    "attachmentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedMediaTypes", "maximumBytes"],
      "properties": {
        "acceptedMediaTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/([a-z0-9][a-z0-9!#$&^_.+-]{0,127}|\\*)$"
          }
        },
        "maximumBytes": {"type": "integer", "minimum": 1, "maximum": 67108864}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {"$ref": "#/$defs/text"},
        "label": {"$ref": "#/$defs/text"}
      }
    },
    "optionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "valueField", "labelField", "filter"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/identifier"},
        "valueField": {"$ref": "#/$defs/fieldName"},
        "labelField": {"$ref": "#/$defs/fieldName"},
        "filter": {"oneOf": [{"$ref": "#/$defs/optionFilter"}, {"type": "null"}]}
      }
    },
    "optionFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField", "inputField"],
      "properties": {
        "sourceField": {"$ref": "#/$defs/fieldName"},
        "inputField": {"$ref": "#/$defs/fieldName"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "operator", "expectedValue"],
      "properties": {
        "binding": {"$ref": "#/$defs/binding"},
        "operator": {"enum": ["EQUALS", "NOT_EQUALS"]},
        "expectedValue": {"type": "string", "maxLength": 4000}
      }
    },
    "scalarField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "label", "type", "binding", "initialValue", "validation", "options", "optionSource", "visibleWhen"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/fieldName"},
        "label": {"$ref": "#/$defs/text"},
        "type": {"enum": ["TEXT", "MULTILINE", "NUMBER", "BOOLEAN", "CHOICE", "ATTACHMENT"]},
        "binding": {"$ref": "#/$defs/binding"},
        "initialValue": {"type": ["string", "null"], "maxLength": 1000000},
        "validation": {"$ref": "#/$defs/validation"},
        "options": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/option"}},
        "optionSource": {"oneOf": [{"$ref": "#/$defs/optionSource"}, {"type": "null"}]},
        "visibleWhen": {"oneOf": [{"$ref": "#/$defs/condition"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "ATTACHMENT"}}},
          "then": {
            "properties": {
              "validation": {
                "properties": {"attachment": {"$ref": "#/$defs/attachmentPolicy"}}
              }
            }
          },
          "else": {
            "properties": {
              "validation": {"properties": {"attachment": {"type": "null"}}}
            }
          }
        }
      ]
    },
    "structuredItemValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "minLength", "maxLength", "minimum", "maximum", "minItems", "maxItems"],
      "properties": {
        "required": {"type": "boolean"},
        "minLength": {"type": ["integer", "null"], "minimum": 0, "maximum": 4000},
        "maxLength": {"type": ["integer", "null"], "minimum": 0, "maximum": 4000},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "minItems": {"type": ["integer", "null"], "minimum": 0, "maximum": 32},
        "maxItems": {"type": ["integer", "null"], "minimum": 0, "maximum": 32}
      }
    },
    "structuredItemField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "label", "type", "initialValue", "initialTextList", "validation", "options", "optionSource"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/fieldName"},
        "label": {"$ref": "#/$defs/text"},
        "type": {"enum": ["TEXT", "MULTILINE", "NUMBER", "BOOLEAN", "CHOICE", "TEXT_LIST"]},
        "initialValue": {"type": ["string", "null"], "maxLength": 4000},
        "initialTextList": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "maxLength": 4000}
        },
        "validation": {"$ref": "#/$defs/structuredItemValidation"},
        "options": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/option"}},
        "optionSource": {"oneOf": [{"$ref": "#/$defs/optionSource"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "CHOICE"}}},
          "then": {
            "properties": {"initialTextList": {"maxItems": 0}},
            "anyOf": [
              {"properties": {"options": {"minItems": 1}}},
              {"properties": {"optionSource": {"$ref": "#/$defs/optionSource"}}}
            ]
          },
          "else": {"properties": {"options": {"maxItems": 0}, "optionSource": {"type": "null"}}}
        },
        {
          "if": {"properties": {"type": {"const": "TEXT_LIST"}}},
          "then": {"properties": {"initialValue": {"type": "null"}}},
          "else": {"properties": {"initialTextList": {"maxItems": 0}}}
        }
      ]
    },
    "structuredRow": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 17,
      "propertyNames": {"$ref": "#/$defs/fieldName"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "maxLength": 4000},
          {"type": "number"},
          {"type": "boolean"},
          {
            "type": "array",
            "maxItems": 32,
            "items": {"type": "string", "maxLength": 4000}
          }
        ]
      }
    },
    "structuredListField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "name", "label", "binding", "minRows", "maxRows", "itemKey", "itemFields",
        "initialRows", "visibleWhen"
      ],
      "properties": {
        "type": {"const": "STRUCTURED_LIST"},
        "name": {"$ref": "#/$defs/fieldName"},
        "label": {"$ref": "#/$defs/text"},
        "binding": {"$ref": "#/$defs/binding"},
        "minRows": {"type": "integer", "minimum": 0, "maximum": 100},
        "maxRows": {"type": "integer", "minimum": 1, "maximum": 100},
        "itemKey": {"$ref": "#/$defs/fieldName"},
        "itemFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/structuredItemField"}
        },
        "initialRows": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/structuredRow"}
        },
        "visibleWhen": {"oneOf": [{"$ref": "#/$defs/condition"}, {"type": "null"}]}
      }
    },
    "formField": {
      "oneOf": [
        {"$ref": "#/$defs/scalarField"},
        {"$ref": "#/$defs/structuredListField"}
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "label", "width"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "label": {"$ref": "#/$defs/text"},
        "width": {"type": ["integer", "null"], "minimum": 1, "maximum": 2000}
      }
    },
    "selection": {"enum": ["NONE", "SINGLE"]},
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "fields", "submit"],
      "properties": {
        "type": {"const": "form"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/formField"}
        },
        "submit": {"$ref": "#/$defs/action"}
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "id", "title", "sourceId", "keyField", "titleField", "detailField", "selection", "actions"
      ],
      "properties": {
        "type": {"const": "list"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "sourceId": {"$ref": "#/$defs/identifier"},
        "keyField": {"$ref": "#/$defs/fieldName"},
        "titleField": {"$ref": "#/$defs/fieldName"},
        "detailField": {"$ref": "#/$defs/fieldName"},
        "selection": {"$ref": "#/$defs/selection"},
        "actions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/action"}}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "sourceId", "keyField", "columns", "selection", "actions"],
      "properties": {
        "type": {"const": "table"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "sourceId": {"$ref": "#/$defs/identifier"},
        "keyField": {"$ref": "#/$defs/fieldName"},
        "columns": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/column"}},
        "selection": {"$ref": "#/$defs/selection"},
        "actions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/action"}}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "body", "actions"],
      "properties": {
        "type": {"const": "card"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "body": {"type": "string", "maxLength": 4000},
        "actions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/action"}}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "sourceId", "valueField", "labelField"],
      "properties": {
        "type": {"const": "progress"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "sourceId": {"$ref": "#/$defs/identifier"},
        "valueField": {"$ref": "#/$defs/fieldName"},
        "labelField": {"$ref": "#/$defs/fieldName"}
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "sourceId", "timeField", "contentField"],
      "properties": {
        "type": {"const": "timeline"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "sourceId": {"$ref": "#/$defs/identifier"},
        "timeField": {"$ref": "#/$defs/fieldName"},
        "contentField": {"$ref": "#/$defs/fieldName"}
      }
    },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "source"],
      "properties": {
        "type": {"const": "markdown"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/binding"}
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "source", "language"],
      "properties": {
        "type": {"const": "code"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/binding"},
        "language": {"oneOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "reference", "mediaType"],
      "properties": {
        "type": {"const": "artifact"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "reference": {"$ref": "#/$defs/binding"},
        "mediaType": {"$ref": "#/$defs/binding"}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "id", "title", "nodeSourceId", "edgeSourceId", "nodeIdField", "nodeLabelField",
        "nodeKindField", "edgeFromField", "edgeToField"
      ],
      "properties": {
        "type": {"const": "graph"},
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/text"},
        "nodeSourceId": {"$ref": "#/$defs/identifier"},
        "edgeSourceId": {"$ref": "#/$defs/identifier"},
        "nodeIdField": {"$ref": "#/$defs/fieldName"},
        "nodeLabelField": {"$ref": "#/$defs/fieldName"},
        "nodeKindField": {"$ref": "#/$defs/fieldName"},
        "edgeFromField": {"$ref": "#/$defs/fieldName"},
        "edgeToField": {"$ref": "#/$defs/fieldName"}
      }
    },
    "node": {
      "oneOf": [
        {"$ref": "#/$defs/form"},
        {"$ref": "#/$defs/list"},
        {"$ref": "#/$defs/table"},
        {"$ref": "#/$defs/card"},
        {"$ref": "#/$defs/progress"},
        {"$ref": "#/$defs/timeline"},
        {"$ref": "#/$defs/markdown"},
        {"$ref": "#/$defs/code"},
        {"$ref": "#/$defs/artifact"},
        {"$ref": "#/$defs/graph"}
      ]
    }
  }
}
