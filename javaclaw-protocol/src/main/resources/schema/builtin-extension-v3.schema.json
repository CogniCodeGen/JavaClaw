{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/builtin-extension-v3.schema.json",
  "title": "JavaClaw Protocol v3 built-in extension management",
  "$defs": {
    "empty": {"type": "object", "additionalProperties": false},
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,239}$"
    },
    "extensionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensionId"],
      "properties": {"extensionId": {"$ref": "#/$defs/extensionId"}}
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "displayName", "version", "descriptorRevision", "stateRevision",
        "availability", "state", "runtimeKind", "contributionKinds", "updatedAt"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/extensionId"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 240},
        "version": {"type": "string", "minLength": 1, "maxLength": 120},
        "descriptorRevision": {"type": "integer", "minimum": 1},
        "stateRevision": {"type": "integer", "minimum": 1},
        "availability": {"enum": ["REQUIRED", "OPTIONAL"]},
        "state": {"enum": ["INSTALLED", "STARTING", "ENABLED", "DISABLED", "QUARANTINED", "REMOVING"]},
        "runtimeKind": {"enum": ["BUNDLE", "PLATFORM"]},
        "contributionKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "TOOL", "CONTEXT", "ORCHESTRATOR", "TIMER", "SCHEDULABLE_ACTION", "COMMAND", "QUERY",
              "VIEW", "SKILL", "MCP", "HOOK", "SERVICE"
            ]
          }
        },
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "listResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions"],
      "properties": {"extensions": {"type": "array", "items": {"$ref": "#/$defs/status"}}}
    },
    "statusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension"],
      "properties": {"extension": {"$ref": "#/$defs/status"}}
    },
    "writeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 1},
        "payload": {"$ref": "#/$defs/extensionPayload"}
      }
    }
  }
}
