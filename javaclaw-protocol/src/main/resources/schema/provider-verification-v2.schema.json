{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/provider-verification-v2.schema.json",
  "title": "JavaClaw Protocol v2 billed Provider verification",
  "$defs": {
    "providerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpointId", "endpointRevision", "model"],
      "properties": {
        "endpointId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$"},
        "endpointRevision": {"type": "integer", "minimum": 1},
        "model": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "reasoningTokens", "cachedInputTokens"],
      "properties": {
        "inputTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0},
        "reasoningTokens": {"type": "integer", "minimum": 0},
        "cachedInputTokens": {"type": "integer", "minimum": 0}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "streaming", "toolCalls", "structuredOutput", "images", "reasoningSummary", "opaqueState", "nativeCompaction"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["CHAT", "EMBEDDING"]}
        },
        "streaming": {"type": "boolean"},
        "toolCalls": {"type": "boolean"},
        "structuredOutput": {"type": "boolean"},
        "images": {"type": "boolean"},
        "reasoningSummary": {"type": "boolean"},
        "opaqueState": {"type": "boolean"},
        "nativeCompaction": {"type": "boolean"}
      }
    },
    "verifyCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 1},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "billingConfirmed", "confirmation"],
          "properties": {
            "provider": {"$ref": "#/$defs/providerRef"},
            "billingConfirmed": {"const": true},
            "confirmation": {"const": "我确认本次模型验证可能产生费用"}
          }
        }
      }
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "state", "latencyMillis", "usage", "capabilities", "errorCode", "completedAt"],
      "properties": {
        "provider": {"$ref": "#/$defs/providerRef"},
        "state": {"enum": ["SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED", "UNKNOWN_OUTCOME"]},
        "latencyMillis": {"type": "integer", "minimum": 0},
        "usage": {"oneOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "errorCode": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
        "completedAt": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "SUCCEEDED"}}},
          "then": {
            "properties": {
              "usage": {"$ref": "#/$defs/usage"},
              "errorCode": {"type": "null"}
            }
          },
          "else": {"properties": {"errorCode": {"type": "string", "minLength": 1, "maxLength": 160}}}
        },
        {
          "if": {"properties": {"state": {"const": "UNKNOWN_OUTCOME"}}},
          "then": {
            "properties": {
              "latencyMillis": {"const": 0},
              "usage": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
