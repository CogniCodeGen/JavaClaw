{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/provider-verification-v3.schema.json",
  "title": "JavaClaw Protocol v3 billed Provider verification",
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "reasoningTokens", "cachedInputTokens"],
      "properties": {
        "inputTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0},
        "reasoningTokens": {"type": "integer", "minimum": 0},
        "cachedInputTokens": {"type": "integer", "minimum": 0}
      }
    },
    "verifyCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 1},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "purpose", "billingConfirmed", "confirmation"],
          "properties": {
            "provider": {"$ref": "provider-v3.schema.json#/$defs/providerRef"},
            "purpose": {"enum": ["CHAT", "EMBEDDING"]},
            "billingConfirmed": {"const": true},
            "confirmation": {"const": "我确认本次模型验证可能产生费用"}
          }
        }
      }
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "purpose", "state", "latencyMillis", "usage", "capabilities", "errorCode", "completedAt"],
      "properties": {
        "provider": {"$ref": "provider-v3.schema.json#/$defs/providerRef"},
        "purpose": {"enum": ["CHAT", "EMBEDDING"]},
        "state": {"enum": ["SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED", "UNKNOWN_OUTCOME"]},
        "latencyMillis": {"type": "integer", "minimum": 0},
        "usage": {"oneOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "capabilities": {"$ref": "provider-v3.schema.json#/$defs/providerCapabilities"},
        "errorCode": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
        "completedAt": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "SUCCEEDED"}}},
          "then": {
            "properties": {
              "errorCode": {"type": "null"}
            }
          },
          "else": {"properties": {"errorCode": {"type": "string", "minLength": 1, "maxLength": 160}}}
        },
        {
          "if": {
            "properties": {
              "state": {"const": "SUCCEEDED"},
              "purpose": {"const": "CHAT"}
            },
            "required": ["state", "purpose"]
          },
          "then": {"properties": {"usage": {"$ref": "#/$defs/usage"}}}
        },
        {
          "if": {"properties": {"purpose": {"const": "EMBEDDING"}}},
          "then": {"properties": {"usage": {"type": "null"}}}
        },
        {
          "if": {"properties": {"state": {"const": "UNKNOWN_OUTCOME"}}},
          "then": {
            "properties": {
              "latencyMillis": {"const": 0},
              "usage": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
