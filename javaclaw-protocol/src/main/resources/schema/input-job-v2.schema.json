{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/input-job-v2.schema.json",
  "title": "JavaClaw Protocol v2 input and extension job methods",
  "$defs": {
    "canonicalPayload": {"type": "object"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "writeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 0},
        "payload": {"$ref": "#/$defs/canonicalPayload"}
      }
    },
    "inputListPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId", "includeResolved"],
      "properties": {
        "turnId": {"type": ["string", "null"], "format": "uuid"},
        "includeResolved": {"type": "boolean"}
      }
    },
    "inputResolvePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "response"],
      "properties": {
        "requestId": {"$ref": "#/$defs/id"},
        "response": {"$ref": "#/$defs/canonicalPayload"}
      }
    },
    "inputResolveCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"payload": {"$ref": "#/$defs/inputResolvePayload"}}}
      ]
    },
    "inputRequestRecord": {
      "type": "object",
      "required": ["request", "state", "revision", "response", "resolutionReason", "updatedAt"]
    },
    "inputListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests"],
      "properties": {"requests": {"type": "array", "items": {"$ref": "#/$defs/inputRequestRecord"}}}
    },
    "executionState": {
      "enum": ["QUEUED", "RUNNING", "WAITING_APPROVAL", "WAITING_INPUT", "PAUSED", "COMPLETED", "FAILED", "CANCELLED"]
    },
    "jobListPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "extensionId", "states", "after", "limit"],
      "properties": {
        "workspaceId": {"type": ["string", "null"], "format": "uuid"},
        "extensionId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "states": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/executionState"}},
        "after": {
          "anyOf": [
            {"$ref": "#/$defs/jobCursor"},
            {"type": "null"}
          ]
        },
        "limit": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "jobCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["updatedAt", "id"],
      "properties": {
        "updatedAt": {"type": "string", "format": "date-time"},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "extensionExecutionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "extensionId", "workspaceId", "jobType", "definitionId", "definitionRevision", "state", "revision", "errorCode", "createdAt", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "extensionId": {"$ref": "#/$defs/id"},
        "workspaceId": {"type": "string", "format": "uuid"},
        "jobType": {"$ref": "#/$defs/id"},
        "definitionId": {"$ref": "#/$defs/id"},
        "definitionRevision": {"type": "integer", "minimum": 1},
        "state": {"$ref": "#/$defs/executionState"},
        "revision": {"type": "integer", "minimum": 1},
        "errorCode": {
          "anyOf": [
            {"type": "string", "minLength": 1, "maxLength": 500},
            {"type": "null"}
          ]
        },
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "jobListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs", "nextCursor"],
      "properties": {
        "jobs": {"type": "array", "items": {"$ref": "#/$defs/extensionExecutionReceipt"}},
        "nextCursor": {
          "anyOf": [
            {"$ref": "#/$defs/jobCursor"},
            {"type": "null"}
          ]
        }
      }
    },
    "jobReadPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId"],
      "properties": {"jobId": {"$ref": "#/$defs/id"}}
    },
    "jobReadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job", "units"],
      "properties": {
        "job": {"$ref": "#/$defs/extensionExecutionReceipt"},
        "units": {"type": "array", "items": {"$ref": "#/$defs/jobUnitSummary"}}
      }
    },
    "jobUnitSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "sequence", "unitId", "state", "turnId", "effectReceiptKey", "errorCode", "createdAt", "completedAt"],
      "properties": {
        "jobId": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1},
        "unitId": {"$ref": "#/$defs/id"},
        "state": {"enum": ["INTENT_RECORDED", "RUNNING", "COMPLETED", "FAILED", "UNKNOWN_OUTCOME"]},
        "turnId": {"type": ["string", "null"], "format": "uuid"},
        "effectReceiptKey": {"type": ["string", "null"], "maxLength": 500},
        "errorCode": {"type": ["string", "null"], "maxLength": 500},
        "createdAt": {"type": "string", "format": "date-time"},
        "completedAt": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "jobMutationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId"],
      "properties": {"jobId": {"$ref": "#/$defs/id"}}
    },
    "jobMutationCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"payload": {"$ref": "#/$defs/jobMutationPayload"}}}
      ]
    }
  }
}
