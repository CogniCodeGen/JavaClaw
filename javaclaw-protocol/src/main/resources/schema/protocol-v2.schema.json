{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/protocol-v2.schema.json",
  "title": "JavaClaw App Protocol v2 JSON-RPC envelope",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/notification"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/failure"}
  ],
  "$defs": {
    "payload": {"type": "object"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "method": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(/[a-z][a-zA-Z0-9]*)+$"},
        "params": {"$ref": "#/$defs/payload"}
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "method": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(/[a-z][a-zA-Z0-9]*)+$"},
        "params": {"$ref": "#/$defs/payload"}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "result": {"$ref": "#/$defs/payload"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "integer"},
            "message": {"type": "string", "minLength": 1},
            "data": {"$ref": "#/$defs/payload"}
          }
        }
      }
    }
  }
}
