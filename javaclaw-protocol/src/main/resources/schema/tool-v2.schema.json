{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/tool-v2.schema.json",
  "title": "JavaClaw Protocol v2 Tool catalog methods",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "catalogQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "permissionProfileId", "permissionProfileVersion", "agentProfile", "query", "limit"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/uuid"},
        "permissionProfileId": {"$ref": "#/$defs/identifier"},
        "permissionProfileVersion": {"type": "integer", "minimum": 1},
        "agentProfile": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["id", "revision"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "revision": {"type": "integer", "minimum": 1}
          }
        },
        "query": {"type": "string", "maxLength": 1000},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producerId", "name", "revision"],
      "properties": {
        "producerId": {"type": "string", "minLength": 1, "maxLength": 240},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "description", "inputSchema", "outputSchema", "risk", "tags"],
      "properties": {
        "identity": {"$ref": "#/$defs/toolIdentity"},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "inputSchema": {
          "type": "object",
          "description": "工具冻结版本声明的输入 JSON Schema"
        },
        "outputSchema": {
          "type": "object",
          "description": "工具冻结版本声明的输出 JSON Schema"
        },
        "risk": {"enum": ["READ_ONLY", "WORKSPACE_WRITE", "NETWORK", "PROCESS", "EXTERNAL_EFFECT"]},
        "tags": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "searchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogRevision", "tools"],
      "properties": {
        "catalogRevision": {"type": "integer", "minimum": 1},
        "tools": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/descriptor"}}
      }
    }
  }
}
