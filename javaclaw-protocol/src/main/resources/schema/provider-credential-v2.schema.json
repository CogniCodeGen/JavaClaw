{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/provider-credential-v2.schema.json",
  "title": "JavaClaw Protocol v2 Provider credential atomic methods",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$"
    },
    "writeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 1},
        "payload": {"type": "object"}
      }
    },
    "providerSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "adapter", "baseUri", "roles", "models", "credential", "timeout", "maximumRetries", "options"],
      "properties": {
        "displayName": {"type": "string", "minLength": 1, "maxLength": 1000},
        "adapter": {"enum": ["OPENAI_COMPATIBLE", "ANTHROPIC", "GOOGLE_GENAI", "OPENAI_RESPONSES"]},
        "baseUri": {"type": ["string", "null"], "format": "uri"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["CHAT", "EMBEDDING"]}
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "credential": {
          "oneOf": [
            {"$ref": "credential-v2.schema.json#/$defs/credentialRef"},
            {"type": "null"}
          ]
        },
        "timeout": {"type": "string", "minLength": 3, "maxLength": 40},
        "maximumRetries": {"type": "integer", "minimum": 0, "maximum": 10},
        "options": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {"type": "string", "maxLength": 4000}
        }
      }
    },
    "providerEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "lifecycle", "spec", "createdAt", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "revision": {"type": "integer", "minimum": 1},
        "lifecycle": {"enum": ["ACTIVE", "DISABLED", "ARCHIVED"]},
        "spec": {"$ref": "#/$defs/providerSpec"},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "setCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["providerId", "providerExpectedRevision", "credentialExpectedRevision", "secret"],
          "properties": {
            "providerId": {"$ref": "#/$defs/identifier"},
            "providerExpectedRevision": {"type": "integer", "minimum": 1},
            "credentialExpectedRevision": {"type": "integer", "minimum": 0},
            "secret": {"$ref": "credential-v2.schema.json#/$defs/sealedSecret"}
          }
        }}}
      ]
    },
    "clearCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["providerId", "providerExpectedRevision", "credential", "credentialExpectedRevision"],
          "properties": {
            "providerId": {"$ref": "#/$defs/identifier"},
            "providerExpectedRevision": {"type": "integer", "minimum": 1},
            "credential": {"$ref": "credential-v2.schema.json#/$defs/credentialRef"},
            "credentialExpectedRevision": {"type": "integer", "minimum": 1}
          }
        }}}
      ]
    },
    "bindingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "credential"],
      "properties": {
        "provider": {"$ref": "#/$defs/providerEndpoint"},
        "credential": {"$ref": "credential-v2.schema.json#/$defs/credentialMetadata"}
      }
    },
    "clearResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "receipt"],
      "properties": {
        "provider": {"$ref": "#/$defs/providerEndpoint"},
        "receipt": {"$ref": "credential-v2.schema.json#/$defs/clearReceipt"}
      }
    }
  }
}
