{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/credential-v3.schema.json",
  "title": "JavaClaw Protocol v3 Secret Vault methods",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "credentialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "id"],
      "properties": {
        "namespace": {"$ref": "#/$defs/identifier"},
        "id": {"$ref": "#/$defs/identifier"}
      }
    },
    "sealedSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "purpose", "ephemeralPublicKey", "nonce", "ciphertext"],
      "properties": {
        "keyId": {"type": "string", "minLength": 1, "maxLength": 120},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 240},
        "ephemeralPublicKey": {"type": "string", "minLength": 1, "maxLength": 256},
        "nonce": {"type": "string", "minLength": 1, "maxLength": 32},
        "ciphertext": {"type": "string", "minLength": 1, "maxLength": 6000000}
      }
    },
    "writeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
        "expectedRevision": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      }
    },
    "credentialMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "revision", "updatedAt"],
      "properties": {
        "reference": {"$ref": "#/$defs/credentialRef"},
        "revision": {"type": "integer", "minimum": 1},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "readResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential"],
      "properties": {
        "credential": {"oneOf": [{"$ref": "#/$defs/credentialMetadata"}, {"type": "null"}]}
      }
    },
    "listResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials"],
      "properties": {
        "credentials": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/credentialMetadata"}
        }
      }
    },
    "clearReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "clearedRevision", "clearedAt"],
      "properties": {
        "reference": {"$ref": "#/$defs/credentialRef"},
        "clearedRevision": {"type": "integer", "minimum": 1},
        "clearedAt": {"type": "string", "format": "date-time"}
      }
    },
    "vaultStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "credentialCount", "oldKeyCleanupPending", "checkedAt"],
      "properties": {
        "state": {"enum": ["READY", "LOCKED"]},
        "reason": {"type": "string"},
        "credentialCount": {"type": "integer", "minimum": 0},
        "oldKeyCleanupPending": {"type": "boolean"},
        "checkedAt": {"type": "string", "format": "date-time"}
      }
    },
    "managementReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "affectedCredentialCount", "completedAt"],
      "properties": {
        "action": {"enum": ["MASTER_KEY_ROTATED", "VAULT_RESET"]},
        "affectedCredentialCount": {"type": "integer", "minimum": 0},
        "completedAt": {"type": "string", "format": "date-time"}
      }
    },
    "statusParams": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "readParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {"reference": {"$ref": "#/$defs/credentialRef"}}
    },
    "listParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {"namespace": {"$ref": "#/$defs/identifier"}}
    },
    "createCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "secret"],
          "properties": {
            "namespace": {"$ref": "#/$defs/identifier"},
            "secret": {"$ref": "#/$defs/sealedSecret"}
          }
        }}}
      ]
    },
    "rotateCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "secret"],
          "properties": {
            "reference": {"$ref": "#/$defs/credentialRef"},
            "secret": {"$ref": "#/$defs/sealedSecret"}
          }
        }}}
      ]
    },
    "clearCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference"],
          "properties": {"reference": {"$ref": "#/$defs/credentialRef"}}
        }}}
      ]
    },
    "masterKeyRotateCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"expectedRevision": {"const": 0}, "payload": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }}}
      ]
    },
    "resetCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommand"},
        {"properties": {"expectedRevision": {"const": 0}, "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmation"],
          "properties": {"confirmation": {"const": "RESET VAULT"}}
        }}}
      ]
    }
  }
}
