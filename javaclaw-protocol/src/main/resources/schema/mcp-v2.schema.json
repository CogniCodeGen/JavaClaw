{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaclaw.local/schema/mcp-v2.schema.json",
  "title": "JavaClaw MCP management contracts",
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspaceId": {"type": "string", "format": "uuid"},
    "credentialRef": {
      "type": "object",
      "required": ["namespace", "id"],
      "properties": {"namespace": {"enum": ["mcp", "oauth"]}, "id": {"$ref": "#/$defs/identifier"}},
      "additionalProperties": false
    },
    "privateNetworkGrantRef": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "revision": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "endpointSpec": {
      "type": "object",
      "required": ["workspaceId", "displayName", "transport", "endpointUri", "signedBundleId", "authType", "credential", "apiKeyHeader", "privateNetworkGrant", "requestTimeout"],
      "properties": {
        "workspaceId": {"$ref": "#/$defs/workspaceId"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 240},
        "transport": {"enum": ["STREAMABLE_HTTPS", "SIGNED_BUNDLE_STDIO"]},
        "endpointUri": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
        "signedBundleId": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "authType": {"enum": ["NONE", "BEARER", "API_KEY", "OAUTH_2_1_PKCE"]},
        "credential": {"anyOf": [{"$ref": "#/$defs/credentialRef"}, {"type": "null"}]},
        "apiKeyHeader": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9-]{0,79}$"},
        "privateNetworkGrant": {"anyOf": [{"$ref": "#/$defs/privateNetworkGrantRef"}, {"type": "null"}]},
        "requestTimeout": {"type": "string", "format": "duration", "pattern": "^PT"}
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["id", "revision", "state", "catalogRevision", "spec", "createdAt", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "revision": {"type": "integer", "minimum": 1},
        "state": {"enum": ["ENABLED", "DISABLED"]},
        "catalogRevision": {"type": "integer", "minimum": 0},
        "spec": {"$ref": "#/$defs/endpointSpec"},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "workspaceQuery": {"type": "object", "required": ["workspaceId"], "properties": {"workspaceId": {"$ref": "#/$defs/workspaceId"}}, "additionalProperties": false},
    "endpointQuery": {"type": "object", "required": ["endpointId"], "properties": {"endpointId": {"$ref": "#/$defs/identifier"}}, "additionalProperties": false},
    "endpointWritePayload": {
      "type": "object",
      "required": ["endpointId", "spec"],
      "properties": {"endpointId": {"$ref": "#/$defs/identifier"}, "spec": {"$ref": "#/$defs/endpointSpec"}},
      "additionalProperties": false
    },
    "signedBundleRegisterPayload": {
      "type": "object",
      "required": ["endpointId", "workspaceId", "bundleId", "displayName", "requestTimeout"],
      "properties": {
        "endpointId": {"$ref": "#/$defs/identifier"},
        "workspaceId": {"$ref": "#/$defs/workspaceId"},
        "bundleId": {"$ref": "#/$defs/identifier"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 240},
        "requestTimeout": {"type": "string", "format": "duration", "pattern": "^PT"}
      },
      "additionalProperties": false
    },
    "writeCommandBase": {
      "type": "object",
      "required": ["idempotencyKey", "expectedRevision", "payload"],
      "properties": {
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 500},
        "expectedRevision": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "endpointWriteCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommandBase"},
        {"properties": {"payload": {"$ref": "#/$defs/endpointWritePayload"}}}
      ]
    },
    "signedBundleRegisterCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommandBase"},
        {"properties": {"payload": {"$ref": "#/$defs/signedBundleRegisterPayload"}}}
      ]
    },
    "endpointMutationCommand": {
      "allOf": [
        {"$ref": "#/$defs/writeCommandBase"},
        {"properties": {"payload": {"$ref": "#/$defs/endpointQuery"}}}
      ]
    },
    "endpointListResult": {"type": "object", "required": ["endpoints"], "properties": {"endpoints": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}}}, "additionalProperties": false},
    "health": {
      "type": "object",
      "required": ["endpointId", "endpointRevision", "state", "negotiatedProtocol", "detail", "checkedAt"],
      "properties": {
        "endpointId": {"$ref": "#/$defs/identifier"},
        "endpointRevision": {"type": "integer", "minimum": 1},
        "state": {"enum": ["UNKNOWN", "HEALTHY", "AUTH_REQUIRED", "UNAVAILABLE", "PROTOCOL_MISMATCH"]},
        "negotiatedProtocol": {"type": ["string", "null"]},
        "detail": {"type": ["string", "null"]},
        "checkedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "canonicalPayload": {"type": "object"},
    "catalogEntry": {
      "type": "object",
      "required": ["kind", "name", "title", "description", "inputSchema", "outputSchema", "schemaHash"],
      "properties": {
        "kind": {"enum": ["TOOL", "PROMPT", "RESOURCE"]},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "title": {"type": ["string", "null"]},
        "description": {"type": "string", "minLength": 1},
        "inputSchema": {"type": ["object", "null"]},
        "outputSchema": {"type": ["object", "null"]},
        "schemaHash": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "catalogQuery": {
      "type": "object",
      "required": ["endpointId", "kind", "cursor", "limit"],
      "properties": {
        "endpointId": {"$ref": "#/$defs/identifier"},
        "kind": {"type": ["string", "null"], "enum": ["TOOL", "PROMPT", "RESOURCE", null]},
        "cursor": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]{0,8})$"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200}
      },
      "additionalProperties": false
    },
    "catalogPage": {
      "type": "object",
      "required": ["entries", "nextCursor"],
      "properties": {
        "entries": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/catalogEntry"}},
        "nextCursor": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "catalogResult": {"type": "object", "required": ["page"], "properties": {"page": {"$ref": "#/$defs/catalogPage"}}, "additionalProperties": false},
    "catalogRefresh": {
      "type": "object",
      "required": ["endpointId", "endpointRevision", "state", "pagesCompleted", "entriesDiscovered", "committedCatalogRevision", "detail", "startedAt", "updatedAt"],
      "properties": {
        "endpointId": {"$ref": "#/$defs/identifier"},
        "endpointRevision": {"type": "integer", "minimum": 1},
        "state": {"enum": ["RUNNING", "COMPLETED", "FAILED"]},
        "pagesCompleted": {"type": "integer", "minimum": 0, "maximum": 50},
        "entriesDiscovered": {"type": "integer", "minimum": 0, "maximum": 10000},
        "committedCatalogRevision": {"type": ["integer", "null"], "minimum": 1},
        "detail": {"type": ["string", "null"], "maxLength": 500},
        "startedAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "catalogRefreshResult": {
      "type": "object",
      "required": ["refresh"],
      "properties": {"refresh": {"anyOf": [{"$ref": "#/$defs/catalogRefresh"}, {"type": "null"}]}},
      "additionalProperties": false
    },
    "externalPageQuery": {
      "type": "object",
      "required": ["endpointId", "cursor"],
      "properties": {
        "endpointId": {"$ref": "#/$defs/identifier"},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "resourceReadQuery": {
      "type": "object",
      "required": ["endpointId", "uri"],
      "properties": {
        "endpointId": {"$ref": "#/$defs/identifier"},
        "uri": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "promptGetQuery": {
      "type": "object",
      "required": ["endpointId", "name", "arguments"],
      "properties": {
        "endpointId": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "arguments": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 240},
          "additionalProperties": {"type": "string", "maxLength": 8192}
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["token", "progress", "total", "message"],
      "properties": {
        "token": {"type": "string", "minLength": 1, "maxLength": 256},
        "progress": {"type": "number", "minimum": 0},
        "total": {"type": ["number", "null"], "minimum": 0},
        "message": {"type": ["string", "null"], "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "cacheScope": {"enum": ["PRIVATE", "PUBLIC"]},
    "resourceDescriptor": {
      "type": "object",
      "required": ["name", "uri", "title", "description", "mimeType", "size"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "uri": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 4096},
        "title": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
        "mimeType": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "size": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "resourcePage": {
      "type": "object",
      "required": ["resources", "nextCursor", "cacheScope", "ttlMilliseconds", "progress"],
      "properties": {
        "resources": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/resourceDescriptor"}},
        "nextCursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "cacheScope": {"$ref": "#/$defs/cacheScope"},
        "ttlMilliseconds": {"type": "integer", "minimum": 0},
        "progress": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/progress"}}
      },
      "additionalProperties": false
    },
    "resourcePageResult": {
      "type": "object",
      "required": ["page"],
      "properties": {"page": {"$ref": "#/$defs/resourcePage"}},
      "additionalProperties": false
    },
    "resourceContent": {
      "type": "object",
      "required": ["uri", "mimeType", "text", "blobBase64"],
      "properties": {
        "uri": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 4096},
        "mimeType": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "text": {"type": ["string", "null"], "maxLength": 6291456},
        "blobBase64": {"type": ["string", "null"], "maxLength": 6291456, "contentEncoding": "base64"}
      },
      "oneOf": [
        {"properties": {"text": {"type": "string"}, "blobBase64": {"type": "null"}}},
        {"properties": {"text": {"type": "null"}, "blobBase64": {"type": "string"}}}
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["contents", "cacheScope", "ttlMilliseconds", "progress"],
      "properties": {
        "contents": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/resourceContent"}},
        "cacheScope": {"$ref": "#/$defs/cacheScope"},
        "ttlMilliseconds": {"type": "integer", "minimum": 0},
        "progress": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/progress"}}
      },
      "additionalProperties": false
    },
    "resourceReadResult": {
      "type": "object",
      "required": ["resource"],
      "properties": {"resource": {"$ref": "#/$defs/resource"}},
      "additionalProperties": false
    },
    "promptArgument": {
      "type": "object",
      "required": ["name", "description", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "promptDescriptor": {
      "type": "object",
      "required": ["name", "title", "description", "arguments"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "title": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
        "arguments": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/promptArgument"}}
      },
      "additionalProperties": false
    },
    "promptPage": {
      "type": "object",
      "required": ["prompts", "nextCursor", "cacheScope", "ttlMilliseconds", "progress"],
      "properties": {
        "prompts": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/promptDescriptor"}},
        "nextCursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "cacheScope": {"$ref": "#/$defs/cacheScope"},
        "ttlMilliseconds": {"type": "integer", "minimum": 0},
        "progress": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/progress"}}
      },
      "additionalProperties": false
    },
    "promptPageResult": {
      "type": "object",
      "required": ["page"],
      "properties": {"page": {"$ref": "#/$defs/promptPage"}},
      "additionalProperties": false
    },
    "promptMessage": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["USER", "ASSISTANT"]},
        "content": {"$ref": "#/$defs/canonicalPayload"}
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "required": ["description", "messages", "progress"],
      "properties": {
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
        "messages": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/promptMessage"}},
        "progress": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/progress"}}
      },
      "additionalProperties": false
    },
    "promptResult": {
      "type": "object",
      "required": ["prompt"],
      "properties": {"prompt": {"$ref": "#/$defs/prompt"}},
      "additionalProperties": false
    },
    "oauthQuery": {
      "oneOf": [
        {"type": "object", "required": ["authorizationId", "endpointId"], "properties": {"authorizationId": {"$ref": "#/$defs/identifier"}, "endpointId": {"type": "null"}}, "additionalProperties": false},
        {"type": "object", "required": ["authorizationId", "endpointId"], "properties": {"authorizationId": {"type": "null"}, "endpointId": {"$ref": "#/$defs/identifier"}}, "additionalProperties": false}
      ]
    },
    "oauthStartPayload": {"type": "object", "required": ["endpointId"], "properties": {"endpointId": {"$ref": "#/$defs/identifier"}}, "additionalProperties": false},
    "oauthStartCommand": {"allOf": [{"$ref": "#/$defs/writeCommandBase"}, {"properties": {"payload": {"$ref": "#/$defs/oauthStartPayload"}}}]},
    "oauthMutationCommand": {"allOf": [{"$ref": "#/$defs/writeCommandBase"}, {"properties": {"payload": {"$ref": "#/$defs/oauthQuery"}}}]},
    "oauthAuthorization": {
      "type": "object",
      "required": ["id", "endpointId", "endpointRevision", "authorizationHost", "state", "expiresAt", "detail", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "endpointId": {"$ref": "#/$defs/identifier"},
        "endpointRevision": {"type": "integer", "minimum": 1},
        "authorizationHost": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "state": {"enum": ["PENDING", "AUTHORIZED", "FAILED", "EXPIRED", "CANCELLED"]},
        "expiresAt": {"type": "string", "format": "date-time"},
        "detail": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,95}$"},
        "updatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "oauthResult": {
      "type": "object",
      "required": ["authorization"],
      "properties": {"authorization": {"anyOf": [{"$ref": "#/$defs/oauthAuthorization"}, {"type": "null"}]}},
      "additionalProperties": false
    }
  }
}
