<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.javaclaw</groupId>
    <artifactId>javaclaw-parent</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JavaClaw 聚合构建</name>
    <modules>
        <module>plugin-protocol</module>
        <module>plugin-sdk-java</module>
        <module>plugin-runner-java</module>
        <module>javaclaw-desktop</module>
        <module>distribution</module>
    </modules>
    <properties>
        <!-- 编码与 JDK 版本（JDK 25 LTS：虚拟线程无 pinning、Scoped Values 正式版） -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>

        <!-- 依赖版本管理 -->
        <!-- JavaFX 25：与 JDK 25 对齐，原生库支持 macOS aarch64 -->
        <javafx.version>25</javafx.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <jackson3.version>3.1.4</jackson3.version>
        <quartz.version>2.5.2</quartz.version>
        <logback.version>1.4.14</logback.version>
        <angus.mail.version>2.0.3</angus.mail.version>
        <greenmail.version>2.1.11</greenmail.version>
        <pdfbox.version>3.0.4</pdfbox.version>
        <richtextfx.version>0.11.7</richtextfx.version>
        <commonmark.version>0.30.0</commonmark.version>
        <!-- 0.30.0 的 autolink 扩展尚未同步到项目 Maven 镜像；0.29.0 与 0.30 core API 兼容。 -->
        <commonmark.autolink.version>0.29.0</commonmark.autolink.version>
        <eclipsestore.version>4.1.0</eclipsestore.version>
        <h2.version>2.4.240</h2.version>
        <spring.version>7.0.8</spring.version>
        <archunit.version>1.4.2</archunit.version>
        <json-schema-validator.version>1.5.7</json-schema-validator.version>
        <jacoco.version>0.8.14</jacoco.version>
        <coverage.overall.line>0.55</coverage.overall.line>
        <coverage.overall.branch>0.45</coverage.overall.branch>
        <coverage.core.line>0.80</coverage.core.line>
        <coverage.core.branch>0.70</coverage.core.branch>
        <coverage.controller.line>0.70</coverage.controller.line>
        <coverage.controller.branch>0.60</coverage.controller.branch>
        <!-- JaCoCo prepare-agent 会在测试前覆盖该属性；空值保证直接运行 Surefire 也合法。 -->
        <jacocoArgLine></jacocoArgLine>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- 新 Agent Framework 的唯一模型/Advisor/工具调用底座。 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 统一 Jackson 版本，避免 Spring AI 与其他依赖发生运行时链接错误。 -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
                    <configuration><release>25</release><parameters>true</parameters></configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
                    <configuration><useModulePath>false</useModulePath><failIfNoTests>false</failIfNoTests><failIfNoSpecifiedTests>false</failIfNoSpecifiedTests></configuration>
                </plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
