<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.javaclaw</groupId><artifactId>javaclaw-parent</artifactId><version>4.0.0-SNAPSHOT</version></parent>
    <artifactId>javaclaw-distribution</artifactId><packaging>pom</packaging>
    <properties>
        <javaclaw.distribution.directory>${project.basedir}/target</javaclaw.distribution.directory>
    </properties>
    <dependencies>
        <dependency><groupId>com.javaclaw</groupId><artifactId>javaclaw-desktop</artifactId><version>${project.version}</version></dependency>
        <!-- Runner 只参与发行组装，不进入 Desktop 的依赖或 lib 目录。 -->
        <dependency><groupId>com.javaclaw</groupId><artifactId>plugin-runner-java</artifactId><version>${project.version}</version><classifier>all</classifier><scope>provided</scope></dependency>
    </dependencies>
    <build>
        <directory>${javaclaw.distribution.directory}</directory>
        <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version><executions>
            <execution><id>stage-applications</id><phase>package</phase><goals><goal>copy</goal></goals><configuration><artifactItems>
                <artifactItem><groupId>com.javaclaw</groupId><artifactId>javaclaw-desktop</artifactId><version>${project.version}</version><outputDirectory>${project.build.directory}/runtime</outputDirectory><destFileName>desktop.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.javaclaw</groupId><artifactId>plugin-runner-java</artifactId><version>${project.version}</version><classifier>all</classifier><outputDirectory>${project.build.directory}/runtime</outputDirectory><destFileName>plugin-runner.jar</destFileName></artifactItem>
            </artifactItems></configuration></execution>
            <execution><id>stage-desktop-libraries</id><phase>package</phase><goals><goal>copy-dependencies</goal></goals><configuration>
                <includeScope>runtime</includeScope><excludeArtifactIds>javaclaw-desktop,plugin-runner-java,plugin-sdk-java</excludeArtifactIds><outputDirectory>${project.build.directory}/runtime/lib</outputDirectory>
            </configuration></execution>
        </executions></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-assembly-plugin</artifactId><version>3.7.1</version><configuration><descriptors><descriptor>src/assembly/portable.xml</descriptor></descriptors></configuration><executions><execution><id>portable</id><phase>package</phase><goals><goal>single</goal></goals></execution></executions></plugin>
    </plugins></build>
</project>
