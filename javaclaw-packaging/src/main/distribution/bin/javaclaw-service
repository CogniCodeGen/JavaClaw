#!/bin/sh
set -eu
APP_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
DATA_ROOT=${JAVACLAW_DATA_ROOT:-"$APP_ROOT/data-v6"}
if [ "$#" -gt 0 ]; then
    if [ "$#" -ne 2 ] || [ "$1" != "--data-root" ]; then
        echo 'Usage: javaclaw-service [--data-root /absolute/data-v6]' >&2
        exit 6
    fi
    DATA_ROOT=$2
fi
exec "$APP_ROOT/runtime/bin/java" \
    --enable-native-access=ALL-UNNAMED \
    -Djavaclaw.data.root="$DATA_ROOT" \
    -Djavaclaw.log.dir="$DATA_ROOT/logs" \
    -Djavaclaw.program.dir="$APP_ROOT" \
    -cp "$APP_ROOT/lib/*" com.javaclaw.launcher.AppServerLauncher \
    --socket "$DATA_ROOT/run/app-server-v6.sock"
