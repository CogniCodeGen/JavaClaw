#!/bin/sh
set -eu
APP_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
DATA_ROOT=${JAVACLAW_DATA_ROOT:-"$APP_ROOT/data-v6"}
case "$(uname -s)" in
Darwin)
    exec "$APP_ROOT/runtime/bin/java" -XstartOnFirstThread \
        -Djavaclaw.tray.launcher=true -Djavaclaw.data.root="$DATA_ROOT" -Djavaclaw.program.dir="$APP_ROOT" \
        -cp "$APP_ROOT/lib/*" com.javaclaw.launcher.JavaClawLauncher "$@"
    ;;
*)
    exec "$APP_ROOT/runtime/bin/java" -Djavaclaw.tray.launcher=true \
        -Djavaclaw.data.root="$DATA_ROOT" -Djavaclaw.program.dir="$APP_ROOT" -cp "$APP_ROOT/lib/*" \
        com.javaclaw.launcher.JavaClawLauncher "$@"
    ;;
esac
