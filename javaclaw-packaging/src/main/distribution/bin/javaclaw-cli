#!/bin/sh
set -eu
APP_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$APP_ROOT/runtime/bin/java" -cp "$APP_ROOT/lib/*" com.javaclaw.client.cli.JavaClawCli \
    "$@" -- "$APP_ROOT/runtime/bin/java" \
    --enable-native-access=ALL-UNNAMED \
    -Djavaclaw.program.dir="$APP_ROOT" \
    -cp "$APP_ROOT/lib/*" com.javaclaw.launcher.AppServerLauncher --stdio
