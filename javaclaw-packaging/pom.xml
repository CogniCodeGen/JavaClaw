                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="/bin/sh" failonerror="true">
                                            <arg value="${project.basedir}/src/main/signing/sign-linux.sh" />
                                            <arg value="${project.build.directory}/native" />
                                            <arg value="${env.JAVACLAW_LINUX_SIGNING_KEY}" />
                                            <arg value="${env.JAVACLAW_LINUX_SIGNING_PASSPHRASE}" />
