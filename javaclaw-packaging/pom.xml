<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.javaclaw</groupId>
        <artifactId>javaclaw-parent</artifactId>
        <version>6.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>javaclaw-packaging</artifactId>
    <name>JavaClaw Packaging</name>
    <dependencies>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-app-server</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-desktop</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-native-hosts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-browser-service</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-knowledge-worker</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-api</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.javaclaw</groupId>
            <artifactId>javaclaw-builtin-contracts</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <!-- 本模块的非测试依赖均是发行镜像输入，不是启动器的编译依赖。 -->
                    <ignoreNonCompile>true</ignoreNonCompile>
                </configuration>
                <executions>
                    <execution>
                        <id>copy-main-runtime-dependencies</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <!-- 工具链解包在 App Server 执行，因此主镜像也需要 Commons Compress 及其依赖。 -->
                            <excludeArtifactIds>javaclaw-knowledge-worker,playwright,driver,driver-bundle,pdfbox,pdfbox-io,fontbox,poi,poi-ooxml,poi-ooxml-lite,xmlbeans,SparseBitSet,commons-math3,curvesapi,log4j-api,commons-collections4,opentest4j</excludeArtifactIds>
                            <outputDirectory>${project.build.directory}/distribution/lib</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-browser-worker-dependencies</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeArtifactIds>javaclaw-browser-service,javaclaw-api,javaclaw-protocol,javaclaw-extension-spi,javaclaw-builtin-contracts,jackson-core,jackson-databind,jackson-annotations,jackson-datatype-jdk8,jackson-datatype-jsr310,playwright,gson,error_prone_annotations,opentest4j,driver,driver-bundle</includeArtifactIds>
                            <excludeGroupIds>tools.jackson.core</excludeGroupIds>
                            <outputDirectory>${project.build.directory}/distribution/workers/browser/app</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-knowledge-worker-dependencies</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeArtifactIds>javaclaw-knowledge-worker,javaclaw-api,javaclaw-protocol,javaclaw-extension-spi,javaclaw-builtin-contracts,jackson-core,jackson-databind,jackson-annotations,jackson-datatype-jdk8,jackson-datatype-jsr310,pdfbox,pdfbox-io,fontbox,commons-logging,poi-ooxml,poi,commons-codec,commons-math3,SparseBitSet,poi-ooxml-lite,xmlbeans,commons-compress,commons-lang3,commons-io,curvesapi,log4j-api,commons-collections4</includeArtifactIds>
                            <excludeGroupIds>tools.jackson.core</excludeGroupIds>
                            <outputDirectory>${project.build.directory}/distribution/workers/knowledge/app</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven.version}</version>
                <executions>
                    <execution>
                        <id>create-runtime-sbom</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                        <configuration>
                            <projectType>application</projectType>
                            <schemaVersion>1.6</schemaVersion>
                            <includeBomSerialNumber>false</includeBomSerialNumber>
                            <includeCompileScope>true</includeCompileScope>
                            <includeProvidedScope>false</includeProvidedScope>
                            <includeRuntimeScope>true</includeRuntimeScope>
                            <includeSystemScope>false</includeSystemScope>
                            <includeTestScope>false</includeTestScope>
                            <outputDirectory>${project.build.directory}/release-evidence</outputDirectory>
                            <outputFormat>json</outputFormat>
                            <outputName>bom</outputName>
                            <skipAttach>true</skipAttach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven.version}</version>
                <executions>
                    <execution>
                        <id>verify-runtime-licenses</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                        <configuration>
                            <includedScopes>compile,runtime</includedScopes>
                            <includeOptional>false</includeOptional>
                            <includeTransitiveDependencies>true</includeTransitiveDependencies>
                            <excludedGroups>com\.javaclaw</excludedGroups>
                            <failOnMissing>true</failOnMissing>
                            <failOnBlacklist>true</failOnBlacklist>
                            <force>true</force>
                            <sortArtifactByName>false</sortArtifactByName>
                            <useRepositoryMissingFiles>false</useRepositoryMissingFiles>
                            <licenseMerges>
                                <licenseMerge>Apache-2.0|Apache 2.0|Apache License 2.0|Apache License, Version 2.0</licenseMerge>
                                <licenseMerge>Apache-2.0|The Apache License, Version 2.0</licenseMerge>
                                <licenseMerge>Apache-2.0|The Apache Software License, Version 2.0</licenseMerge>
                                <licenseMerge>MIT|MIT License|The MIT License</licenseMerge>
                                <licenseMerge>BSD-3-Clause|BSD New license|The BSD License|BSD licence</licenseMerge>
                                <licenseMerge>BSD-3-Clause|BSD License</licenseMerge>
                                <licenseMerge>EPL-1.0|EPL 1.0|Eclipse Public License - v 1.0</licenseMerge>
                                <licenseMerge>EDL-1.0|EDL 1.0|Eclipse Distribution License - v 1.0</licenseMerge>
                                <licenseMerge>GPL-2.0-with-classpath-exception|GPLv2+CE</licenseMerge>
                            </licenseMerges>
                            <includedLicenses>
                                <!-- XZ for Java 1.12 的源码 SPDX 与官方发行页均声明 0BSD；用于受控 tar.xz 解包。 -->
                                <includedLicense>0BSD</includedLicense>
                                <includedLicense>Apache-2.0</includedLicense>
                                <includedLicense>BSD-2-Clause</includedLicense>
                                <includedLicense>BSD-3-Clause</includedLicense>
                                <includedLicense>CDDL + GPLv2 with classpath exception</includedLicense>
                                <includedLicense>EDL-1.0</includedLicense>
                                <includedLicense>EPL-1.0</includedLicense>
                                <includedLicense>GNU Lesser General Public License</includedLicense>
                                <includedLicense>GPL-2.0-with-classpath-exception</includedLicense>
                                <includedLicense>MIT</includedLicense>
                                <includedLicense>MIT-0</includedLicense>
                                <includedLicense>MPL 2.0</includedLicense>
                                <includedLicense>Public Domain, per Creative Commons CC0</includedLicense>
                            </includedLicenses>
                            <outputDirectory>${project.build.directory}/release-evidence</outputDirectory>
                            <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>reset-package-output</id>
                        <phase>initialize</phase>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/distribution" />
                                <delete dir="${project.build.directory}/release" />
                                <delete dir="${project.build.directory}/release-evidence" />
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>build-isolated-runtime-images</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <exec executable="${java.home}/bin/jlink" failonerror="true">
                                    <arg value="--add-modules" />
                                    <arg
                                        value="java.base,java.datatransfer,java.desktop,java.instrument,java.logging,java.management,java.naming,java.net.http,java.prefs,java.rmi,java.security.jgss,java.security.sasl,java.sql,java.transaction.xa,java.xml,jdk.xml.dom,jdk.jsobject,jdk.charsets,jdk.crypto.ec,jdk.management,jdk.naming.dns,jdk.net,jdk.unsupported,jdk.unsupported.desktop,jdk.zipfs" />
                                    <arg value="--strip-debug" />
                                    <arg value="--no-header-files" />
                                    <arg value="--no-man-pages" />
                                    <arg value="--output" />
                                    <arg value="${project.build.directory}/distribution/runtime" />
                                </exec>
                                <exec executable="${java.home}/bin/jlink" failonerror="true">
                                    <arg value="--add-modules" />
                                    <arg
                                        value="java.base,java.logging,java.management,java.net.http,java.xml,jdk.charsets,jdk.crypto.ec,jdk.net,jdk.unsupported,jdk.zipfs" />
                                    <arg value="--strip-debug" />
                                    <arg value="--no-header-files" />
                                    <arg value="--no-man-pages" />
                                    <arg value="--output" />
                                    <arg value="${project.build.directory}/distribution/workers/browser" />
                                </exec>
                                <exec executable="${java.home}/bin/jlink" failonerror="true">
                                    <arg value="--add-modules" />
                                    <arg
                                        value="java.base,java.desktop,java.logging,java.management,java.naming,java.xml,jdk.charsets,jdk.crypto.ec,jdk.unsupported,jdk.zipfs" />
                                    <arg value="--strip-debug" />
                                    <arg value="--no-header-files" />
                                    <arg value="--no-man-pages" />
                                    <arg value="--output" />
                                    <arg value="${project.build.directory}/distribution/workers/knowledge" />
                                </exec>
                                <exec executable="${java.home}/bin/jlink" failonerror="true">
                                    <arg value="--add-modules" />
                                    <arg
                                        value="java.base,java.compiler,java.logging,java.prefs,jdk.compiler,jdk.jshell" />
                                    <arg value="--strip-debug" />
                                    <arg value="--no-header-files" />
                                    <arg value="--no-man-pages" />
                                    <arg value="--output" />
                                    <arg value="${project.build.directory}/distribution/workers/skill" />
                                </exec>
                                <mkdir dir="${project.build.directory}/distribution/workers/browser/app" />
                                <mkdir dir="${project.build.directory}/distribution/workers/browser/browser" />
                                <mkdir dir="${project.build.directory}/distribution/workers/knowledge/app" />
                                <copy todir="${project.build.directory}/distribution">
                                    <fileset dir="${project.basedir}/src/main/distribution" />
                                </copy>
                                <chmod dir="${project.build.directory}/distribution/bin" perm="755"
                                    includes="javaclaw,javaclaw-cli,javaclaw-health,javaclaw-service" osfamily="unix" />
                                <mkdir dir="${project.build.directory}/distribution/legal" />
                                <copy file="${maven.multiModuleProjectDirectory}/LICENSE"
                                    tofile="${project.build.directory}/distribution/legal/LICENSE.txt" />
                                <!-- 自包含 WebView 第三方资源单独记入 CycloneDX 补充清单，随发行完整性清单验签。 -->
                                <copy todir="${project.build.directory}/distribution/legal/web">
                                    <fileset
                                        dir="${maven.multiModuleProjectDirectory}/javaclaw-desktop/src/main/resources/web/vendor"
                                        includes="*-LICENSE,SHA256SUMS" />
                                </copy>
                                <mkdir dir="${project.build.directory}/distribution/evidence" />
                                <copy
                                    file="${maven.multiModuleProjectDirectory}/javaclaw-desktop/src/main/resources/web/vendor/web-bom.json"
                                    tofile="${project.build.directory}/distribution/evidence/web-bom.json" />
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>copy-launcher-artifact</id>
                        <phase>process-test-resources</phase>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                    todir="${project.build.directory}/distribution/lib" />
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>copy-release-evidence</id>
                        <phase>prepare-package</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/distribution/evidence" />
                                <copy todir="${project.build.directory}/distribution/evidence">
                                    <fileset dir="${project.build.directory}/release-evidence" />
                                </copy>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven.version}</version>
                <executions>
                    <execution>
                        <id>mark-knowledge-worker-image</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaclaw.release.WorkerImageAssemblerMain</mainClass>
                            <arguments>
                                <argument>mark</argument>
                                <argument>${project.build.directory}/distribution/workers/knowledge</argument>
                                <argument>knowledge</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mark-skill-worker-image</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaclaw.release.WorkerImageAssemblerMain</mainClass>
                            <arguments>
                                <argument>mark</argument>
                                <argument>${project.build.directory}/distribution/workers/skill</argument>
                                <argument>skill</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>create-distribution-manifest</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaclaw.release.ReleaseManifestMain</mainClass>
                            <arguments>
                                <argument>create</argument>
                                <argument>${project.build.directory}/distribution</argument>
                                <argument>${project.build.directory}/distribution/MANIFEST.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-distribution-manifest</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaclaw.release.ReleaseManifestMain</mainClass>
                            <arguments>
                                <argument>verify</argument>
                                <argument>${project.build.directory}/distribution</argument>
                                <argument>${project.build.directory}/distribution/MANIFEST.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>create-release-manifest</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaclaw.release.ReleaseManifestMain</mainClass>
                            <arguments>
                                <argument>create</argument>
                                <argument>${project.build.directory}/release</argument>
                                <argument>${project.build.directory}/release/RELEASE-MANIFEST.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-release-manifest</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaclaw.release.ReleaseManifestMain</mainClass>
                            <arguments>
                                <argument>verify</argument>
                                <argument>${project.build.directory}/release</argument>
                                <argument>${project.build.directory}/release/RELEASE-MANIFEST.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>assemble-local-distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/distribution.xml</descriptor>
                            </descriptors>
                            <finalName>javaclaw-${project.version}-${javafx.platform}</finalName>
                            <outputDirectory>${project.build.directory}/release</outputDirectory>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>bundle-verified-playwright-browser</id>
            <activation>
                <property>
                    <name>javaclaw.playwright.browsers.path</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>bundle-playwright-browser</id>
                                <phase>process-test-resources</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.javaclaw.release.WorkerImageAssemblerMain</mainClass>
                                    <arguments>
                                        <argument>browser</argument>
                                        <argument>${javaclaw.playwright.browsers.path}</argument>
                                        <argument>${project.build.directory}/distribution/workers/browser</argument>
                                        <argument>${playwright.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>packaging-unix-coverage</id>
            <activation>
                <os>
                    <family>unix</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>verify-coverage</id>
                                <configuration>
                                    <excludes>
                                        <exclude>com/javaclaw/launcher/WindowsServerSupervisor*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>packaging-windows-coverage</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>verify-coverage</id>
                                <configuration>
                                    <excludes>
                                        <exclude>com/javaclaw/launcher/UnixServerSupervisor*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
