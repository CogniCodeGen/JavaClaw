        <profile>
            <id>release-windows-signing-gate</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
                <property>
                    <name>javaclaw.release</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>windows-signing-required</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireEnvironmentVariable>
                                            <variableName>JAVACLAW_WINDOWS_CERTIFICATE</variableName>
                                        </requireEnvironmentVariable>
                                        <requireEnvironmentVariable>
                                            <variableName>JAVACLAW_WINDOWS_TIMESTAMP_URL</variableName>
                                        </requireEnvironmentVariable>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-windows-installers</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="powershell.exe" failonerror="true">
                                            <arg value="-NoProfile" />
                                            <arg value="-NonInteractive" />
                                            <arg value="-ExecutionPolicy" />
                                            <arg value="Bypass" />
                                            <arg value="-File" />
                                            <arg value="${project.basedir}/src/main/signing/sign-windows.ps1" />
                                            <arg value="-ArtifactDirectory" />
                                            <arg value="${project.build.directory}/native" />
                                            <arg value="-CertificateThumbprint" />
                                            <arg value="${env.JAVACLAW_WINDOWS_CERTIFICATE}" />
                                            <arg value="-TimestampUrl" />
                                            <arg value="${env.JAVACLAW_WINDOWS_TIMESTAMP_URL}" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
