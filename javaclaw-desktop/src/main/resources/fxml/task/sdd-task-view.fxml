<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="root" styleClass="settings-root" accessibleText="SDD 托管任务中心"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.task.SddTaskController">
    <children>
        <VBox prefWidth="264.0" minWidth="220.0" styleClass="modal-left-pane, sdd-left-pane">
            <children>
                <VBox spacing="6.0" styleClass="sdd-left-head">
                    <children>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="▦" styleClass="sdd-left-glyph"/>
                                <Label text="托管任务" styleClass="modal-left-title"/>
                            </children>
                        </HBox>
                        <Label fx:id="listSubtitle" styleClass="sdd-left-count"/>
                    </children>
                </VBox>
                <HBox styleClass="sdd-add-row">
                    <children>
                        <Button text="＋ 新建任务" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                onAction="#createRequested"
                                styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                    </children>
                </HBox>
                <ListView fx:id="taskList" VBox.vgrow="ALWAYS" fixedCellSize="94.0"
                          styleClass="sdd-list-box" accessibleText="托管任务列表"/>
            </children>
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <children>
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="modal-content-area">
                    <children>
                        <VBox fx:id="emptyPanel" spacing="12.0" alignment="CENTER">
                            <children>
                                <Label text="▦" styleClass="empty-state-icon"/>
                                <Label text="选择或新建一个托管任务" styleClass="empty-state-text"/>
                                <Label maxWidth="390.0" wrapText="true" textAlignment="CENTER"
                                       text="托管任务以 OpenSpec 流程推进：提案 → 规格 → 设计 → 任务拆解 → 实现 → 验收。"
                                       styleClass="settings-hint, empty-state-hint"/>
                            </children>
                        </VBox>
                        <fx:include fx:id="detailPanel" source="sdd-task-detail.fxml"/>
                        <fx:include fx:id="createPanel" source="sdd-task-create.fxml"/>
                        <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                                   styleClass="loading-overlay" accessibleText="正在处理托管任务">
                            <children><ProgressIndicator maxWidth="42.0" maxHeight="42.0"/></children>
                        </StackPane>
                    </children>
                </StackPane>
                <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="modal-foot">
                    <children>
                        <HBox fx:id="actionBox" spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="startButton" text="▶ 启动" onAction="#startRequested"
                                        visible="false" managed="false" styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                                <Button fx:id="pauseButton" text="⏸ 暂停" onAction="#pauseRequested"
                                        visible="false" managed="false" styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                <Button fx:id="cancelButton" text="⏹ 取消" onAction="#cancelRequested"
                                        visible="false" managed="false" styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"/>
                                <Button fx:id="resumeButton" text="▶ 继续" onAction="#resumeRequested"
                                        visible="false" managed="false" styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                                <Button fx:id="budgetButton" text="改预算" onAction="#budgetRequested"
                                        visible="false" managed="false" styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                <Button fx:id="resumeBudgetButton" text="提升预算并续跑" onAction="#resumeBudgetRequested"
                                        visible="false" managed="false" styleClass="button, jc-btn, jc-btn-save, jc-btn-sm"/>
                                <Button fx:id="rerunButton" text="↻ 重跑" onAction="#rerunRequested"
                                        visible="false" managed="false" styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                <Button fx:id="deleteButton" text="🗑 删除" onAction="#deleteRequested"
                                        visible="false" managed="false" styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <Label fx:id="statusLabel" maxWidth="340.0" wrapText="true" styleClass="sec-hint"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="关闭" onAction="#closeRequested"
                                styleClass="button, jc-btn, jc-btn-ghost"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>
