<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.memory.MemoryRelatedItemController">
    <children><Label fx:id="text" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                     style="-fx-font-size: 12px; -fx-text-fill: -jc-text-body; -fx-background-color: -jc-surface-sunken; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/></children>
</HBox>
