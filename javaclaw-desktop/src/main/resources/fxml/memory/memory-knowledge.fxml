<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.memory.MemoryKnowledgeController"
            fitToWidth="true" hbarPolicy="NEVER" visible="false" managed="false"
            styleClass="modal-content-area">
    <content>
        <VBox spacing="16.0">
            <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <children>
                <VBox spacing="3.0"><children>
                    <Label text="知识库" styleClass="sec-title"/>
                    <Label text="导入文档会被切分并向量化，供检索增强。" styleClass="sec-hint"/>
                </children></VBox>
                <VBox fx:id="emptyPanel" alignment="CENTER" spacing="4.0" styleClass="mc-dropzone">
                    <children>
                        <Label text="将文件拖到此处导入，或在对话中使用知识工具"
                               style="-fx-font-size: 13.5px; -fx-font-weight: 500; -fx-text-fill: -jc-text-muted;"/>
                        <Label fx:id="emptyText" styleClass="sec-hint"/>
                    </children>
                </VBox>
                <VBox fx:id="table" visible="false" managed="false" styleClass="mc-log-card">
                    <children>
                        <HBox styleClass="jc-table-head">
                            <padding><Insets top="11.0" right="16.0" bottom="11.0" left="16.0"/></padding>
                            <children>
                                <Label text="文档" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="jc-table-head-cell"/>
                                <Label text="分块" minWidth="80.0" prefWidth="80.0" styleClass="jc-table-head-cell"/>
                                <Label text="大小" minWidth="90.0" prefWidth="90.0" styleClass="jc-table-head-cell"/>
                                <Label text="导入时间" minWidth="140.0" prefWidth="140.0" styleClass="jc-table-head-cell"/>
                                <Label text="操作" minWidth="92.0" prefWidth="92.0" styleClass="jc-table-head-cell"/>
                            </children>
                        </HBox>
                        <VBox fx:id="rows"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
