<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.memory.MemoryEpisodeRowController"
      alignment="TOP_LEFT">
    <children>
        <StackPane alignment="TOP_CENTER"><padding><Insets top="16.0" right="10.0"/></padding>
            <children><Region styleClass="mc-timeline-dot"/></children></StackPane>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="mc-episode-card"><children>
            <HBox alignment="CENTER_LEFT"><children>
                <Label fx:id="time" styleClass="mc-ep-time"/><Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="derived" styleClass="jc-badge, jc-badge-soft"/>
                <Label fx:id="pending" text="待嵌入" styleClass="jc-badge, jc-badge-amber"/>
            </children></HBox>
            <HBox spacing="8.0" alignment="TOP_LEFT"><children>
                <Label text="用户" minWidth="30.0" styleClass="mc-ep-role-user"/>
                <Label fx:id="userText" wrapText="true" HBox.hgrow="ALWAYS" styleClass="mc-ep-user"/>
            </children></HBox>
            <HBox spacing="8.0" alignment="TOP_LEFT"><children>
                <Label text="助手" minWidth="30.0" styleClass="mc-ep-role-asst"/>
                <Label fx:id="assistantText" wrapText="true" HBox.hgrow="ALWAYS" styleClass="mc-ep-reply"/>
            </children></HBox>
            <FlowPane hgap="6.0" vgap="6.0"><children>
                <Label fx:id="toolTrace" text="🔧 工具轨迹" styleClass="mc-tool-chip"/>
            </children></FlowPane>
        </children></VBox>
    </children>
</HBox>
