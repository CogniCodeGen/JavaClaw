<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.memory.MemoryCorrectionsController"
            fitToWidth="true" hbarPolicy="NEVER" visible="false" managed="false"
            styleClass="modal-content-area">
    <content>
        <VBox spacing="16.0">
            <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <children>
                <VBox spacing="3.0"><children>
                    <Label text="用户纠错" styleClass="sec-title"/>
                    <Label wrapText="true" styleClass="sec-hint"
                           text="对话中明确给出的更正会作为背景证据，并阻止已否定说法重新写回。可撤销或删除；被标记的事实可在事实分区恢复。"/>
                </children></VBox>
                <Label fx:id="empty" visible="false" managed="false" styleClass="sec-hint"/>
                <VBox fx:id="rows" spacing="2.0"/>
            </children>
        </VBox>
    </content>
</ScrollPane>
