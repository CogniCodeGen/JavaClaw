<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.memory.MemoryFactsController"
            fitToWidth="true" hbarPolicy="NEVER" visible="false" managed="false"
            styleClass="modal-content-area">
    <content>
        <VBox spacing="16.0">
            <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <children>
                <HBox spacing="10.0" alignment="BOTTOM_LEFT">
                    <children>
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS"><children>
                            <Label text="事实 · 语义记忆" styleClass="sec-title"/>
                            <Label text="蒸馏出的长期陈述；编辑后会重嵌入并获得用户保护。" styleClass="sec-hint"/>
                        </children></VBox>
                        <Button fx:id="batchButton" text="批量选择" onAction="#toggleBatchMode"
                                styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                        <Button fx:id="addButton" text="＋ 新增事实" onAction="#addFact"
                                styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                    </children>
                </HBox>
                <HBox fx:id="batchBar" spacing="12.0" alignment="CENTER_LEFT"
                      visible="false" managed="false" styleClass="mc-batch-bar">
                    <children>
                        <Label fx:id="selectedCount" text="已选 0 条" styleClass="mc-batch-count"/>
                        <Button fx:id="deleteSelectedButton" text="删除所选" onAction="#deleteSelected"
                                styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="完成" onAction="#finishBatchMode"
                                styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                    </children>
                </HBox>
                <Label fx:id="empty" visible="false" managed="false" styleClass="sec-hint"/>
                <VBox fx:id="groups" spacing="16.0"/>
            </children>
        </VBox>
    </content>
</ScrollPane>
