<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.memory.MemoryLogController"
            fitToWidth="true" hbarPolicy="NEVER" visible="false" managed="false"
            styleClass="modal-content-area">
    <content>
        <VBox spacing="16.0">
            <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <children>
                <VBox spacing="3.0"><children>
                    <Label text="变更日志" styleClass="sec-title"/>
                    <Label text="append-only 审计轨，记录记忆的每一次变更。" styleClass="sec-hint"/>
                </children></VBox>
                <HBox spacing="7.0"><children>
                    <Button fx:id="allFilter" text="全部" onAction="#showAll" styleClass="button, mc-filter-chip, mc-filter-chip-on"/>
                    <Button fx:id="addFilter" text="新增" onAction="#showAdds" styleClass="button, mc-filter-chip"/>
                    <Button fx:id="updateFilter" text="编辑" onAction="#showUpdates" styleClass="button, mc-filter-chip"/>
                    <Button fx:id="removeFilter" text="删除" onAction="#showRemoves" styleClass="button, mc-filter-chip"/>
                    <Button fx:id="mergeFilter" text="合并" onAction="#showMerges" styleClass="button, mc-filter-chip"/>
                </children></HBox>
                <Label fx:id="empty" text="没有匹配的变更记录" visible="false" managed="false" styleClass="sec-hint"/>
                <VBox fx:id="card" styleClass="mc-log-card"><children><VBox fx:id="rows"/></children></VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
