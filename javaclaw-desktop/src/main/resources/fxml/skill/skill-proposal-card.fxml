<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="8.0" styleClass="skill-card"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="actionBadge" styleClass="jc-badge"/>
                <Label fx:id="titleLabel" styleClass="skill-card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="timeLabel" styleClass="skill-card-time"/>
            </children>
        </HBox>
        <Label fx:id="warningLabel" text="⚠ 该提案将覆盖你修改过的技能，请仔细核对变更内容"
               visible="false" managed="false" wrapText="true" styleClass="skill-warn"/>
        <Label fx:id="reasonLabel" wrapText="true" styleClass="sec-hint"/>
        <TextArea fx:id="previewArea" editable="false" wrapText="true" prefRowCount="6"
                  styleClass="text-input, text-area, skill-preview-block"/>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Button text="采纳" onAction="#approveRequested"
                        styleClass="button, jc-btn, jc-btn-save, jc-btn-sm"/>
                <Button text="拒绝" onAction="#rejectRequested"
                        styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"/>
            </children>
        </HBox>
    </children>
</VBox>
