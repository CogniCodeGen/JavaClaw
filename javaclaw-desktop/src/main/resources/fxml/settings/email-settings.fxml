<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="root" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="scroll-pane, settings-scroll-pane"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.settings.EmailSettingsController">
    <content>
        <VBox spacing="12.0" maxWidth="760.0">
            <padding><Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/></padding>
            <children>
                <Label text="邮件配置" styleClass="settings-section-title"/>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="邮箱服务商：" minWidth="70.0" styleClass="settings-label"/>
                        <ComboBox fx:id="presetCombo" prefWidth="220.0"
                                  accessibleText="邮箱服务商"
                                  styleClass="combo-box, settings-combo"
                                  onAction="#presetChanged"/>
                    </children>
                </HBox>
                <Separator/>
                <Label text="发送服务器 (SMTP)" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="地址：" minWidth="40.0" styleClass="settings-label"/>
                        <TextField fx:id="smtpHostField" promptText="SMTP 服务器地址"
                                   accessibleText="SMTP 服务器地址"
                                   styleClass="text-input, text-field, settings-field"/>
                        <Label text="端口：" minWidth="40.0" styleClass="settings-label"/>
                        <TextField fx:id="smtpPortField" promptText="端口号" prefWidth="80.0"
                                   accessibleText="SMTP 端口"
                                   styleClass="text-input, text-field, settings-field"/>
                    </children>
                </HBox>
                <Label text="接收服务器 (IMAP)" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="地址：" minWidth="40.0" styleClass="settings-label"/>
                        <TextField fx:id="imapHostField" promptText="IMAP 服务器地址"
                                   accessibleText="IMAP 服务器地址"
                                   styleClass="text-input, text-field, settings-field"/>
                        <Label text="端口：" minWidth="40.0" styleClass="settings-label"/>
                        <TextField fx:id="imapPortField" promptText="端口号" prefWidth="80.0"
                                   accessibleText="IMAP 端口"
                                   styleClass="text-input, text-field, settings-field"/>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="加密方式：" minWidth="70.0" styleClass="settings-label"/>
                        <ComboBox fx:id="encryptionCombo" prefWidth="140.0"
                                  accessibleText="邮件加密方式"
                                  styleClass="combo-box, settings-combo"/>
                        <Label text="SSL 对应端口 465/993，STARTTLS 对应端口 587"
                               styleClass="settings-hint"/>
                    </children>
                </HBox>
                <Separator/>
                <Label text="账号信息" styleClass="settings-group-title"/>
                <GridPane hgap="10.0" vgap="8.0">
                    <children>
                        <Label text="登录邮箱：" minWidth="70.0" styleClass="settings-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="usernameField" promptText="邮箱地址" prefWidth="300.0"
                                   accessibleText="登录邮箱"
                                   styleClass="text-input, text-field, settings-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="授权码：" minWidth="70.0" styleClass="settings-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <fx:include fx:id="passwordField" source="../control/secret-field.fxml"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="发件人：" minWidth="70.0" styleClass="settings-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="fromAddressField"
                                   promptText="发件人地址（留空则使用登录邮箱）" prefWidth="300.0"
                                   accessibleText="发件人地址"
                                   styleClass="text-input, text-field, settings-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </children>
                </GridPane>
                <Separator/>
                <Label fx:id="storageLabel" styleClass="settings-hint"/>
            </children>
        </VBox>
    </content>
</ScrollPane>
