<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="8.0" maxWidth="1.7976931348623157E308"
      styleClass="theme-card"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets top="13.0" right="15.0" bottom="14.0" left="15.0"/></padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="nameLabel" styleClass="theme-card-name"/>
                        <Label fx:id="subtitleLabel" styleClass="theme-card-sub"/>
                    </children>
                </VBox>
                <Label fx:id="selectedLabel" text="✓" visible="false"
                       styleClass="theme-card-check"/>
            </children>
        </HBox>
        <Label fx:id="sampleLabel" text="现代极简 Studio 字体 Ag"/>
    </children>
</VBox>
