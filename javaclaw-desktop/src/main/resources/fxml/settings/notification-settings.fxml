<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="root" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="scroll-pane, settings-scroll-pane"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.settings.NotificationSettingsController">
    <content>
        <VBox spacing="12.0" maxWidth="760.0">
            <padding><Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/></padding>
            <children>
                <Label text="通知渠道配置" styleClass="settings-section-title"/>
                <Label text="配置各通知渠道的 Webhook 地址，启用后通知专家可通过这些渠道发送消息"
                       wrapText="true" styleClass="settings-hint"/>
                <Separator/>
                <Label text="钉钉机器人" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle">
                    <children>
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="钉钉机器人" styleClass="rt-main"/>
                                <Label text="群机器人 Webhook + 加签" styleClass="rt-sub"/>
                            </children>
                        </VBox>
                        <ToggleSwitch fx:id="dingtalkEnabledCheck" accessibleText="启用钉钉机器人"/>
                    </children>
                </HBox>
                <GridPane hgap="10.0" vgap="8.0">
                    <children>
                        <Label text="Webhook：" minWidth="70.0" styleClass="settings-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="dingtalkWebhookField" prefWidth="380.0"
                                   promptText="Webhook 地址（群机器人 Webhook URL）"
                                   styleClass="text-input, text-field, settings-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="加签密钥：" minWidth="70.0" styleClass="settings-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <fx:include fx:id="dingtalkSecretField" source="../control/secret-field.fxml"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </children>
                </GridPane>
                <Separator/>
                <Label text="企业微信机器人" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle">
                    <children>
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="企业微信" styleClass="rt-main"/>
                                <Label text="群机器人 Webhook" styleClass="rt-sub"/>
                            </children>
                        </VBox>
                        <ToggleSwitch fx:id="wechatEnabledCheck" accessibleText="启用企业微信机器人"/>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Webhook：" minWidth="70.0" styleClass="settings-label"/>
                        <TextField fx:id="wechatWebhookField" prefWidth="380.0"
                                   promptText="Webhook 地址（群机器人 Webhook URL）"
                                   styleClass="text-input, text-field, settings-field"/>
                    </children>
                </HBox>
                <Separator/>
                <Label text="飞书机器人" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle">
                    <children>
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="飞书" styleClass="rt-main"/>
                                <Label text="自定义机器人 Webhook + 签名" styleClass="rt-sub"/>
                            </children>
                        </VBox>
                        <ToggleSwitch fx:id="feishuEnabledCheck" accessibleText="启用飞书机器人"/>
                    </children>
                </HBox>
                <GridPane hgap="10.0" vgap="8.0">
                    <children>
                        <Label text="Webhook：" minWidth="70.0" styleClass="settings-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="feishuWebhookField" prefWidth="380.0"
                                   promptText="Webhook 地址（群机器人 Webhook URL）"
                                   styleClass="text-input, text-field, settings-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="签名密钥：" minWidth="70.0" styleClass="settings-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <fx:include fx:id="feishuSecretField" source="../control/secret-field.fxml"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </children>
                </GridPane>
                <Separator/>
                <Label text="邮件通知" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle">
                    <children>
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="邮件" styleClass="rt-main"/>
                                <Label text="复用「邮件配置」中的 SMTP 账号发送" styleClass="rt-sub"/>
                            </children>
                        </VBox>
                        <ToggleSwitch fx:id="emailEnabledCheck" accessibleText="启用邮件通知"/>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="收件人：" minWidth="70.0" styleClass="settings-label"/>
                        <TextField fx:id="emailRecipientField" prefWidth="380.0"
                                   promptText="默认通知收件人邮箱地址"
                                   styleClass="text-input, text-field, settings-field"/>
                    </children>
                </HBox>
                <Separator/>
                <Label text="自定义 Webhook" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle">
                    <children>
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="自定义 Webhook" styleClass="rt-main"/>
                                <Label text="POST JSON 到任意端点" styleClass="rt-sub"/>
                            </children>
                        </VBox>
                        <ToggleSwitch fx:id="customEnabledCheck" accessibleText="启用自定义 Webhook"/>
                    </children>
                </HBox>
                <GridPane hgap="10.0" vgap="8.0">
                    <children>
                        <Label text="URL：" minWidth="70.0" styleClass="settings-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="customWebhookField" prefWidth="380.0"
                                   promptText="Webhook URL"
                                   styleClass="text-input, text-field, settings-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="请求体：" minWidth="70.0" styleClass="settings-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="customBodyField" prefWidth="380.0"
                                   promptText="请求体模板，用 \${message} 表示消息内容"
                                   styleClass="text-input, text-field, settings-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </children>
                </GridPane>
                <Label text="请求体模板示例: {&quot;content&quot;: &quot;\${message}&quot;}"
                       styleClass="settings-hint"/>
                <Separator/>
                <Label fx:id="storageLabel" styleClass="settings-hint"/>
            </children>
        </VBox>
    </content>
</ScrollPane>
