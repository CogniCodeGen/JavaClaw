<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="root" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="scroll-pane, settings-scroll-pane"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.settings.GeneralSettingsController">
    <content>
        <VBox spacing="12.0" maxWidth="760.0">
            <padding><Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/></padding>
            <children>
                <Label text="通用设置" styleClass="settings-section-title"/>
                <Label text="界面与后台运行行为" wrapText="true" styleClass="settings-hint"/>
                <Separator/>
                <Label text="外观" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="界面风格：" minWidth="70.0" styleClass="settings-label"/>
                        <ComboBox fx:id="themeCombo" prefWidth="260.0"
                                  accessibleText="界面风格"
                                  onAction="#themeChanged"
                                  styleClass="combo-box, settings-combo"/>
                    </children>
                </HBox>
                <Label text="也可在顶部栏「风格」菜单或「界面风格」分区切换，选择立即生效。"
                       wrapText="true" styleClass="settings-hint"/>
                <Separator/>
                <Label text="后台常驻" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle"
                      onMouseClicked="#minimizeToTrayRowClicked">
                    <children>
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="关闭窗口时最小化到系统托盘" styleClass="rt-main"/>
                                <Label text="保持后台任务与定时任务运行，仅从托盘菜单「退出」才真正关闭；关闭则点窗口关闭按钮即退出"
                                       wrapText="true" styleClass="rt-sub"/>
                            </children>
                        </VBox>
                        <ToggleSwitch fx:id="minimizeToTrayCheck"
                                      accessibleText="关闭窗口时最小化到系统托盘"/>
                    </children>
                </HBox>
                <Separator/>
                <Label text="电脑应用访问" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle"
                      onMouseClicked="#computerAppAccessRowClicked">
                    <children>
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="允许智能体访问电脑应用" styleClass="rt-main"/>
                                <Label text="开启时会逐项检查并打开缺失权限的系统设置。请为当前运行宿主授权；从 IDE 启动时可能显示 IDE 或 java。授权完成后保存设置。"
                                       wrapText="true" styleClass="rt-sub"/>
                            </children>
                        </VBox>
                        <ToggleSwitch fx:id="computerAppAccessCheck"
                                      accessibleText="允许智能体访问电脑应用"/>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="输入方式：" minWidth="70.0" styleClass="settings-label"/>
                    <ComboBox fx:id="desktopInputPolicyCombo" prefWidth="300.0"
                              accessibleText="电脑应用输入方式" styleClass="combo-box, settings-combo"/>
                </HBox>
                <Label text="后台模式仅支持应用公开的控件动作；不会移动鼠标或抢占焦点。系统输入会影响当前操作，需在此显式选择。保存后对新会话生效；旧会话策略不可更改。"
                       wrapText="true" styleClass="settings-hint"/>
                <Label fx:id="computerAppAccessStatus" wrapText="true"
                       accessibleText="电脑应用系统权限状态" styleClass="settings-hint"/>
                <Button fx:id="computerAppAccessPermissionButton" text="检查并继续授权"
                        onAction="#refreshComputerPermission"
                        styleClass="button, settings-reset-button"/>
            </children>
        </VBox>
    </content>
</ScrollPane>
