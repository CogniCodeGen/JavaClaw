<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.AccessibleActionPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AccessibleActionPane fx:id="root" spacing="8.0" styleClass="workflow-node"
                      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="glyphLabel" styleClass="workflow-node-glyph"/>
                <Label fx:id="titleLabel" styleClass="workflow-node-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="badgeLabel" styleClass="jc-badge, workflow-node-badge"/>
            </children>
        </HBox>
        <Label fx:id="idLabel" styleClass="workflow-node-id"/>
    </children>
</AccessibleActionPane>
