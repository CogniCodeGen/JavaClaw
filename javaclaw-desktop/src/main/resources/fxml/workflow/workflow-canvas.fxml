<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="root" styleClass="workflow-canvas-shell"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javaclaw.ui.javafx.workflow.WorkflowCanvasController">
    <fx:define>
        <ContextMenu fx:id="nodeMenu">
            <items>
                <MenuItem fx:id="finishConnectionItem" text="连接到此节点"
                          onAction="#finishConnectionFromMenu" visible="false"/>
                <SeparatorMenuItem/>
                <MenuItem fx:id="normalConnectionItem" text="创建出口"
                          onAction="#beginNormalFromMenu"/>
                <MenuItem fx:id="errorConnectionItem" text="创建错误出口"
                          onAction="#beginErrorFromMenu"/>
                <MenuItem text="查看节点配置" onAction="#inspectFromMenu"/>
                <MenuItem fx:id="cancelConnectionItem" text="取消当前连线"
                          onAction="#cancelConnectionFromMenu" visible="false"/>
                <SeparatorMenuItem/>
                <MenuItem fx:id="deleteNodeItem" text="删除节点"
                          onAction="#deleteNodeFromMenu" visible="false"/>
            </items>
        </ContextMenu>
        <ContextMenu fx:id="edgeMenu">
            <items><MenuItem text="删除连线" onAction="#deleteEdgeFromMenu"/></items>
        </ContextMenu>
    </fx:define>
    <children>
        <ScrollPane fx:id="viewport" pannable="true" fitToWidth="false" fitToHeight="false"
                    onScroll="#zoomScrolled" styleClass="workflow-viewport">
            <content>
                <Group fx:id="graphGroup">
                    <children>
                        <Pane fx:id="graphPane" minWidth="1600.0" minHeight="1000.0"
                              styleClass="workflow-canvas">
                            <children>
                                <Pane fx:id="gridPane" mouseTransparent="true"/>
                                <Pane fx:id="edgePane" pickOnBounds="false"/>
                            </children>
                        </Pane>
                    </children>
                </Group>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER_LEFT" styleClass="workflow-canvas-head"
              StackPane.alignment="TOP_CENTER">
            <children>
                <Label fx:id="canvasHint" styleClass="workflow-canvas-hint"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="2.0" alignment="CENTER" styleClass="workflow-zoom-controls">
                    <children>
                        <Button text="−" onAction="#zoomOut"
                                styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm, workflow-zoom-btn"/>
                        <Label fx:id="zoomLabel" text="100%"/>
                        <Button text="＋" onAction="#zoomIn"
                                styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm, workflow-zoom-btn"/>
                        <Button text="适配" onAction="#fitGraph"
                                styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm, workflow-fit-btn"/>
                    </children>
                </HBox>
            </children>
        </HBox>
    </children>
</StackPane>
