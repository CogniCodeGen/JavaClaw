<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="190.0" styleClass="workflow-dock"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.workflow.WorkflowRuntimeController">
    <fx:define><ToggleGroup fx:id="dockTabs"/></fx:define>
    <children>
        <HBox spacing="4.0" styleClass="workflow-dock-tabs">
            <children>
                <ToggleButton text="验证与轨迹" selected="true" toggleGroup="$dockTabs"
                              onAction="#showTrace" styleClass="toggle-button, workflow-dock-tab"/>
                <ToggleButton text="运行历史与恢复" toggleGroup="$dockTabs"
                              onAction="#showHistory" styleClass="toggle-button, workflow-dock-tab"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ProgressIndicator fx:id="busyIndicator" visible="false" managed="false"
                                   maxWidth="18.0" maxHeight="18.0"/>
                <Label text="节点事件、发布校验与恢复记录" styleClass="workflow-dock-hint"/>
            </children>
        </HBox>
        <StackPane fx:id="dockBody" VBox.vgrow="ALWAYS">
            <children>
                <TextArea fx:id="console" editable="false" prefRowCount="5"
                          styleClass="text-input, text-area, workflow-console, workflow-dock-content"/>
                <VBox fx:id="historyPanel" spacing="6.0" visible="false" managed="false"
                      styleClass="workflow-dock-content">
                    <children>
                        <ListView fx:id="runHistory" VBox.vgrow="ALWAYS"
                                  styleClass="workflow-run-list" accessibleText="工作流运行历史"/>
                        <HBox spacing="8.0" styleClass="workflow-run-actions">
                            <children>
                                <TextField fx:id="resumeInput" HBox.hgrow="ALWAYS"
                                           promptText="人工输入，或恢复副作用节点时填写确认说明"
                                           styleClass="text-input, text-field, workflow-resume-input"/>
                                <Button text="恢复" onAction="#resumeRequested"
                                        styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                                <Button text="确认并重试" onAction="#retryRequested"
                                        styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                                <Button text="取消运行" onAction="#cancelRequested"
                                        styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"/>
                                <Button text="刷新" onAction="#refreshRequested"
                                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</VBox>
