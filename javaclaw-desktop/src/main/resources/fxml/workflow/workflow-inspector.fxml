<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="326.0" minWidth="300.0" maxWidth="350.0" styleClass="workflow-inspector"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.workflow.WorkflowInspectorController">
    <children>
        <VBox spacing="6.0" styleClass="workflow-inspector-head">
            <children>
                <Label text="属性检查器" styleClass="workflow-eyebrow"/>
                <HBox spacing="8.0">
                    <children>
                        <Label fx:id="titleLabel" text="未选择节点"
                               styleClass="workflow-inspector-title"/>
                        <Label fx:id="typeLabel" text="等待选择"
                               styleClass="jc-badge, jc-badge-stopped"/>
                    </children>
                </HBox>
            </children>
        </VBox>
        <StackPane fx:id="body" VBox.vgrow="ALWAYS">
            <children>
                <VBox fx:id="emptyPanel" spacing="10.0" alignment="CENTER">
                    <children>
                        <Label text="◎" styleClass="workflow-inspector-empty-icon"/>
                        <Label text="选择一个节点" styleClass="workflow-empty-title"/>
                        <Label text="查看配置、调整重试策略，或创建新的出口连线"
                               maxWidth="230.0" wrapText="true" styleClass="sec-hint"/>
                    </children>
                </VBox>
                <VBox fx:id="formPanel" spacing="10.0" visible="false" managed="false"
                      styleClass="workflow-inspector-form">
                    <children>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="72.0"/>
                                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                            </columnConstraints>
                            <children>
                                <Label text="节点名称" styleClass="workflow-field-label"
                                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="nodeLabel" promptText="节点名称" maxWidth="Infinity"
                                           styleClass="text-input, text-field, workflow-field"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Label text="尝试次数" styleClass="workflow-field-label"
                                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Spinner fx:id="retryAttempts" editable="true"
                                         styleClass="spinner, workflow-spinner"
                                         GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Label text="退避时间" styleClass="workflow-field-label"
                                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Spinner fx:id="retryBackoff" editable="true"
                                         styleClass="spinner, workflow-spinner"
                                         GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <Label text="恢复安全" styleClass="workflow-field-label"
                                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <ComboBox fx:id="resumeSafety" maxWidth="Infinity"
                                          styleClass="combo-box, workflow-field"
                                          GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            </children>
                        </GridPane>
                        <Label text="节点配置" styleClass="grp-title"/>
                        <TextArea fx:id="configEditor" wrapText="false" VBox.vgrow="ALWAYS"
                                  promptText="选择节点后编辑 JSON 配置"
                                  styleClass="text-input, text-area, workflow-json-editor"/>
                    </children>
                </VBox>
            </children>
        </StackPane>
        <VBox fx:id="actionPanel" spacing="8.0" visible="false" managed="false"
              styleClass="workflow-inspector-actions">
            <children>
                <HBox spacing="8.0">
                    <children>
                        <Button text="应用更改" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                onAction="#applyRequested"
                                styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                        <Button text="创建出口" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                onAction="#connectRequested"
                                styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                    </children>
                </HBox>
                <HBox spacing="8.0">
                    <children>
                        <Button text="错误出口" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                onAction="#errorConnectionRequested"
                                styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                        <Button text="删除" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                onAction="#deleteRequested"
                                styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
