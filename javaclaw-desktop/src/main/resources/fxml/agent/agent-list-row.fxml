<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox fx:id="root" alignment="CENTER_LEFT" spacing="8.0"
      styleClass="skill-list-row" onMouseClicked="#selectRequested"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.agent.AgentListRowController">
    <children>
        <Label fx:id="statusDot"/>
        <Label fx:id="nameLabel" maxWidth="Infinity" HBox.hgrow="ALWAYS"
               styleClass="skill-list-name"/>
        <Label fx:id="builtInTag" text="内置" visible="false" managed="false"
               styleClass="agent-builtin-tag"/>
    </children>
</HBox>
