<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="root" spacing="16.0" styleClass="agent-settings-panel"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.agent.AgentSettingsController">
    <children>
        <VBox spacing="10.0" minWidth="200.0" prefWidth="210.0" styleClass="agent-left-pane">
            <padding><Insets top="4.0" right="12.0" bottom="4.0"/></padding>
            <children>
                <Label text="智能体列表" styleClass="agent-list-title"/>
                <Button fx:id="addButton" text="+ 添加智能体" maxWidth="Infinity"
                        accessibleText="添加自定义智能体" styleClass="button, agent-add-btn"
                        onAction="#createRequested"/>
                <ScrollPane fitToWidth="true" styleClass="scroll-pane, agent-settings-scroll"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="2.0">
                            <padding><Insets top="4.0" bottom="4.0"/></padding>
                            <children>
                                <Label text="内置智能体" styleClass="agent-section-label"/>
                                <VBox fx:id="builtInRows" spacing="2.0"/>
                                <Label text="自定义智能体" styleClass="agent-section-label"/>
                                <Label fx:id="customEmptyLabel" text="暂无自定义智能体"
                                       styleClass="settings-hint">
                                    <padding><Insets top="4.0" right="12.0" bottom="4.0" left="12.0"/></padding>
                                </Label>
                                <VBox fx:id="customRows" spacing="2.0"/>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
        <StackPane styleClass="agent-editor-area" HBox.hgrow="ALWAYS">
            <children>
                <VBox fx:id="emptyPanel" alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="⚙" styleClass="agent-empty-icon"/>
                        <Label text="智能体配置" styleClass="agent-empty-title"/>
                        <Label text="从左侧选择一个智能体查看配置&#10;或点击「+ 添加智能体」创建自定义智能体"
                               styleClass="settings-hint, agent-empty-hint"/>
                    </children>
                </VBox>
                <fx:include fx:id="editorPanel" source="agent-editor.fxml"/>
                <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                           styleClass="loading-overlay" accessibleText="智能体操作进行中">
                    <children><ProgressIndicator maxWidth="36.0" maxHeight="36.0"/></children>
                </StackPane>
            </children>
        </StackPane>
    </children>
</HBox>
