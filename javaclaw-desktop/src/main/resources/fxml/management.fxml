<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<!-- 沿用原 modal/header/footer 与领域页面 CSS；不引入独立管理后台视觉语言。 -->
<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.javaclaw.desktop.ManagementController" styleClass="domain-window-root">
    <BorderPane styleClass="domain-window">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="mc-header">
                <Label fx:id="heading" styleClass="management-heading" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="workspace" styleClass="mc-header-tag" />
            </HBox>
        </top>
        <center>
            <BorderPane fx:id="content" styleClass="modal-content-area" />
        </center>
        <bottom>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="modal-foot">
                <ProgressIndicator fx:id="busy" prefWidth="18.0" prefHeight="18.0" maxWidth="18.0"
                    maxHeight="18.0" />
                <Label fx:id="status" wrapText="true" styleClass="sec-hint" HBox.hgrow="ALWAYS"
                    maxWidth="Infinity" />
                <Label fx:id="dirty" text="" visible="false" managed="false" accessibleText="页面有未保存修改"
                    styleClass="management-dirty-indicator" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="closeButton" text="关闭" onAction="#close" accessibleText="关闭管理窗口"
                    styleClass="button, jc-btn, jc-btn-ghost" />
            </HBox>
        </bottom>
    </BorderPane>
    <Label fx:id="windowToast" visible="false" managed="false" mouseTransparent="true" accessibleText="管理窗口提示"
        styleClass="window-toast" StackPane.alignment="TOP_CENTER">
        <StackPane.margin>
            <Insets top="68" />
        </StackPane.margin>
    </Label>
</StackPane>
