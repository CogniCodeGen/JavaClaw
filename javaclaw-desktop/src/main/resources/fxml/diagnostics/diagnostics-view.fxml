<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.diagnostics.DiagnosticsController">
    <top>
        <VBox>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <padding><Insets top="12.0" right="14.0" bottom="8.0" left="14.0"/></padding>
                    <children>
                        <Label text="时间"/>
                        <ComboBox fx:id="rangeBox" accessibleText="诊断事件时间范围"/>
                        <Label text="智能体"/>
                        <TextField fx:id="agentField" promptText="智能体（精确匹配）" prefWidth="160.0"
                                   accessibleText="智能体精确筛选"/>
                        <Label text="事件"/>
                        <ComboBox fx:id="eventBox" accessibleText="诊断事件类型"/>
                        <TextField fx:id="keywordField" promptText="关键字（内容子串匹配）"
                                   accessibleText="诊断内容关键字"
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="queryButton" text="查询" styleClass="button, skill-add-btn"
                                accessibleText="查询诊断事件"
                                onAction="#queryRequested"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <ListView fx:id="resultList" styleClass="list-view, diagnostics-result-list"
                  accessibleText="诊断事件查询结果"/>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0"
              style="-fx-background-color: -jc-surface-panel; -fx-border-color: -jc-border; -fx-border-width: 1 0 0 0;">
            <padding><Insets top="10.0" right="14.0" bottom="10.0" left="14.0"/></padding>
            <children>
                <Label fx:id="summaryLabel" text="请点击「查询」加载事件"
                       style="-fx-text-fill: -jc-text-muted; -fx-font-size: 12px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="exportButton" text="导出诊断包" styleClass="button, task-edit-btn"
                        accessibleText="导出诊断包"
                        onAction="#exportRequested"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
