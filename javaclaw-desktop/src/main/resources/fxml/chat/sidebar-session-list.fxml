<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.chat.SidebarSessionListController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <padding><Insets top="10.0" right="16.0" bottom="6.0" left="16.0"/></padding>
            <children>
                <Label text="最近会话" styleClass="sidebar-section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="sessionCountLabel" styleClass="sidebar-section-count"/>
                <Button fx:id="manageButton" text="管理" styleClass="sidebar-manage-btn"
                        onAction="#toggleBatchMode">
                    <tooltip><Tooltip text="批量管理会话"/></tooltip>
                </Button>
            </children>
        </HBox>

        <VBox>
            <padding><Insets right="12.0" bottom="6.0" left="12.0"/></padding>
            <children>
                <StackPane>
                    <children>
                        <TextField fx:id="searchField" promptText="搜索会话…"
                                   styleClass="sidebar-search-field"
                                   style="-fx-padding: 8 12 8 28;"/>
                        <Label text="⌕" mouseTransparent="true"
                               StackPane.alignment="CENTER_LEFT"
                               styleClass="sidebar-search-icon">
                            <StackPane.margin><Insets left="10.0"/></StackPane.margin>
                        </Label>
                    </children>
                </StackPane>
            </children>
        </VBox>

        <HBox fx:id="batchDeleteRow" alignment="CENTER_LEFT" spacing="6.0"
              visible="false" managed="false">
            <padding><Insets top="4.0" right="8.0" bottom="4.0" left="8.0"/></padding>
            <children>
                <Button fx:id="selectAllButton" text="全选"
                        styleClass="sidebar-batch-select-all-btn"
                        onAction="#onToggleSelectAll"/>
                <Button fx:id="batchDeleteButton" text="删除选中" disable="true"
                        maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"
                        styleClass="sidebar-batch-delete-btn"
                        onAction="#onBatchDelete"/>
            </children>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS" styleClass="sidebar-list-layer">
            <children>
                <ListView fx:id="sessionList" styleClass="sidebar-list-scroll"
                          focusTraversable="false"/>
                <VBox fx:id="emptyState" alignment="CENTER" spacing="6.0"
                      mouseTransparent="true" styleClass="sidebar-empty-state">
                    <children>
                        <Label text="☰" styleClass="sidebar-empty-icon"/>
                        <Label fx:id="emptyTitle" text="还没有会话"
                               styleClass="sidebar-empty-title"/>
                        <Label fx:id="emptyHint" text="点击上方「新建对话」开始"
                               wrapText="true" styleClass="sidebar-empty-hint"/>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</VBox>
