<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="root" alignment="TOP_LEFT" spacing="10.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.loop.LoopStatusController">
    <padding><Insets top="6.0" right="12.0" bottom="6.0" left="12.0"/></padding>
    <children>
        <Label text="🔁" styleClass="msg-avatar-assistant"/>
        <VBox spacing="8.0" maxWidth="Infinity" styleClass="loop-status-card"
              HBox.hgrow="ALWAYS">
            <padding><Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="🔁 循环" styleClass="loop-status-title"/>
                        <Label fx:id="iterationLabel" styleClass="loop-status-iter"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="badge" styleClass="loop-badge"/>
                    </children>
                </HBox>
                <HBox fx:id="criteriaRow" alignment="CENTER_LEFT" spacing="8.0"
                      visible="false" managed="false">
                    <children>
                        <ProgressBar fx:id="criteriaBar" progress="0.0" maxWidth="Infinity"
                                     styleClass="loop-progress" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="criteriaLabel" minWidth="-Infinity"
                               styleClass="loop-status-meta"/>
                    </children>
                </HBox>
                <Label fx:id="reasonLabel" wrapText="true" visible="false" managed="false"
                       styleClass="loop-status-reason"/>
                <Label fx:id="tokensLabel" styleClass="loop-status-meta"/>
            </children>
        </VBox>
    </children>
</HBox>
