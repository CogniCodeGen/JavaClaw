<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Tooltip?>

<MenuButton fx:id="root" text="📖 知识库" styleClass="knowledge-menu"
            onShowing="#showing" onHidden="#hidden"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.knowledge.KnowledgeMenuController">
    <tooltip>
        <Tooltip fx:id="knowledgeTooltip" text="选择知识库中的文档作为对话参考"/>
    </tooltip>
</MenuButton>
