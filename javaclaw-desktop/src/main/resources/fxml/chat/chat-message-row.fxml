<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxmisc.richtext.InlineCssTextArea?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javaclaw.chat.ChatMessageRowController">
    <children>
        <HBox fx:id="normalRow" alignment="TOP_LEFT" spacing="10.0"
              visible="false" managed="false">
            <padding><Insets top="6.0" right="12.0" bottom="6.0" left="12.0"/></padding>
            <children>
                <StackPane alignment="TOP_LEFT">
                    <children>
                        <Label fx:id="userAvatar" text="Y" styleClass="msg-avatar-user"/>
                        <Label fx:id="assistantAvatar" text="✦"
                               visible="false" managed="false"
                               styleClass="msg-avatar-assistant"/>
                    </children>
                </StackPane>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label fx:id="authorLabel" styleClass="msg-header-name"/>
                                <Label fx:id="modelBadge" visible="false" managed="false"
                                       styleClass="msg-header-model"/>
                                <Label fx:id="timeLabel" styleClass="msg-header-time"/>
                                <Region fx:id="headerSpacer" visible="false" managed="false"
                                        HBox.hgrow="ALWAYS"/>
                                <Label fx:id="metaLabel" visible="false" managed="false"
                                       styleClass="msg-header-meta"/>
                            </children>
                        </HBox>
                        <VBox spacing="6.0" styleClass="msg-plain-body">
                            <children>
                                <FlowPane fx:id="attachmentFlow" hgap="8.0" vgap="8.0"
                                          maxWidth="520.0" visible="false" managed="false"/>
                                <InlineCssTextArea fx:id="plainTextArea"
                                                   visible="false" managed="false"
                                                   styleClass="bubble-text-area"/>
                                <StackPane fx:id="markdownHost"
                                           visible="false" managed="false"/>
                                <VBox fx:id="extraImagesHost" spacing="6.0"
                                      visible="false" managed="false"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox fx:id="systemRow" alignment="CENTER" visible="false" managed="false">
            <padding><Insets top="2.0" right="5.0" bottom="2.0" left="5.0"/></padding>
            <children>
                <VBox spacing="2.0">
                    <children>
                        <VBox styleClass="message-bubble, message-system">
                            <padding><Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/></padding>
                            <children>
                                <InlineCssTextArea fx:id="systemTextArea"
                                                   styleClass="bubble-text-area"/>
                            </children>
                        </VBox>
                        <Label fx:id="systemTimeLabel" styleClass="time-label"/>
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox fx:id="welcomeRow" alignment="CENTER_LEFT" visible="false" managed="false">
            <padding><Insets top="2.0" right="5.0" bottom="2.0" left="5.0"/></padding>
            <children>
                <VBox spacing="2.0">
                    <children>
                        <VBox styleClass="message-bubble, message-assistant">
                            <padding><Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/></padding>
                            <children>
                                <InlineCssTextArea fx:id="welcomeTextArea"
                                                   styleClass="bubble-text-area"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
