<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<MenuItem fx:id="root" onAction="#selected"
          xmlns="http://javafx.com/javafx/25"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.javaclaw.ui.javafx.theme.ThemeMenuEntryController">
    <graphic>
        <HBox alignment="CENTER_LEFT" spacing="10.0" minWidth="210.0">
            <children>
                <HBox style="-fx-border-color: -jc-border; -fx-border-radius: 6; -fx-background-radius: 6; -fx-border-width: 1;">
                    <children>
                        <Region fx:id="brandSwatch" minWidth="16.0" minHeight="24.0"
                                maxWidth="16.0" maxHeight="24.0"/>
                        <Region fx:id="backgroundSwatch" minWidth="16.0" minHeight="24.0"
                                maxWidth="16.0" maxHeight="24.0"/>
                        <Region fx:id="surfaceSwatch" minWidth="16.0" minHeight="24.0"
                                maxWidth="16.0" maxHeight="24.0"/>
                    </children>
                </HBox>
                <VBox spacing="1.0">
                    <children>
                        <Label fx:id="nameLabel"
                               style="-fx-font-size: 12.5px; -fx-font-weight: 600; -fx-text-fill: -jc-text-title;"/>
                        <Label fx:id="subtitleLabel"
                               style="-fx-font-size: 10.5px; -fx-text-fill: -jc-text-hint;"/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="selectedMark"
                       style="-fx-text-fill: -jc-primary-500; -fx-font-size: 13px;"/>
            </children>
        </HBox>
    </graphic>
</MenuItem>
