<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.mcp.McpImportDialogController"
      spacing="10.0" style="-fx-padding: 4;">
    <children>
        <Label text="粘贴 MCP JSON 配置" styleClass="settings-section-title"/>
        <Label wrapText="true" styleClass="settings-hint"
               text="兼容 Claude Desktop / Cursor / Cline 的 mcpServers JSON。支持完整文件、servers 映射或单条配置；导入时同名服务器会被覆盖。"/>
        <TextField fx:id="nameField" promptText="名称（仅当粘贴单条配置时使用）"
                   styleClass="settings-field"/>
        <TextArea fx:id="jsonArea" promptText="把 MCP JSON 配置粘贴到这里…"
                  prefRowCount="14" prefColumnCount="60" wrapText="false"
                  styleClass="mcp-env-area"/>
        <Separator/>
        <Label fx:id="previewLabel" wrapText="true" styleClass="settings-hint"/>
    </children>
</VBox>
