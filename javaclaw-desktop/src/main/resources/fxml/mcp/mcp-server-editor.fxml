<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.mcp.McpServerEditorController"
      spacing="12.0" style="-fx-padding: 4;">
    <fx:define><ToggleGroup fx:id="transportGroup"/></fx:define>
    <children>
        <Label fx:id="titleLabel" styleClass="settings-section-title"/>
        <Label text="名称" styleClass="settings-group-title"/>
        <TextField fx:id="nameField" promptText="服务器名称（唯一标识）" prefWidth="440.0"
                   styleClass="settings-field"/>
        <Label text="传输类型" styleClass="settings-group-title"/>
        <HBox alignment="CENTER_LEFT" styleClass="seg-container">
            <children>
                <ToggleButton fx:id="stdioButton" text="stdio（本地进程）" selected="true"
                              toggleGroup="$transportGroup" onAction="#stdioRequested"
                              styleClass="toggle-button, seg-btn"/>
                <ToggleButton fx:id="httpButton" text="http（远程 URL）"
                              toggleGroup="$transportGroup" onAction="#httpRequested"
                              styleClass="toggle-button, seg-btn"/>
            </children>
        </HBox>
        <VBox fx:id="stdioSection" spacing="8.0">
            <children>
                <Label text="启动命令" styleClass="settings-group-title"/>
                <TextField fx:id="commandField" promptText="npx / python / node / uvx"
                           styleClass="settings-field"/>
                <Label text="参数（一行一个）" styleClass="settings-group-title"/>
                <TextArea fx:id="argumentsArea" prefRowCount="5" wrapText="false"
                          promptText="命令参数（一行一个，按顺序执行）"
                          styleClass="mcp-env-area"/>
                <Label fx:id="commandPreview" wrapText="true" styleClass="settings-hint"/>
                <Label text="环境变量" styleClass="settings-group-title"/>
                <VBox fx:id="environmentRows" spacing="4.0"/>
                <Button text="+ 添加环境变量" onAction="#addEnvironmentRequested"
                        styleClass="settings-test-button"/>
            </children>
        </VBox>
        <VBox fx:id="httpSection" spacing="8.0" visible="false" managed="false">
            <children>
                <Label text="MCP 端点 URL" styleClass="settings-group-title"/>
                <TextField fx:id="urlField" promptText="https://api.example.com/mcp"
                           styleClass="settings-field"/>
                <Label text="HTTP Headers（如 Authorization）" styleClass="settings-group-title"/>
                <VBox fx:id="headerRows" spacing="4.0"/>
                <Button text="+ 添加 Header" onAction="#addHeaderRequested"
                        styleClass="settings-test-button"/>
            </children>
        </VBox>
        <CheckBox fx:id="enabledCheck" text="启用" selected="true"
                  styleClass="settings-checkbox"/>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Button fx:id="testButton" text="🔌 测试连接" onAction="#testRequested"
                        styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                <Label fx:id="testResultLabel" wrapText="true" maxWidth="430.0"
                       styleClass="settings-hint"/>
            </children>
        </HBox>
        <Label fx:id="errorLabel" visible="false" managed="false" wrapText="true"
               styleClass="settings-hint, status-error"/>
    </children>
</VBox>
