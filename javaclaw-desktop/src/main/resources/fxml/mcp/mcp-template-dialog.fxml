<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.mcp.McpTemplateDialogController"
      spacing="10.0" style="-fx-padding: 4;">
    <children>
        <Label text="从模板添加" styleClass="sec-title"/>
        <Label text="选择常用服务模板，下一步可补充路径、密钥和启动参数。"
               wrapText="true" styleClass="sec-hint"/>
        <ListView fx:id="templateList" prefHeight="360.0" prefWidth="520.0"
                  onMouseClicked="#templateClicked"/>
    </children>
</VBox>
