<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<!-- v5 JavaFX 壳沿用 509f197 的布局比例、CSS 令牌和交互语言；所有数据只来自 SDK。 -->
<BorderPane fx:id="root" styleClass="chat-root" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.javaclaw.desktop.shell.DesktopShellController">
    <left>
        <VBox fx:id="sidebar" prefWidth="240" minWidth="200" maxWidth="280" accessibleText="Workspace 与 Thread 导航"
            styleClass="sidebar-root">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding>
                    <Insets top="16" right="16" bottom="14" left="16" />
                </padding>
                <Label text="✦" styleClass="sb-brand-mark" />
                <Label text="JavaClaw" styleClass="sb-brand-name" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="5.0" styleClass="sb-brand-ver" />
            </HBox>
            <VBox spacing="10">
                <padding>
                    <Insets right="16" bottom="10" left="16" />
                </padding>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <ComboBox fx:id="workspaceBox" promptText="选择工作区" accessibleText="选择工作区"
                        maxWidth="Infinity" styleClass="sidebar-workspace-combo" HBox.hgrow="ALWAYS" />
                    <Button text="＋" onAction="#newWorkspace" accessibleText="新建工作区" styleClass="sidebar-ws-btn" />
                </HBox>
                <Button text="＋ 新建对话" onAction="#newThread" accessibleText="新建对话" maxWidth="Infinity"
                    styleClass="sb-new-btn" />
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="sidebar-section-title">
                <padding>
                    <Insets top="3" right="16" bottom="6" left="16" />
                </padding>
                <Label text="对话" styleClass="sidebar-section-title" />
            </HBox>
            <ListView fx:id="threadList" accessibleText="当前工作区的对话列表" styleClass="sidebar-list-scroll"
                VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="从新建对话开始" styleClass="chat-top-meta" />
                </placeholder>
            </ListView>
            <Separator />
            <VBox spacing="8" styleClass="sidebar-navigation">
                <Button fx:id="settingsButton" text="⚙  设置与管理" onAction="#openSettings"
                    accessibleText="打开设置与管理中心，快捷键 Ctrl 或 Command 加逗号" maxWidth="Infinity"
                    styleClass="sidebar-nav-button" />
                <Label fx:id="connectionLabel" text="尚未连接 App Server" accessibleText="App Server 连接状态"
                    wrapText="true" styleClass="chat-top-meta" />
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane styleClass="desktop-shell-stack">
            <BorderPane styleClass="chat-root">
                <top>
                    <VBox>
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chat-top-bar">
                            <Button text="☰" onAction="#toggleSidebar" accessibleText="显示或隐藏会话侧栏"
                                styleClass="shell-toggle-button" />
                            <Label text="●" styleClass="chat-top-status-dot,status-idle" />
                            <VBox spacing="4">
                                <Label fx:id="threadTitle" text="新对话" styleClass="chat-top-title" />
                                <Label fx:id="threadMeta" text="选择工作区，开始你的任务" styleClass="chat-top-meta" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="审批" onAction="#toggleProgress" accessibleText="显示或隐藏审批面板"
                                styleClass="shell-toggle-button" />
                        </HBox>
                        <Label fx:id="errorLabel" visible="false" managed="false" wrapText="true"
                            maxWidth="Infinity" styleClass="error-banner" />
                        <VBox fx:id="connectionErrorCard" visible="false" managed="false" spacing="10"
                            accessibleText="App Server 连接失败恢复操作"
                            styleClass="jc-card,platform-section-card,connection-error-card">
                            <padding>
                                <Insets top="12" right="16" bottom="12" left="16" />
                            </padding>
                            <Label text="无法连接到 App Server" styleClass="grp-title,platform-action-error" />
                            <Label fx:id="connectionErrorDetail" wrapText="true" styleClass="sec-hint" />
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button text="重新连接" onAction="#retryConnection" accessibleText="重新连接 App Server"
                                    styleClass="jc-btn,jc-btn-primary" />
                                <Button text="打开诊断" onAction="#openDiagnostics" accessibleText="打开脱敏诊断页面"
                                    styleClass="jc-btn,jc-btn-soft" />
                                <Button fx:id="connectionStartButton" text="启动 App Server"
                                    styleClass="jc-btn,jc-btn-ghost" />
                            </HBox>
                        </VBox>
                    </VBox>
                </top>
                <center>
                    <ListView fx:id="transcriptList" accessibleText="当前对话内容"
                        styleClass="message-scroll,transcript-list">
                        <placeholder>
                            <VBox alignment="CENTER" spacing="12" styleClass="welcome-panel">
                                <Label text="✦" styleClass="welcome-mark" />
                                <Label text="有什么我可以帮你的？" styleClass="welcome-title" />
                                <Label text="对话、规划与执行，都从这里开始。" styleClass="chat-top-meta" />
                            </VBox>
                        </placeholder>
                    </ListView>
                </center>
                <bottom>
                    <VBox styleClass="input-bar">
                        <VBox accessibleText="消息输入与运行配置" styleClass="composer-card">
                            <TextArea fx:id="composer" promptText="输入消息…" accessibleText="消息输入框"
                                prefRowCount="2" wrapText="true" minHeight="56" maxHeight="240"
                                styleClass="input-field,composer-input" />
                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="composer-toolbar">
                                <ComboBox fx:id="profileBox" promptText="使用工作区默认 Agent Profile"
                                    accessibleText="选择 Agent Profile；不选择时使用工作区默认配置" prefWidth="300"
                                    styleClass="composer-select" />
                                <Button text="默认" onAction="#useDefaultProfile"
                                    accessibleText="恢复使用工作区默认 Agent Profile" styleClass="sidebar-manage-btn" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="interruptButton" text="停止" onAction="#interrupt"
                                    accessibleText="停止当前任务" styleClass="sidebar-manage-btn,composer-interrupt-button" />
                                <Button fx:id="sendButton" text="发送 ↑" onAction="#send" accessibleText="发送消息"
                                    styleClass="send-button,composer-send-button" />
                            </HBox>
                        </VBox>
                    </VBox>
                </bottom>
            </BorderPane>
        </StackPane>
    </center>
    <right>
        <VBox fx:id="progressPanel" prefWidth="340" accessibleText="等待用户输入与审批"
            styleClass="thinking-panel-root,desktop-progress-panel">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding>
                    <Insets top="14" right="14" bottom="12" left="14" />
                </padding>
                <Label text="待处理事项" styleClass="thinking-panel-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="×" onAction="#toggleProgress" accessibleText="关闭审批面板"
                    styleClass="sidebar-manage-btn" />
            </HBox>
            <VBox fx:id="inputRequestHost" spacing="8" accessibleText="等待用户输入" styleClass="input-request-host" />
            <Separator />
            <Label text="工具审批" styleClass="thinking-panel-title,approval-section-title" />
            <ListView fx:id="approvalList" accessibleText="等待决策的工具调用" styleClass="progress-list"
                VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="当前没有等待审批的工具调用。" wrapText="true" styleClass="progress-empty" />
                </placeholder>
            </ListView>
            <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="progress-metrics">
                <Button fx:id="denyButton" text="拒绝" onAction="#deny" accessibleText="拒绝选中调用"
                    styleClass="jc-btn,jc-btn-danger" />
                <Button fx:id="approveButton" text="批准" onAction="#approve" accessibleText="批准选中调用"
                    styleClass="jc-btn,jc-btn-primary" />
            </HBox>
        </VBox>
    </right>
</BorderPane>
