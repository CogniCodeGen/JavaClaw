<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="root" alignment="CENTER_LEFT" spacing="14.0" styleClass="kc-doc-row"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER" minWidth="40.0" prefWidth="40.0">
            <children><ToggleSwitch fx:id="enabledToggle" accessibleText="参与检索"/></children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="11.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="typeBadge" text="TXT" styleClass="kc-type-badge, kc-type-txt"/>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label fx:id="nameLabel" maxWidth="320.0" styleClass="kc-doc-name"/>
                                <Label fx:id="scopeLabel" text="工作区"
                                       styleClass="kc-scope-tag, kc-scope-workspace"/>
                            </children>
                        </HBox>
                        <Label fx:id="summaryLabel" maxWidth="420.0" textOverrun="ELLIPSIS"
                               styleClass="kc-doc-desc"/>
                    </children>
                </VBox>
            </children>
        </HBox>
        <Label fx:id="chunksLabel" text="0" minWidth="74.0" alignment="CENTER_RIGHT"
               styleClass="kc-doc-chunks"/>
        <Label fx:id="timeLabel" text="—" minWidth="96.0" styleClass="kc-doc-time"/>
        <Label text="›" minWidth="24.0" alignment="CENTER" styleClass="kc-doc-arrow"/>
    </children>
</HBox>
