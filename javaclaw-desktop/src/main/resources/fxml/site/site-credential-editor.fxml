<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.site.SiteCredentialEditorController"
      spacing="12.0" style="-fx-padding: 4;">
    <children>
        <Label fx:id="titleLabel" styleClass="settings-section-title"/>
        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="展示名" styleClass="settings-group-title" GridPane.rowIndex="0"/>
                <TextField fx:id="nameField" promptText="展示名（如 GitHub、内部 OA）"
                           prefWidth="420.0" styleClass="settings-field" GridPane.rowIndex="1"/>
                <Label text="主机匹配" styleClass="settings-group-title" GridPane.rowIndex="2"/>
                <TextField fx:id="hostField" promptText="主机匹配，如 github.com 或 *.example.com"
                           styleClass="settings-field" GridPane.rowIndex="3"/>
                <Label text="精确匹配域名（github.com）或前缀通配（*.example.com 匹配任意子域）"
                       wrapText="true" styleClass="settings-hint" GridPane.rowIndex="4"/>
                <Label text="登录页 URL（可选）" styleClass="settings-group-title" GridPane.rowIndex="5"/>
                <TextField fx:id="loginUrlField" promptText="登录页 URL（可选，便于一键打开）"
                           styleClass="settings-field" GridPane.rowIndex="6"/>
                <Label text="用户名（可选）" styleClass="settings-group-title" GridPane.rowIndex="7"/>
                <TextField fx:id="usernameField" promptText="用户名 / 邮箱（可选，用于自动填表）"
                           styleClass="settings-field" GridPane.rowIndex="8"/>
                <Label text="密码（可选）" styleClass="settings-group-title" GridPane.rowIndex="9"/>
                <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="10">
                    <children>
                        <StackPane HBox.hgrow="ALWAYS">
                            <children>
                                <PasswordField fx:id="passwordField"
                                               promptText="密码（可选，不进入 LLM 上下文）"
                                               maxWidth="1.7976931348623157E308"
                                               styleClass="settings-field"/>
                                <TextField fx:id="passwordPlainField" visible="false" managed="false"
                                           promptText="密码（可选，不进入 LLM 上下文）"
                                           maxWidth="1.7976931348623157E308"
                                           styleClass="settings-field"/>
                            </children>
                        </StackPane>
                        <ToggleButton fx:id="revealButton" text="👁" styleClass="settings-test-button"
                                      onAction="#revealRequested">
                            <tooltip><Tooltip text="显示/隐藏密码"/></tooltip>
                        </ToggleButton>
                    </children>
                </HBox>
                <Label text="备注" styleClass="settings-group-title" GridPane.rowIndex="11"/>
                <TextArea fx:id="notesArea" promptText="备注（可选）" prefRowCount="2"
                          styleClass="mcp-env-area" GridPane.rowIndex="12"/>
            </children>
        </GridPane>
    </children>
</VBox>
