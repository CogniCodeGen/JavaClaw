<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.site.SiteCredentialCardController"
      spacing="4.0" style="-fx-padding: 10 12 10 12;" styleClass="mcp-server-card">
    <children>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="sessionBadge" styleClass="mcp-state-badge"/>
                <Label fx:id="nameLabel" styleClass="mcp-server-name"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="编辑" styleClass="settings-test-button" onAction="#editRequested"/>
                <Button fx:id="resetButton" text="重置会话" styleClass="settings-test-button"
                        onAction="#resetRequested"/>
                <Button text="删除" styleClass="danger-btn" onAction="#deleteRequested"/>
            </children>
        </HBox>
        <Label fx:id="hostLabel" styleClass="settings-hint"/>
        <Label fx:id="accountLabel" styleClass="settings-hint"/>
        <Label fx:id="timestampsLabel" styleClass="settings-hint"/>
        <Label fx:id="notesLabel" wrapText="true" styleClass="settings-hint"/>
    </children>
</VBox>
