<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.javaclaw</groupId><artifactId>javaclaw-parent</artifactId><version>4.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>javaclaw-desktop</artifactId>
    <packaging>jar</packaging>

    <name>JavaClaw</name>
    <description>基于 JavaFX、Spring AI 2.0 和统一 Agent Framework 的智能体桌面应用</description>

    <properties>
        <!-- 开发数据仍属于聚合项目根；测试数据只写入 Desktop 自身的 target。 -->
        <javaclaw.launch.home>${project.basedir}/..</javaclaw.launch.home>
        <javaclaw.launch.data.dir>${javaclaw.launch.home}/data</javaclaw.launch.data.dir>
        <javaclaw.launch.ui.test>false</javaclaw.launch.ui.test>
        <javaclaw.fx.tests>false</javaclaw.fx.tests>
    </properties>

    <dependencies>
        <!-- 主程序仅依赖协议，不依赖 SDK、Runner 或插件实现。 -->
        <dependency><groupId>com.javaclaw</groupId><artifactId>plugin-protocol</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.grpc</groupId><artifactId>grpc-netty-shaded</artifactId><version>1.75.0</version></dependency>
        <!--
            Spring AI 2.0：ChatClient、递归 Advisor、Tool Calling、RAG/VectorStore
            以及 JavaClaw 当前支持的四类模型 Provider。所有模型构造集中在
            framework.springai，产品功能只能通过框架网关调用。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-google-genai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!-- Agent Studio、工具参数与扩展事件统一按 JSON Schema Draft 2020-12 校验。 -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>

        <!-- 调度是产品基础设施，显式依赖 Quartz。 -->
        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
            <version>${quartz.version}</version>
        </dependency>

        <!-- JavaFX 控件库（UI 组件：Button、TextField、ScrollPane 等） -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- FXML：3.0 所有生产页面与复用控件的静态视图结构。 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!--
            JavaFX 孵化富文本控件（RichTextArea/CodeArea）
            用于聊天气泡的原生 Markdown 渲染。
            classpath（Launcher）模式下无需额外 JVM 参数；mvn javafx:run（module path）
            需要 add-modules jfx.incubator.richtext（见 javafx-maven-plugin options）。
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>jfx-incubator-richtext</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!--
            Jakarta Mail（邮件收发）
            提供 SMTP 发送和 IMAP 接收能力
        -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <version>${angus.mail.version}</version>
        </dependency>

        <!--
            Apache PDFBox（PDF 文本提取）
            用于从 PDF 文档中提取文本内容发送给模型
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!--
            RichTextFX（富文本编辑/展示）
            提供原生文本选中复制、多行输入、样式化文本等能力
        -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>${richtextfx.version}</version>
        </dependency>

        <!--
            CommonMark（Markdown 解析与 HTML 渲染）
            用于聊天气泡中 Markdown 格式内容的渲染展示
        -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-autolink</artifactId>
            <version>${commonmark.autolink.version}</version>
            <exclusions>
                <!-- 核心统一使用上面的 0.30.0，避免扩展传递回 0.29.0。 -->
                <exclusion>
                    <groupId>org.commonmark</groupId>
                    <artifactId>commonmark</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Logback 日志实现 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!--
            Playwright Java（原生浏览器自动化）
            替代 JavaFX WebView，提供完整的浏览器交互能力：
            无障碍树快照、元素引用、截图标注、Tab管理、Cookie 持久化等
        -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.52.0</version>
        </dependency>
        <!-- 保留 Chrome 安装包中的执行权限与 macOS 应用包内部链接。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.28.0</version>
        </dependency>

        <!--
            EclipseStore（Java 原生对象图持久化）+ GigaMap JVector 向量索引
            作为重构后记忆/知识子系统的统一存储基座：对象图持久化 + ANN 语义检索
            注意：JVector 走 jdk.incubator.vector（JDK 25 仍为孵化模块），
            运行需在 JVM 参数加 add-modules jdk.incubator.vector（见 javafx-maven-plugin options）
        -->
        <dependency>
            <groupId>org.eclipse.store</groupId>
            <artifactId>storage-embedded</artifactId>
            <version>${eclipsestore.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.store</groupId>
            <artifactId>gigamap-jvector</artifactId>
            <version>${eclipsestore.version}</version>
        </dependency>

        <!-- H2：工作区本地结构化配置数据库（data/javaclaw.mv.db） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>

        <!-- Spring 只负责显式对象装配、事务与 JDBC；桌面应用不引入 Boot 或 WebMVC。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!-- JUnit 5（单元测试；运行 mvn test） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <!-- 本地 SMTP/IMAP 验收夹具；测试不会连接或发送到外部邮件服务。 -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven 编译插件：指定 JDK 25 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                    <!-- Spring AI 根据 Java 参数名生成工具输入 Schema。 -->
                    <parameters>true</parameters>
                    <!-- JVector 使用孵化中的向量 API（JDK 25 仍为 incubator），编译期需放行该模块 -->
                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>jdk.incubator.vector,jdk.httpserver</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

<!--
                JavaFX Maven 插件：用于运行 JavaFX 应用
                使用 Launcher 类作为入口，避免非模块化 JavaFX 的启动问题
                运行命令：mvn javafx:run
            -->
            <!-- Surefire：跑 JUnit 5 测试；argLine 与编译参数对齐（JVector 孵化向量 API） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- JaCoCo 在 initialize 阶段设置属性，因此使用延迟求值。 -->
                    <argLine>@{jacocoArgLine} --add-modules jdk.incubator.vector,jdk.httpserver --enable-native-access=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <javaclaw.development.home>${project.build.directory}/test-home</javaclaw.development.home>
                        <javaclaw.data.dir>${project.build.directory}/test-home/data</javaclaw.data.dir>
                        <javaclaw.fx.tests>${javaclaw.fx.tests}</javaclaw.fx.tests>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- 覆盖率报告与三组聚合门禁：全项目、核心执行层、所有顶层 Controller。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                            <!-- 每次测试运行独立采集，避免不同 profile/依赖图的旧类 ID 混入报告。 -->
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-overall-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.overall.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.overall.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-core-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/javaclaw/application/**</include>
                                <include>com/javaclaw/platform/execution/**</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.core.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.core.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-controller-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*Controller.class</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.controller.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.controller.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.javaclaw.app.Launcher</mainClass>
                    <!-- 运行期放行 JVector 的孵化向量 API + EclipseStore/JVector 的 FFM 原生访问（FFM 在 JDK 25 已 GA，无需 enable-preview）。
                         三条 add-exports 服务于 Markdown 气泡（chat.markdown）依赖的 JavaFX 孵化富文本控件：
                         本插件只把 javafx-* 前缀构件放 module path，jfx-incubator-richtext 落在 classpath
                        （unnamed module），而 JavaFX 核心对 com.sun 内部包只做了面向 jfx.incubator.richtext
                         命名模块的定向导出，故需显式向 ALL-UNNAMED 开放（清单由 jdeps 对两个孵化 jar 实测得出）。
                         IDE 直跑（JavaFX 全在 classpath）不需要这三条参数。 -->
                    <options>
                        <option>-Djavaclaw.development.home=${javaclaw.launch.home}</option>
                        <option>-Djavaclaw.data.dir=${javaclaw.launch.data.dir}</option>
                        <option>-Djavaclaw.ui.test=${javaclaw.launch.ui.test}</option>
                        <option>--add-modules</option>
                        <option>jdk.incubator.vector,jdk.httpserver</option>
                        <option>--enable-native-access=ALL-UNNAMED</option>
                        <option>--add-exports</option>
                        <option>javafx.base/com.sun.javafx=ALL-UNNAMED</option>
                        <option>--add-exports</option>
                        <option>javafx.graphics/com.sun.javafx.util=ALL-UNNAMED</option>
                        <option>--add-exports</option>
                        <option>javafx.graphics/com.sun.javafx.scene.text=ALL-UNNAMED</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ui-test</id>
            <properties>
                <javaclaw.launch.home>${project.build.directory}/ui-test-home</javaclaw.launch.home>
                <javaclaw.launch.ui.test>true</javaclaw.launch.ui.test>
                <javaclaw.fx.tests>true</javaclaw.fx.tests>
            </properties>
        </profile>
<!--
            Release CI supplies -Dframework.compatibility.baseline=<released-version>.
            Only the supported Framework API/SPI surface is compared; a binary break therefore
            requires intentionally moving to a new Framework API major version/baseline.
        -->
        <profile>
            <id>framework-api-compatibility</id>
            <activation>
                <property>
                    <name>framework.compatibility.baseline</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>0.26.1</version>
                        <configuration>
                            <oldVersion>
                                <dependency>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}</artifactId>
                                    <version>${framework.compatibility.baseline}</version>
                                    <type>jar</type>
                                </dependency>
                            </oldVersion>
                            <newVersion>
                                <file>
                                    <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                </file>
                            </newVersion>
                            <parameter>
                                <onlyModified>true</onlyModified>
                                <accessModifier>public</accessModifier>
                                <includes>
                                    <include>com.javaclaw.framework.api</include>
                                    <include>com.javaclaw.framework.spi</include>
                                </includes>
                                <includeExclusively>false</includeExclusively>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                            </parameter>
                            <skipHtmlReport>true</skipHtmlReport>
                            <skipMarkdownReport>true</skipMarkdownReport>
                        </configuration>
                        <executions>
                            <execution>
                                <id>check-framework-api-spi-compatibility</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
