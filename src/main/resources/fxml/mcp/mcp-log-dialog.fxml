<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.mcp.McpLogDialogController" spacing="8.0">
    <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
    <children>
        <Label fx:id="errorTitle" text="启动错误" styleClass="settings-section-title"/>
        <Label fx:id="errorLabel" wrapText="true" styleClass="settings-hint, status-error"/>
        <Separator fx:id="errorSeparator"/>
        <Label fx:id="tailTitle" styleClass="settings-section-title"/>
        <TextArea fx:id="tailArea" editable="false" wrapText="false"
                  prefRowCount="16" prefColumnCount="80" styleClass="mcp-env-area"/>
    </children>
</VBox>
