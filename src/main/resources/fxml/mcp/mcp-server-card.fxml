<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.mcp.McpServerCardController"
      spacing="8.0" styleClass="mcp-server-card">
    <children>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="stateBadge" styleClass="jc-badge"/>
                <VBox spacing="2.0" minWidth="0.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="nameLabel" maxWidth="Infinity" textOverrun="ELLIPSIS"
                               styleClass="mcp-server-name"/>
                        <Label fx:id="metaLabel" styleClass="mcp-server-meta"/>
                    </children>
                </VBox>
                <Label fx:id="transportLabel" styleClass="mcp-transport-pill"/>
            </children>
        </HBox>
        <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="mcp-summary-row">
            <children>
                <Label fx:id="summaryLabel" wrapText="true" minWidth="0.0" maxWidth="Infinity"
                       HBox.hgrow="ALWAYS" styleClass="mcp-server-summary"/>
                <Button text="复制" onAction="#copyRequested"
                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm, mcp-copy-button">
                    <tooltip><Tooltip text="复制启动命令或 URL"/></tooltip>
                </Button>
            </children>
        </HBox>
        <Label fx:id="valuesLabel" wrapText="true" styleClass="mcp-server-kv"/>
        <HBox fx:id="errorRow" spacing="8.0" alignment="CENTER_LEFT"
              visible="false" managed="false">
            <children>
                <Label fx:id="errorLabel" wrapText="true" minWidth="0.0" maxWidth="Infinity"
                       HBox.hgrow="ALWAYS" styleClass="mcp-error-text"/>
                <Button text="查看日志" onAction="#logRequested"
                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
            </children>
        </HBox>
        <FlowPane fx:id="actionBar" hgap="6.0" vgap="6.0" alignment="CENTER_LEFT"
                  styleClass="mcp-card-actions">
            <children>
                <Button fx:id="startButton" text="启动" onAction="#startRequested"
                        styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                <Button fx:id="restartButton" text="重启" onAction="#restartRequested"
                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                <Button fx:id="stopButton" text="停止" onAction="#stopRequested"
                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                <CheckBox fx:id="enabledCheck" text="启用" onAction="#enabledChanged"
                          styleClass="settings-checkbox"/>
                <Button text="编辑" onAction="#editRequested"
                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                <Button text="删除" onAction="#deleteRequested"
                        styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"/>
            </children>
        </FlowPane>
        <TitledPane fx:id="toolsPane" expanded="false" styleClass="mcp-tools-pane">
            <content>
                <VBox spacing="4.0">
                    <padding><Insets top="8.0" right="10.0" bottom="8.0" left="10.0"/></padding>
                    <children>
                        <Label fx:id="toolsHint" wrapText="true" styleClass="settings-hint"/>
                        <Button fx:id="discoverButton" text="启动以发现工具"
                                onAction="#startRequested"
                                styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                        <VBox fx:id="toolList" spacing="4.0"/>
                    </children>
                </VBox>
            </content>
        </TitledPane>
    </children>
</VBox>
