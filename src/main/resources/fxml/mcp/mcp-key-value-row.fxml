<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.mcp.McpKeyValueRowController"
      spacing="6.0" alignment="CENTER_LEFT" styleClass="mcp-env-row">
    <children>
        <TextField fx:id="keyField" promptText="KEY" prefWidth="145.0" minWidth="110.0"
                   styleClass="settings-field"/>
        <StackPane maxWidth="Infinity" HBox.hgrow="ALWAYS">
            <children>
                <TextField fx:id="plainValueField" promptText="VALUE" maxWidth="Infinity"
                           styleClass="settings-field"/>
                <PasswordField fx:id="secretValueField" promptText="VALUE" maxWidth="Infinity"
                               visible="false" managed="false" styleClass="settings-field"/>
            </children>
        </StackPane>
        <ToggleButton fx:id="secretButton" text="👁" onAction="#secretRequested"
                      styleClass="settings-test-button">
            <tooltip><Tooltip text="切换为密钥/明文"/></tooltip>
        </ToggleButton>
        <Button text="✕" onAction="#removeRequested" styleClass="settings-test-button"/>
    </children>
</HBox>
