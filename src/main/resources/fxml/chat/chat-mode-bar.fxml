<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox fx:id="root" alignment="CENTER_LEFT" spacing="8.0" styleClass="composer-hint-row"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.chat.ChatModeController">
    <padding><Insets top="4.0" right="24.0" bottom="6.0" left="24.0"/></padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <children>
                <ComboBox fx:id="conversationModeSelector" minWidth="104.0"
                          prefWidth="116.0" maxWidth="140.0"
                          accessibleText="会话模式"
                          styleClass="composer-select, conversation-mode-combo"/>
                <ComboBox fx:id="planProfileSelector" prefWidth="112.0"
                          visible="false" managed="false"
                          accessibleText="研讨深度档位"/>
                <MenuButton fx:id="loopTemplateMenu" text="循环模板"
                            visible="false" managed="false"
                            accessibleText="循环任务模板"
                            styleClass="composer-select"/>
                <ComboBox fx:id="workflowSelector" promptText="选择已发布工作流"
                          prefWidth="180.0" visible="false" managed="false"
                          accessibleText="已发布工作流"/>
                <Button fx:id="workflowEmptyShortcut" text="前往工作流中心"
                        visible="false" managed="false"
                        onAction="#openWorkflowCenterRequested"
                        styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                <Button text="托管任务" onAction="#openTaskManagerRequested"
                        styleClass="jc-mode-chip"/>
                <MenuButton fx:id="reviewModeMenu" minWidth="106.0"
                            prefWidth="112.0" maxWidth="126.0"
                            accessibleText="工具审核模式"
                            styleClass="composer-select, review-mode-combo"/>
            </children>
        </HBox>
        <Label text="本次对话" styleClass="composer-hint-label"/>
        <Label text="·" styleClass="composer-hint-sep"/>
        <Label fx:id="tokenLabel" text="今日 0 · 会话 0"
               accessibleText="Token 使用摘要"
               styleClass="token-counter-label">
            <tooltip><Tooltip fx:id="tokenSummaryTooltip"/></tooltip>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="↵" styleClass="kbd-chip"/>
        <Label text="发送" styleClass="composer-hint-label"/>
        <Label text="⇧↵" styleClass="kbd-chip"/>
        <Label text="换行" styleClass="composer-hint-label"/>
        <Label text="Esc" styleClass="kbd-chip"/>
        <Label text="取消" styleClass="composer-hint-label"/>
    </children>
</HBox>
