<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="root" alignment="TOP_LEFT" spacing="10.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.chat.AssistantMessageController">
    <padding><Insets top="6.0" right="12.0" bottom="6.0" left="12.0"/></padding>
    <children>
        <Label text="✦" styleClass="msg-avatar-assistant"/>
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label fx:id="agentNameLabel" styleClass="msg-header-name"/>
                        <Label fx:id="modelBadge" styleClass="msg-header-model"/>
                        <Label fx:id="timeLabel" styleClass="msg-header-time"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="metaLabel" styleClass="msg-header-meta"/>
                    </children>
                </HBox>
                <VBox fx:id="toolResultsBox" spacing="4.0"
                      visible="false" managed="false" styleClass="tool-results-box">
                    <padding><Insets bottom="6.0"/></padding>
                </VBox>
                <VBox fx:id="unifiedBubble" spacing="4.0"
                      styleClass="message-bubble, message-assistant">
                    <padding><Insets top="10.0" right="14.0" bottom="10.0" left="14.0"/></padding>
                    <children>
                        <HBox fx:id="generationPlaceholder" alignment="CENTER_LEFT" spacing="5.0">
                            <children>
                                <Label fx:id="generationDotOne" text="●" styleClass="gen-placeholder-dot"/>
                                <Label fx:id="generationDotTwo" text="●" styleClass="gen-placeholder-dot"/>
                                <Label fx:id="generationDotThree" text="●" styleClass="gen-placeholder-dot"/>
                                <Label text="正在生成回复…" styleClass="gen-placeholder-text"/>
                            </children>
                        </HBox>
                        <StackPane fx:id="replyHost" visible="false" managed="false"/>
                    </children>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="2.0" styleClass="msg-action-row">
                    <children>
                        <Button fx:id="adoptButton" text="✓ 采纳" disable="true"
                                onAction="#adoptRequested" styleClass="msg-action-btn">
                            <tooltip><Tooltip text="标记此回复已采纳并复制正文到剪贴板"/></tooltip>
                        </Button>
                        <Button text="↻ 重新生成" onAction="#regenerateRequested"
                                styleClass="msg-action-btn"/>
                        <Button text="↩ 引用回复" onAction="#quoteRequested"
                                styleClass="msg-action-btn"/>
                        <Button fx:id="moreButton" text="···" onAction="#showMoreMenu"
                                styleClass="msg-action-btn">
                            <tooltip><Tooltip text="更多操作"/></tooltip>
                            <contextMenu>
                                <ContextMenu fx:id="moreMenu">
                                    <items>
                                        <MenuItem text="复制全文" onAction="#copyRequested"/>
                                        <MenuItem text="保存为文件..." onAction="#saveRequested"/>
                                        <SeparatorMenuItem/>
                                        <MenuItem text="删除此消息" onAction="#deleteRequested"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>
