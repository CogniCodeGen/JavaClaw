<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxmisc.richtext.InlineCssTextArea?>

<HBox fx:id="root" alignment="TOP_LEFT" spacing="10.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.chat.ClarificationCardController">
    <padding><Insets top="6.0" right="12.0" bottom="6.0" left="12.0"/></padding>
    <children>
        <Label text="✦" styleClass="msg-avatar-assistant"/>
        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label fx:id="agentNameLabel" styleClass="msg-header-name"/>
                        <Label fx:id="modelBadge" styleClass="msg-header-model"/>
                        <Label fx:id="timeLabel" styleClass="msg-header-time"/>
                    </children>
                </HBox>
                <VBox spacing="8.0" styleClass="clarify-card">
                    <padding><Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/></padding>
                    <children>
                        <Label text="🤔 需要您的澄清" styleClass="clarify-card-title"/>
                        <VBox fx:id="reasonSection" spacing="8.0">
                            <children>
                                <Label text="原因" styleClass="clarify-card-label"/>
                                <InlineCssTextArea fx:id="reasonText" styleClass="bubble-text-area"/>
                            </children>
                        </VBox>
                        <VBox fx:id="questionSection" spacing="8.0">
                            <children>
                                <Label text="问题" styleClass="clarify-card-label"/>
                                <InlineCssTextArea fx:id="questionText" styleClass="bubble-text-area"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
