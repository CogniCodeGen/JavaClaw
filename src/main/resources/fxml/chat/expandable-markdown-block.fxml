<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="2.0" styleClass="expandable-markdown-block"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.chat.ExpandableMarkdownBlockController">
    <padding><Insets top="2.0" bottom="2.0"/></padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="tool-result-header">
            <children>
                <Label fx:id="titleLabel" styleClass="expandable-result-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="collapseButton" text="▼" onAction="#collapseRequested"
                        styleClass="bubble-icon-btn">
                    <tooltip><Tooltip fx:id="collapseTooltip" text="折叠 / 展开此结果"/></tooltip>
                </Button>
                <Button fx:id="copyButton" text="复制" onAction="#copyRequested"
                        styleClass="bubble-icon-btn">
                    <tooltip><Tooltip fx:id="copyTooltip" text="复制此结果文本"/></tooltip>
                </Button>
            </children>
        </HBox>
        <VBox fx:id="contentBox" spacing="4.0" visible="false" managed="false"
              styleClass="message-bubble, message-tool-result">
            <padding><Insets top="6.0" right="10.0" bottom="6.0" left="10.0"/></padding>
            <children>
                <StackPane fx:id="replyHost"/>
            </children>
        </VBox>
    </children>
</VBox>
