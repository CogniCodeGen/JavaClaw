<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" prefWidth="240.0" minWidth="200.0" maxWidth="280.0"
      styleClass="sidebar-root"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.chat.SidebarController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <padding><Insets top="16.0" right="16.0" bottom="12.0" left="16.0"/></padding>
            <children>
                <Label text="✦" styleClass="sb-brand-mark"/>
                <Label text="JavaClaw" styleClass="sb-brand-name"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="v1.0" styleClass="sb-brand-ver"/>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="4.0">
            <padding><Insets top="2.0" right="12.0" bottom="8.0" left="12.0"/></padding>
            <children>
                <ComboBox fx:id="workspaceCombo" maxWidth="1.7976931348623157E308"
                          HBox.hgrow="ALWAYS" styleClass="sidebar-workspace-combo"
                          onAction="#onWorkspaceSelected"/>
                <Button text="+" styleClass="sidebar-ws-btn" onAction="#onCreateWorkspace">
                    <tooltip><Tooltip text="新建工作区"/></tooltip>
                </Button>
                <Button text="-" styleClass="sidebar-ws-btn" onAction="#onDeleteWorkspace">
                    <tooltip><Tooltip text="删除选中的工作区"/></tooltip>
                </Button>
            </children>
        </HBox>

        <VBox>
            <padding><Insets top="4.0" right="12.0" bottom="8.0" left="12.0"/></padding>
            <children>
                <Button text="＋ 新建对话" maxWidth="1.7976931348623157E308"
                        styleClass="sb-new-btn" onAction="#onNewChatRequested">
                    <tooltip><Tooltip text="新建对话（⌘N）"/></tooltip>
                </Button>
            </children>
        </VBox>

        <fx:include fx:id="sessionList" source="sidebar-session-list.fxml" VBox.vgrow="ALWAYS"/>

        <fx:include fx:id="profile" source="sidebar-profile.fxml"/>
    </children>
</VBox>
