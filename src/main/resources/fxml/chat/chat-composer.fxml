<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxmisc.richtext.InlineCssTextArea?>

<VBox fx:id="root" spacing="4.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.chat.ChatComposerController">
    <children>
        <HBox fx:id="typingIndicator" alignment="CENTER_LEFT" spacing="4.0"
              visible="false" managed="false">
            <padding><Insets top="6.0" right="24.0" left="24.0"/></padding>
            <children>
                <Label fx:id="typingDotOne" text="●" styleClass="typing-dot"/>
                <Label fx:id="typingDotTwo" text="●" styleClass="typing-dot"/>
                <Label fx:id="typingDotThree" text="●" styleClass="typing-dot"/>
                <Label fx:id="typingTextLabel" text="助手正在思考中..."
                       styleClass="thinking-label"/>
            </children>
        </HBox>
        <FlowPane fx:id="attachmentPreviewPane" hgap="10.0" vgap="10.0"
                  visible="false" managed="false" styleClass="attachment-preview-pane">
            <padding><Insets top="8.0" right="20.0" bottom="8.0" left="20.0"/></padding>
        </FlowPane>
        <HBox alignment="BOTTOM_CENTER" spacing="12.0" fillHeight="false"
              styleClass="input-bar">
            <padding><Insets top="12.0" right="20.0" bottom="4.0" left="20.0"/></padding>
            <children>
                <Button text="+" onAction="#addAttachmentRequested" styleClass="attach-button">
                    <tooltip><Tooltip text="添加图片或文档附件"/></tooltip>
                </Button>
                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <InlineCssTextArea fx:id="inputField" wrapText="true"
                                           prefHeight="56.0" minHeight="56.0"
                                           maxHeight="240.0" styleClass="input-field"/>
                        <Label fx:id="inputPlaceholder"
                               text="给 JavaClaw 发消息…  按 Enter 发送，Shift+Enter 换行，Esc 取消生成"
                               mouseTransparent="true" StackPane.alignment="TOP_LEFT"
                               styleClass="input-placeholder">
                            <padding><Insets top="14.0" left="21.0"/></padding>
                        </Label>
                    </children>
                </StackPane>
                <Button fx:id="sendButton" text="发送" onAction="#sendOrStopRequested"
                        styleClass="send-button"/>
            </children>
        </HBox>
    </children>
</VBox>
