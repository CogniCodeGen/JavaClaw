<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.memory.MemoryKnowledgeRowController"
      alignment="CENTER_LEFT" styleClass="mc-log-row">
    <children>
        <Label fx:id="name" maxWidth="Infinity" HBox.hgrow="ALWAYS"
               style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: -jc-text-title;"/>
        <Label fx:id="chunks" minWidth="80.0" prefWidth="80.0" styleClass="jc-table-cell-muted"/>
        <Label fx:id="size" minWidth="90.0" prefWidth="90.0" styleClass="jc-table-cell-muted"/>
        <Label fx:id="importedAt" minWidth="140.0" prefWidth="140.0" styleClass="jc-table-cell-muted"/>
        <HBox spacing="3.0" alignment="CENTER_LEFT" minWidth="92.0" prefWidth="92.0"><children>
            <Button text="↻" onAction="#reindexRequested" styleClass="button, mc-icon-btn"><tooltip><Tooltip text="重新嵌入全部分块"/></tooltip></Button>
            <Button text="🗑" onAction="#deleteRequested" styleClass="button, mc-icon-btn, mc-icon-btn-danger"><tooltip><Tooltip text="删除文档"/></tooltip></Button>
        </children></HBox>
    </children>
</HBox>
