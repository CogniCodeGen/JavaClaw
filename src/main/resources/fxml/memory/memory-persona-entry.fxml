<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="com.javaclaw.ui.javafx.memory.MemoryPersonaEntryController"
      spacing="9.0" alignment="CENTER_LEFT">
    <children>
        <Label fx:id="icon"/>
        <Label fx:id="text" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"
               style="-fx-font-size: 12.5px; -fx-text-fill: -jc-text-title;"/>
        <Button text="×" onAction="#removeRequested" styleClass="button, mc-icon-btn"/>
    </children>
</HBox>
