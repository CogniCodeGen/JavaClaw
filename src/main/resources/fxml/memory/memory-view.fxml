<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javaclaw.ui.javafx.memory.MemoryViewController"
           accessibleText="记忆中心">
    <children>
        <HBox fx:id="layout">
            <children>
                <VBox prefWidth="212.0" minWidth="190.0" spacing="2.0" styleClass="modal-left-pane">
                    <padding><Insets top="14.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                    <children>
                        <Label text="记忆库" styleClass="modal-nav-group"/>
                        <Button fx:id="overviewButton" text="总览" maxWidth="Infinity"
                                onAction="#showOverview" styleClass="button, modal-nav-btn"/>
                        <Button fx:id="factsButton" text="事实" maxWidth="Infinity"
                                onAction="#showFacts" styleClass="button, modal-nav-btn"/>
                        <Button fx:id="graphButton" text="🕸 记忆图谱" maxWidth="Infinity"
                                onAction="#showGraph" styleClass="button, modal-nav-btn"/>
                        <Button fx:id="episodesButton" text="情景记忆" maxWidth="Infinity"
                                onAction="#showEpisodes" styleClass="button, modal-nav-btn"/>
                        <Button fx:id="entitiesButton" text="实体" maxWidth="Infinity"
                                onAction="#showEntities" styleClass="button, modal-nav-btn"/>
                        <Button fx:id="knowledgeButton" text="知识库" maxWidth="Infinity"
                                onAction="#showKnowledge" styleClass="button, modal-nav-btn"/>
                        <Button fx:id="personaButton" text="人格" maxWidth="Infinity"
                                onAction="#showPersona" styleClass="button, modal-nav-btn"/>
                        <Button fx:id="correctionsButton" text="🛠 纠错" maxWidth="Infinity"
                                onAction="#showCorrections" styleClass="button, modal-nav-btn"/>
                        <Button fx:id="logButton" text="变更日志" maxWidth="Infinity"
                                onAction="#showLog" styleClass="button, modal-nav-btn"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <VBox spacing="2.0" styleClass="mc-scale-card">
                            <children>
                                <Label text="当前记忆规模" styleClass="mc-scale-cap"/>
                                <Label fx:id="scaleMain" styleClass="mc-scale-main"/>
                                <Label fx:id="scaleSub" styleClass="mc-scale-sub"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" styleClass="mc-header">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="9.0" maxWidth="420.0"
                                      maxHeight="-Infinity" HBox.hgrow="ALWAYS" styleClass="mc-search">
                                    <children>
                                        <Group>
                                            <children>
                                                <Circle centerX="6.9" centerY="6.9" radius="4.4"
                                                        fill="TRANSPARENT" strokeWidth="1.6"
                                                        styleClass="mc-search-icon"/>
                                                <Line startX="10.2" startY="10.2" endX="13.4" endY="13.4"
                                                      strokeWidth="1.6" styleClass="mc-search-icon"/>
                                            </children>
                                        </Group>
                                        <TextField fx:id="searchField" HBox.hgrow="ALWAYS"
                                                   promptText="搜索记忆 — 事实 / 情景 / 实体…"
                                                   styleClass="text-input, text-field, mc-search-field"/>
                                    </children>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="全局检索 · 向量召回" styleClass="mc-header-tag"/>
                            </children>
                        </HBox>
                        <HBox fx:id="degradeBanner" alignment="CENTER_LEFT" spacing="9.0"
                              visible="false" managed="false" styleClass="mc-degrade-banner">
                            <children>
                                <Label text="⚠" styleClass="mc-degrade-icon"/>
                                <Label fx:id="degradeText" wrapText="true" maxWidth="Infinity"
                                       HBox.hgrow="ALWAYS" styleClass="mc-degrade-text"/>
                                <Button fx:id="refillButton" text="立即回填" onAction="#refillPending"
                                        styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <StackPane VBox.vgrow="ALWAYS" styleClass="modal-content-area">
                            <children>
                                <fx:include fx:id="overview" source="memory-overview.fxml"/>
                                <fx:include fx:id="facts" source="memory-facts.fxml"/>
                                <fx:include fx:id="graph" source="memory-graph.fxml"/>
                                <fx:include fx:id="episodes" source="memory-episodes.fxml"/>
                                <fx:include fx:id="entities" source="memory-entities.fxml"/>
                                <fx:include fx:id="knowledge" source="memory-knowledge.fxml"/>
                                <fx:include fx:id="persona" source="memory-persona.fxml"/>
                                <fx:include fx:id="corrections" source="memory-corrections.fxml"/>
                                <fx:include fx:id="log" source="memory-log.fxml"/>
                            </children>
                        </StackPane>
                        <HBox alignment="CENTER_RIGHT" styleClass="modal-foot">
                            <children>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="关闭" onAction="#requestClose"
                                        styleClass="button, jc-btn, jc-btn-ghost"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
        <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                   styleClass="loading-overlay" accessibleText="正在加载记忆">
            <children><ProgressIndicator maxWidth="40.0" maxHeight="40.0"/></children>
        </StackPane>
        <fx:include fx:id="toast" source="../control/window-toast.fxml"/>
    </children>
</StackPane>
