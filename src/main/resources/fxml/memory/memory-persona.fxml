<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.memory.MemoryPersonaController"
            fitToWidth="true" hbarPolicy="NEVER" visible="false" managed="false"
            styleClass="modal-content-area">
    <content>
        <VBox spacing="18.0">
            <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <children>
                <VBox spacing="3.0"><children>
                    <Label text="人格" styleClass="sec-title"/>
                    <Label text="结构化人格每轮注入系统提示词；右侧显示实际注入预览。" styleClass="sec-hint"/>
                </children></VBox>
                <HBox spacing="16.0">
                    <children>
                        <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="9.0" styleClass="jc-card">
                                    <padding><Insets top="15.0" right="16.0" bottom="15.0" left="16.0"/></padding>
                                    <children><Label text="身份" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: -jc-text-title;"/>
                                        <TextArea fx:id="identity" wrapText="true" prefRowCount="3"/></children>
                                </VBox>
                                <VBox spacing="9.0" styleClass="jc-card">
                                    <padding><Insets top="15.0" right="16.0" bottom="15.0" left="16.0"/></padding>
                                    <children><Label text="语气" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: -jc-text-title;"/>
                                        <HBox spacing="8.0"><children>
                                            <Button fx:id="directTone" text="简洁直接" onAction="#selectDirectTone" styleClass="button, mc-tone-chip"/>
                                            <Button fx:id="patientTone" text="耐心细致" onAction="#selectPatientTone" styleClass="button, mc-tone-chip"/>
                                            <Button fx:id="livelyTone" text="活泼鼓励" onAction="#selectLivelyTone" styleClass="button, mc-tone-chip"/>
                                        </children></HBox></children>
                                </VBox>
                                <VBox spacing="9.0" styleClass="jc-card">
                                    <padding><Insets top="15.0" right="16.0" bottom="15.0" left="16.0"/></padding>
                                    <children><Label text="偏好" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: -jc-text-title;"/>
                                        <VBox fx:id="preferences" spacing="7.0"/>
                                        <HBox spacing="8.0"><children>
                                            <TextField fx:id="preferenceInput" promptText="添加一条偏好…" onAction="#addPreference" HBox.hgrow="ALWAYS"/>
                                            <Button text="＋ 添加" onAction="#addPreference" styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                                        </children></HBox></children>
                                </VBox>
                                <VBox spacing="9.0" styleClass="jc-card">
                                    <padding><Insets top="15.0" right="16.0" bottom="15.0" left="16.0"/></padding>
                                    <children><Label text="禁忌" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: -jc-text-title;"/>
                                        <VBox fx:id="taboos" spacing="7.0"/>
                                        <HBox spacing="8.0"><children>
                                            <TextField fx:id="tabooInput" promptText="添加一条禁忌…" onAction="#addTaboo" HBox.hgrow="ALWAYS"/>
                                            <Button text="＋ 添加" onAction="#addTaboo" styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                                        </children></HBox></children>
                                </VBox>
                                <HBox spacing="9.0"><children>
                                    <Button fx:id="saveButton" text="保存人格" onAction="#save" styleClass="button, jc-btn, jc-btn-save, jc-btn-sm"/>
                                    <Button text="导出 Markdown" onAction="#export" styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                </children></HBox>
                            </children>
                        </VBox>
                        <VBox spacing="11.0" prefWidth="360.0" minWidth="300.0" styleClass="mc-persona-preview">
                            <children>
                                <Label text="● 注入预览 · system prompt" styleClass="mc-persona-preview-title"/>
                                <ScrollPane fitToWidth="true" prefViewportHeight="420.0"
                                            style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <content><Label fx:id="preview" wrapText="true" styleClass="mc-persona-preview-text"/></content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
