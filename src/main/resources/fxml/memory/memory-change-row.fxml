<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="com.javaclaw.ui.javafx.memory.MemoryChangeRowController"
      spacing="13.0" alignment="CENTER_LEFT" styleClass="mc-log-row">
    <children>
        <Label fx:id="badge" minWidth="42.0" alignment="CENTER" styleClass="mc-op-badge"/>
        <Label fx:id="type" minWidth="96.0" styleClass="mc-log-type"/>
        <Label fx:id="detail" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="mc-log-detail"/>
        <Label fx:id="time" styleClass="mc-log-time"/>
    </children>
</HBox>
