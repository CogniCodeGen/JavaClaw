<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.onboarding.OnboardingController"
            prefWidth="720.0" prefHeight="520.0"
            styleClass="onboarding-root"
            accessibleText="JavaClaw 首次使用向导">
    <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <padding><Insets bottom="16.0"/></padding>
            <children>
                <Label text="欢迎使用 JavaClaw" styleClass="onboarding-title"/>
                <Label fx:id="stepIndicator" styleClass="onboarding-step-indicator"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink fx:id="skipButton" text="跳过配置"
                           accessibleText="跳过首次配置"
                           onAction="#skipRequested"/>
            </children>
        </HBox>
    </top>
    <center>
        <StackPane>
            <children>
                <VBox fx:id="stepOnePane" spacing="12.0">
                    <children>
                        <Label text="选择你的模型提供商" styleClass="onboarding-step-title"/>
                        <Label text="推荐：中文场景选择通义千问，隐私场景选择 Ollama（本地）"
                               styleClass="onboarding-hint"/>
                        <GridPane fx:id="providerGrid" hgap="12.0" vgap="12.0">
                            <padding><Insets top="16.0"/></padding>
                        </GridPane>
                    </children>
                </VBox>
                <VBox fx:id="stepTwoPane" spacing="12.0" visible="false" managed="false">
                    <children>
                        <Label fx:id="providerTitleLabel" styleClass="onboarding-step-title"/>
                        <Label fx:id="providerHintLabel" wrapText="true"
                               styleClass="onboarding-hint"/>
                        <GridPane hgap="12.0" vgap="10.0">
                            <children>
                                <Label text="Base URL" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="baseUrlField" prefWidth="460.0"
                                           accessibleText="模型服务 Base URL"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="模型名称" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="modelNameField"
                                           accessibleText="模型名称"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="API Key" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="apiKeyField"
                                               accessibleText="模型服务 API Key"
                                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets top="8.0"/></padding>
                            <children>
                                <Button fx:id="testConnectionButton" text="测试连接"
                                        accessibleText="测试模型服务连接"
                                        onAction="#testConnectionRequested"/>
                                <Label fx:id="testConnectionStatus" visible="false" managed="false"
                                       styleClass="onboarding-connection-status"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox fx:id="stepThreePane" spacing="14.0" visible="false" managed="false"
                      alignment="CENTER_LEFT">
                    <children>
                        <Label text="配置完成 ✓" styleClass="onboarding-complete-title"/>
                        <Label fx:id="summaryLabel" styleClass="onboarding-summary"/>
                        <Label wrapText="true" styleClass="onboarding-hint"
                               text="小贴士：&#10;• 随时可在顶部「设置」中修改 API、模型、超时等参数&#10;• 长时任务请使用「创建任务」，支持规划 → 执行 → 验收全流程&#10;• 高风险操作（删文件、发邮件）会弹窗二次确认"/>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding><Insets top="16.0"/></padding>
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="previousButton" text="上一步"
                        accessibleText="返回上一步"
                        onAction="#previousRequested"/>
                <Button fx:id="nextButton" text="下一步"
                        accessibleText="进入下一步"
                        onAction="#nextRequested"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
