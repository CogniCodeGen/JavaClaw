<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="root" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="scroll-pane, settings-scroll-pane"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.settings.GeneralSettingsController">
    <content>
        <VBox spacing="12.0" maxWidth="760.0">
            <padding><Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/></padding>
            <children>
                <Label text="通用设置" styleClass="settings-section-title"/>
                <Label text="界面与后台运行行为" wrapText="true" styleClass="settings-hint"/>
                <Separator/>
                <Label text="外观" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="界面风格：" minWidth="70.0" styleClass="settings-label"/>
                        <ComboBox fx:id="themeCombo" prefWidth="260.0"
                                  accessibleText="界面风格"
                                  onAction="#themeChanged"
                                  styleClass="combo-box, settings-combo"/>
                    </children>
                </HBox>
                <Label text="也可在顶部栏「风格」菜单或「界面风格」分区切换，选择立即生效。"
                       wrapText="true" styleClass="settings-hint"/>
                <Separator/>
                <Label text="后台常驻" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle"
                      onMouseClicked="#minimizeToTrayRowClicked">
                    <children>
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="关闭窗口时最小化到系统托盘" styleClass="rt-main"/>
                                <Label text="保持后台任务与定时任务运行，仅从托盘菜单「退出」才真正关闭；关闭则点窗口关闭按钮即退出"
                                       wrapText="true" styleClass="rt-sub"/>
                            </children>
                        </VBox>
                        <ToggleSwitch fx:id="minimizeToTrayCheck"
                                      accessibleText="关闭窗口时最小化到系统托盘"/>
                    </children>
                </HBox>
                <Separator/>
                <Label text="托管任务 · 风险评估" styleClass="settings-group-title"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle"
                      onMouseClicked="#taskRiskRowClicked">
                    <children>
                        <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="目录内高风险操作自动放行" styleClass="rt-main"/>
                                <Label text="托管任务中由风险评估智能体判定影响范围，只触及任务工作目录内则免人工确认；可能越界或无法确定时仍照常弹确认。仅作用于托管任务"
                                       wrapText="true" styleClass="rt-sub"/>
                            </children>
                        </VBox>
                        <ToggleSwitch fx:id="taskRiskAutoApproveCheck"
                                      accessibleText="目录内高风险操作自动放行"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
