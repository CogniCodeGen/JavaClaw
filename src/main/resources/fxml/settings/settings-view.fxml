<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="settings-root"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.settings.SettingsViewController">
    <children>
        <VBox minWidth="210.0" prefWidth="210.0" maxWidth="210.0"
              styleClass="modal-left-pane">
            <children>
                <Label text="设置" styleClass="modal-left-title">
                    <padding><Insets top="18.0" right="16.0" bottom="12.0" left="16.0"/></padding>
                </Label>
                <fx:include fx:id="navigation" source="settings-navigation.fxml"
                            VBox.vgrow="ALWAYS"/>
            </children>
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="settings-crumb">
                    <children>
                        <Label text="设置" styleClass="settings-crumb-root"/>
                        <Label text="›" styleClass="settings-crumb-sep"/>
                        <Label fx:id="crumbCurrentLabel" text="模型配置"
                               styleClass="settings-crumb-cur"/>
                    </children>
                </HBox>
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"
                           styleClass="settings-content-area">
                    <padding><Insets top="20.0" right="24.0" bottom="16.0" left="24.0"/></padding>
                </StackPane>
                <fx:include fx:id="footer" source="settings-footer.fxml"/>
            </children>
        </VBox>
    </children>
</HBox>
