<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" styleClass="service-plugin-api-console"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javaclaw.ui.javafx.settings.InferenceApiSettingsController">
    <children>
        <VBox fx:id="consoleContent" spacing="9.0">
            <padding><Insets top="2.0" right="2.0" bottom="8.0" left="2.0"/></padding>
            <children>
                <VBox spacing="8.0" styleClass="jc-card, service-plugin-console-toolbar">
                    <padding><Insets top="9.0" right="11.0" bottom="9.0" left="11.0"/></padding>
                    <children>
                        <HBox spacing="7.0" alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="pluginProcessLabel" text="插件已停止"
                                       styleClass="jc-badge, jc-badge-stopped"/>
                                <Button fx:id="processPrimaryButton" text="启动"
                                        onAction="#processPrimaryRequested"
                                        styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                                <Button fx:id="processRestartButton" text="重启"
                                        visible="false" managed="false"
                                        onAction="#processRestartRequested"
                                        styleClass="jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="对外接口" styleClass="service-plugin-toolbar-label"/>
                                <ToggleSwitch fx:id="gatewayEnabledCheck"/>
                                <Button fx:id="serviceLoadModelButton" text="＋ 加载模型"
                                        onAction="#loadModelRequested"
                                        styleClass="jc-btn, jc-btn-primary, jc-btn-sm"/>
                                <Button fx:id="serviceSettingsButton" text="服务设置 ⚙"
                                        onAction="#openServiceSettingsRequested"
                                        styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <HBox spacing="7.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="可访问 URL" minWidth="72.0" styleClass="settings-hint"/>
                                <TextField fx:id="serviceUrlField" editable="false"
                                           promptText="服务未运行" maxWidth="Infinity"
                                           HBox.hgrow="ALWAYS"
                                           styleClass="service-plugin-code, service-plugin-copy-field"/>
                                <Button text="复制" onAction="#copyServiceUrlRequested"
                                        styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <Label fx:id="gatewayStateLabel" text="插件已停止 · 接口未启用"
                               wrapText="true" styleClass="settings-hint"/>
                        <Label fx:id="pluginErrorLabel" visible="false" managed="false"
                               wrapText="true" styleClass="service-plugin-error"/>
                        <Label fx:id="gatewayEndpointLabel" text="API 服务未运行"
                               visible="false" managed="false"/>
                    </children>
                </VBox>

                <SplitPane fx:id="serviceModelSplit" dividerPositions="0.48"
                           minHeight="230.0" prefHeight="270.0" maxHeight="330.0"
                           styleClass="service-plugin-service-split">
                    <items>
                        <VBox spacing="6.0" minWidth="300.0"
                              styleClass="service-plugin-service-models">
                            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
                            <children>
                                <HBox spacing="7.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="已配置模型" styleClass="settings-group-title"/>
                                        <Label text="运行档案 · 紧凑列表" styleClass="settings-hint"/>
                                    </children>
                                </HBox>
                                <ListView fx:id="serviceModelList" VBox.vgrow="ALWAYS"
                                          styleClass="service-plugin-model-list, service-plugin-service-model-list">
                                    <placeholder>
                                        <VBox alignment="CENTER" spacing="8.0">
                                            <children>
                                                <Label text="还没有模型运行配置。请先在“模型”页下载，再从这里加载。"
                                                       textAlignment="CENTER" wrapText="true"
                                                       styleClass="settings-hint"/>
                                                <Button text="选择本地模型" onAction="#loadModelRequested"
                                                        styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                                            </children>
                                        </VBox>
                                    </placeholder>
                                </ListView>
                            </children>
                        </VBox>
                        <VBox spacing="6.0" minWidth="300.0"
                              styleClass="service-plugin-service-detail">
                            <padding><Insets top="9.0" right="10.0" bottom="9.0" left="10.0"/></padding>
                            <children>
                                <HBox spacing="6.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="所选模型" styleClass="settings-group-title"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="editServiceModelButton" text="设置…" disable="true"
                                                onAction="#editServiceModelRequested"
                                                styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                                        <Button fx:id="ejectServiceModelButton" text="加载" disable="true"
                                                onAction="#ejectServiceModelRequested"
                                                styleClass="jc-btn, jc-btn-primary, jc-btn-sm"/>
                                        <Button fx:id="deleteServiceModelButton" text="删除配置" disable="true"
                                                onAction="#deleteServiceModelRequested"
                                                styleClass="jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                    </children>
                                </HBox>
                                <TextArea fx:id="serviceModelDetailsArea" editable="false" wrapText="true"
                                          prefRowCount="4" VBox.vgrow="ALWAYS"
                                          styleClass="service-plugin-code, service-plugin-detail-text"/>
                                <HBox spacing="6.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="API 标识" minWidth="58.0" styleClass="settings-hint"/>
                                        <TextField fx:id="serviceModelIdentifierField" editable="false"
                                                   HBox.hgrow="ALWAYS"
                                                   styleClass="service-plugin-code, service-plugin-copy-field"/>
                                        <Button text="复制" onAction="#copyModelIdentifierRequested"
                                                styleClass="jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                    </children>
                                </HBox>
                                <HBox spacing="6.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="本地路径" minWidth="58.0" styleClass="settings-hint"/>
                                        <TextField fx:id="serviceModelPathField" editable="false"
                                                   HBox.hgrow="ALWAYS"
                                                   styleClass="service-plugin-code, service-plugin-copy-field"/>
                                        <Button text="复制" onAction="#copyModelPathRequested"
                                                styleClass="jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </items>
                </SplitPane>

                <VBox spacing="7.0" styleClass="jc-card, service-plugin-api-usage">
                    <padding><Insets top="9.0" right="10.0" bottom="9.0" left="10.0"/></padding>
                    <children>
                        <HBox spacing="7.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="API 使用" styleClass="settings-group-title"/>
                                <Label fx:id="apiRoutesLabel" text="OpenAI 兼容路由"
                                       maxWidth="Infinity" HBox.hgrow="ALWAYS" wrapText="true"
                                       styleClass="settings-hint"/>
                                <Button text="复制全部" onAction="#copyRoutesRequested"
                                        styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <TextArea fx:id="routesArea" editable="false" prefRowCount="3"
                                  styleClass="service-plugin-code, service-plugin-route-list"/>
                        <HBox spacing="7.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="所选模型 cURL" styleClass="settings-group-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="复制 cURL" onAction="#copyCurlRequested"
                                        styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <TextArea fx:id="curlExampleArea" editable="false" wrapText="false"
                                  prefRowCount="3" styleClass="service-plugin-code"/>
                    </children>
                </VBox>

                <VBox fx:id="logsPanel" spacing="7.0" styleClass="jc-card, service-plugin-log-panel">
                    <padding><Insets top="8.0" right="10.0" bottom="8.0" left="10.0"/></padding>
                    <children>
                        <FlowPane hgap="8.0" vgap="6.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="开发者日志" styleClass="settings-group-title"/>
                                <ComboBox fx:id="logFilterCombo" prefWidth="112.0"/>
                                <Label text="调用日志"/>
                                <ToggleSwitch fx:id="invocationLoggingSwitch"/>
                                <Label fx:id="invocationLoggingSupportLabel"
                                       text="默认关闭，仅记录非敏感元数据" wrapText="true"
                                       styleClass="settings-hint"/>
                                <Button text="刷新" onAction="#refreshLogsRequested"
                                        styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                                <Button fx:id="logsCollapseButton" text="折叠"
                                        onAction="#toggleLogsRequested"
                                        styleClass="jc-btn, jc-btn-ghost, jc-btn-sm"/>
                            </children>
                        </FlowPane>
                        <TextArea fx:id="serviceLogsArea" editable="false" wrapText="false"
                                  prefHeight="180.0" maxHeight="180.0"
                                  styleClass="service-plugin-code, service-plugin-log"/>
                    </children>
                </VBox>
                <Label fx:id="statusLabel" text="模型服务控制台已就绪" wrapText="true"
                       styleClass="settings-hint, service-plugin-operation-status"/>
            </children>
        </VBox>

        <Region fx:id="settingsScrim" visible="false" managed="false"
                onMouseClicked="#closeServiceSettingsRequested"
                styleClass="service-plugin-drawer-scrim"/>
        <VBox fx:id="settingsDrawer" spacing="9.0" visible="false" managed="false"
              prefWidth="430.0" maxWidth="460.0" StackPane.alignment="CENTER_RIGHT"
              styleClass="jc-card, service-plugin-settings-drawer">
            <children>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                        <Label text="服务设置" styleClass="settings-section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="×" onAction="#closeServiceSettingsRequested"
                                styleClass="jc-btn, jc-btn-ghost, jc-btn-sm"/>
                    </children>
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                            styleClass="service-plugin-detail-scroll">
                    <content>
                        <VBox spacing="12.0">
                            <children>
                                <VBox fx:id="runtimeSettingsHost" spacing="8.0"/>
                                <Separator/>
                                <Label text="对外监听与 TLS" styleClass="settings-group-title"/>
                                <FlowPane hgap="8.0" vgap="7.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="监听地址"/>
                                        <TextField fx:id="bindAddressField" text="127.0.0.1" prefWidth="170.0"/>
                                        <Label text="端口"/>
                                        <TextField fx:id="portField" text="18080" prefWidth="80.0"/>
                                        <CheckBox fx:id="tlsEnabledCheck" text="TLS"/>
                                        <CheckBox fx:id="allowInsecureLanCheck" text="允许局域网 HTTP"/>
                                    </children>
                                </FlowPane>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="PKCS#12 证书" styleClass="settings-hint"/>
                                        <HBox spacing="6.0">
                                            <children>
                                                <TextField fx:id="keyStorePathField" HBox.hgrow="ALWAYS"/>
                                                <Button text="选择…" onAction="#chooseKeyStoreRequested"/>
                                            </children>
                                        </HBox>
                                        <PasswordField fx:id="keyStorePasswordField"
                                                       promptText="证书密码（留空则保持）"/>
                                    </children>
                                </VBox>
                                <FlowPane hgap="8.0" vgap="7.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="请求体上限"/>
                                        <TextField fx:id="maxRequestBytesField" text="4194304" prefWidth="120.0"/>
                                        <Label text="超时（秒）"/>
                                        <TextField fx:id="requestTimeoutField" text="120" prefWidth="78.0"/>
                                        <Button text="保存监听设置" onAction="#saveGatewayRequested"
                                                styleClass="jc-btn, jc-btn-primary, jc-btn-sm"/>
                                    </children>
                                </FlowPane>
                                <Separator/>
                                <Label text="公开模型别名" styleClass="settings-group-title"/>
                                <TextField fx:id="aliasField" promptText="稳定模型别名"/>
                                <ComboBox fx:id="publishedProfileCombo" maxWidth="Infinity"/>
                                <FlowPane hgap="8.0" vgap="6.0">
                                    <children>
                                        <Button text="发布" onAction="#publishRequested"/>
                                        <Button text="取消发布所选" onAction="#unpublishRequested"/>
                                    </children>
                                </FlowPane>
                                <ListView fx:id="publishedList" prefHeight="82.0"/>
                                <Separator/>
                                <Label text="API Key 与模型权限" styleClass="settings-group-title"/>
                                <TextField fx:id="keyNameField" promptText="密钥名称"/>
                                <FlowPane hgap="8.0" vgap="7.0">
                                    <children>
                                        <TextField fx:id="keyRpmField" text="60" promptText="RPM" prefWidth="75.0"/>
                                        <TextField fx:id="keyTpmField" text="100000" promptText="TPM" prefWidth="105.0"/>
                                        <TextField fx:id="keyConcurrencyField" text="1" promptText="并发" prefWidth="68.0"/>
                                    </children>
                                </FlowPane>
                                <FlowPane hgap="10.0" vgap="6.0">
                                    <children>
                                        <CheckBox fx:id="modelsReadScope" text="models:read" selected="true"/>
                                        <CheckBox fx:id="chatScope" text="chat:invoke" selected="true"/>
                                        <CheckBox fx:id="embeddingsScope" text="embeddings:invoke" selected="true"/>
                                    </children>
                                </FlowPane>
                                <FlowPane hgap="8.0" vgap="6.0">
                                    <children>
                                        <Button text="创建密钥" onAction="#createKeyRequested"/>
                                        <Button text="撤销所选" onAction="#revokeKeyRequested"
                                                styleClass="settings-reset-button"/>
                                    </children>
                                </FlowPane>
                                <Label text="模型白名单（留空允许全部已发布模型）" styleClass="settings-hint"/>
                                <ListView fx:id="keyAliasList" prefHeight="76.0"/>
                                <TextArea fx:id="createdKeyArea" editable="false" wrapText="true"
                                          prefRowCount="2" promptText="新密钥只显示一次"
                                          styleClass="service-plugin-secret"/>
                                <ListView fx:id="apiKeyList" prefHeight="100.0"/>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button text="完成" onAction="#closeServiceSettingsRequested"
                                styleClass="jc-btn, jc-btn-primary, jc-btn-sm"/>
                    </children>
                </HBox>
            </children>
            <padding><Insets top="14.0" right="14.0" bottom="12.0" left="14.0"/></padding>
        </VBox>
    </children>
</StackPane>
