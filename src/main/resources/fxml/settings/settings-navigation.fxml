<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.settings.SettingsNavigationController">
    <fx:define>
        <ToggleGroup fx:id="categoryGroup"/>
    </fx:define>
    <children>
        <VBox>
            <padding><Insets right="12.0" bottom="8.0" left="12.0"/></padding>
            <children>
                <StackPane>
                    <children>
                        <TextField fx:id="searchField" promptText="搜索设置…"
                                   accessibleText="搜索设置分类"
                                   styleClass="text-input, text-field, settings-search-field"
                                   onKeyPressed="#searchKeyPressed">
                            <padding><Insets top="6.0" right="26.0" bottom="6.0" left="10.0"/></padding>
                        </TextField>
                        <Button fx:id="searchClear" text="✕" focusTraversable="false"
                                visible="false" managed="false" accessibleText="清除搜索"
                                StackPane.alignment="CENTER_RIGHT" styleClass="button, settings-search-clear"
                                onAction="#clearSearch">
                            <StackPane.margin><Insets right="4.0"/></StackPane.margin>
                        </Button>
                    </children>
                </StackPane>
            </children>
        </VBox>
        <Separator/>
        <VBox fx:id="categoryList" spacing="4.0" prefWidth="140.0"
              VBox.vgrow="ALWAYS" styleClass="settings-category-list">
            <padding><Insets top="12.0" right="8.0" bottom="12.0" left="8.0"/></padding>
            <children>
                <Label text="▾  核心配置" userData="CORE" maxWidth="Infinity"
                       contentDisplay="RIGHT" graphicTextGap="6.0"
                       styleClass="label, settings-nav-group, modal-nav-group"
                       onMouseClicked="#groupClicked">
                    <graphic><Region visible="false" managed="false" styleClass="nav-dirty-dot"/></graphic>
                </Label>
                <VBox spacing="2.0" userData="CORE" styleClass="modal-nav-children">
                    <children>
                        <ToggleButton text="模型配置" userData="MODEL" selected="true"
                                      toggleGroup="$categoryGroup" maxWidth="Infinity"
                                      contentDisplay="GRAPHIC_ONLY" accessibleText="模型配置"
                                      styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                            <graphic><HBox spacing="6.0" alignment="CENTER_LEFT">
                                <children>
                                    <Label text="模型配置" styleClass="modal-nav-plain"/>
                                    <Label visible="false" managed="false" styleClass="modal-nav-hl"/>
                                    <Label visible="false" managed="false" styleClass="modal-nav-plain"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                                </children>
                            </HBox></graphic>
                        </ToggleButton>
                        <ToggleButton text="分级模型" userData="TIERED_MODEL"
                                      toggleGroup="$categoryGroup" maxWidth="Infinity"
                                      contentDisplay="GRAPHIC_ONLY" accessibleText="分级模型"
                                      styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                            <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                                <Label text="分级模型" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                            </children></HBox></graphic>
                        </ToggleButton>
                        <ToggleButton text="嵌入模型" userData="EMBEDDING"
                                      toggleGroup="$categoryGroup" maxWidth="Infinity"
                                      contentDisplay="GRAPHIC_ONLY" accessibleText="嵌入模型"
                                      styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                            <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                                <Label text="嵌入模型" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                            </children></HBox></graphic>
                        </ToggleButton>
                        <ToggleButton text="智能体" userData="AGENT"
                                      toggleGroup="$categoryGroup" maxWidth="Infinity"
                                      contentDisplay="GRAPHIC_ONLY" accessibleText="智能体"
                                      styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                            <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                                <Label text="智能体" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                            </children></HBox></graphic>
                        </ToggleButton>
                    </children>
                </VBox>

                <Label text="▸  智能能力" userData="INTELLIGENCE" maxWidth="Infinity"
                       contentDisplay="RIGHT" graphicTextGap="6.0"
                       styleClass="label, settings-nav-group, modal-nav-group"
                       onMouseClicked="#groupClicked">
                    <graphic><Region visible="false" managed="false" styleClass="nav-dirty-dot"/></graphic>
                </Label>
                <VBox spacing="2.0" userData="INTELLIGENCE" visible="false" managed="false"
                      styleClass="modal-nav-children"><children>
                    <ToggleButton text="GEPA 能力" userData="GEPA" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="GEPA 能力"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="GEPA 能力" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                    <ToggleButton text="技能进化" userData="SKILL_EVOLUTION" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="技能进化"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="技能进化" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                </children></VBox>

                <Label text="▸  外部集成" userData="INTEGRATION" maxWidth="Infinity"
                       contentDisplay="RIGHT" graphicTextGap="6.0"
                       styleClass="label, settings-nav-group, modal-nav-group"
                       onMouseClicked="#groupClicked">
                    <graphic><Region visible="false" managed="false" styleClass="nav-dirty-dot"/></graphic>
                </Label>
                <VBox spacing="2.0" userData="INTEGRATION" visible="false" managed="false"
                      styleClass="modal-nav-children"><children>
                    <ToggleButton text="MCP 服务器" userData="MCP" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="MCP 服务器"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="MCP 服务器" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                    <ToggleButton text="站点管理" userData="SITE" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="站点管理"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="站点管理" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                </children></VBox>

                <Label text="▸  外观" userData="APPEARANCE" maxWidth="Infinity"
                       contentDisplay="RIGHT" graphicTextGap="6.0"
                       styleClass="label, settings-nav-group, modal-nav-group"
                       onMouseClicked="#groupClicked">
                    <graphic><Region visible="false" managed="false" styleClass="nav-dirty-dot"/></graphic>
                </Label>
                <VBox spacing="2.0" userData="APPEARANCE" visible="false" managed="false"
                      styleClass="modal-nav-children"><children>
                    <ToggleButton text="界面风格" userData="APPEARANCE" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="界面风格"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="界面风格" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                    <ToggleButton text="字体" userData="FONT" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="字体"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="字体" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                </children></VBox>

                <Label text="▸  通用" userData="GENERAL" maxWidth="Infinity"
                       contentDisplay="RIGHT" graphicTextGap="6.0"
                       styleClass="label, settings-nav-group, modal-nav-group"
                       onMouseClicked="#groupClicked">
                    <graphic><Region visible="false" managed="false" styleClass="nav-dirty-dot"/></graphic>
                </Label>
                <VBox spacing="2.0" userData="GENERAL" visible="false" managed="false"
                      styleClass="modal-nav-children"><children>
                    <ToggleButton text="通用设置" userData="GENERAL" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="通用设置"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="通用设置" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                </children></VBox>

                <Label text="▸  系统维护" userData="MAINTENANCE" maxWidth="Infinity"
                       contentDisplay="RIGHT" graphicTextGap="6.0"
                       styleClass="label, settings-nav-group, modal-nav-group"
                       onMouseClicked="#groupClicked">
                    <graphic><Region visible="false" managed="false" styleClass="nav-dirty-dot"/></graphic>
                </Label>
                <VBox spacing="2.0" userData="MAINTENANCE" visible="false" managed="false"
                      styleClass="modal-nav-children"><children>
                    <ToggleButton text="测试数据清理" userData="TEST_DATA" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="测试数据清理"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="测试数据清理" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                </children></VBox>

                <Label text="▸  通信渠道" userData="COMMUNICATION" maxWidth="Infinity"
                       contentDisplay="RIGHT" graphicTextGap="6.0"
                       styleClass="label, settings-nav-group, modal-nav-group"
                       onMouseClicked="#groupClicked">
                    <graphic><Region visible="false" managed="false" styleClass="nav-dirty-dot"/></graphic>
                </Label>
                <VBox spacing="2.0" userData="COMMUNICATION" visible="false" managed="false"
                      styleClass="modal-nav-children"><children>
                    <ToggleButton text="邮件配置" userData="EMAIL" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="邮件配置"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="邮件配置" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                    <ToggleButton text="通知配置" userData="NOTIFICATION" toggleGroup="$categoryGroup"
                                  maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" accessibleText="通知配置"
                                  styleClass="toggle-button, modal-nav-btn" onAction="#categorySelected">
                        <graphic><HBox spacing="6.0" alignment="CENTER_LEFT"><children>
                            <Label text="通知配置" styleClass="modal-nav-plain"/><Label visible="false" managed="false" styleClass="modal-nav-hl"/><Label visible="false" managed="false" styleClass="modal-nav-plain"/><Region HBox.hgrow="ALWAYS"/><Region visible="false" managed="false" styleClass="nav-dirty-dot"/>
                        </children></HBox></graphic>
                    </ToggleButton>
                </children></VBox>
            </children>
        </VBox>
    </children>
</VBox>
