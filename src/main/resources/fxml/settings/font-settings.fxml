<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.settings.FontCard?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="root" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="scroll-pane, settings-scroll-pane"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.settings.FontSettingsController">
    <fx:define>
        <ToggleGroup fx:id="monospaceGroup"/>
        <ToggleGroup fx:id="densityGroup"/>
    </fx:define>
    <content>
        <VBox spacing="8.0" maxWidth="760.0">
            <padding><Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/></padding>
            <children>
                <Label text="字体" styleClass="sec-title"/>
                <Label text="选择界面与对话使用的字体，立即生效并记忆到本工作区 —— 应用于所有窗口、弹窗与对话气泡。系统原生为默认，仅展示本机或应用包中实际可用的字体。"
                       wrapText="true" styleClass="sec-hint"/>
                <Label text="界面字体" styleClass="grp-title"/>
                <GridPane hgap="12.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0"/>
                        <ColumnConstraints percentWidth="50.0"/>
                    </columnConstraints>
                    <children>
                        <FontCard fx:id="nativeFontCard"
                                  GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <FontCard fx:id="interFontCard"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <FontCard fx:id="notoFontCard"
                                  GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <FontCard fx:id="systemFontCard"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    </children>
                </GridPane>
                <Label text="等宽字体" styleClass="grp-title"/>
                <HBox alignment="CENTER_LEFT" spacing="2.0" styleClass="seg-container">
                    <children>
                        <ToggleButton fx:id="nativeMonoButton" text="系统等宽"
                                      userData="native" toggleGroup="$monospaceGroup"
                                      onAction="#monospaceChanged"
                                      styleClass="toggle-button, seg-btn"/>
                        <ToggleButton fx:id="cascadiaMonoButton" text="Cascadia Code"
                                      userData="cascadia" toggleGroup="$monospaceGroup"
                                      onAction="#monospaceChanged"
                                      styleClass="toggle-button, seg-btn"/>
                        <ToggleButton fx:id="jetbrainsMonoButton" text="JetBrains Mono"
                                      userData="jetbrains" toggleGroup="$monospaceGroup"
                                      onAction="#monospaceChanged"
                                      styleClass="toggle-button, seg-btn"/>
                        <ToggleButton fx:id="sfmonoMonoButton" text="SF Mono"
                                      userData="sfmono" toggleGroup="$monospaceGroup"
                                      onAction="#monospaceChanged"
                                      styleClass="toggle-button, seg-btn"/>
                    </children>
                </HBox>
                <Label text="字号 / 密度" styleClass="grp-title"/>
                <HBox alignment="CENTER_LEFT" spacing="2.0" styleClass="seg-container">
                    <children>
                        <ToggleButton fx:id="compactDensityButton" text="紧凑"
                                      userData="compact" toggleGroup="$densityGroup"
                                      onAction="#densityChanged"
                                      styleClass="toggle-button, seg-btn"/>
                        <ToggleButton fx:id="cozyDensityButton" text="适中"
                                      userData="cozy" toggleGroup="$densityGroup"
                                      onAction="#densityChanged"
                                      styleClass="toggle-button, seg-btn"/>
                        <ToggleButton fx:id="relaxedDensityButton" text="宽松"
                                      userData="relaxed" toggleGroup="$densityGroup"
                                      onAction="#densityChanged"
                                      styleClass="toggle-button, seg-btn"/>
                    </children>
                </HBox>
                <Separator/>
                <Label text="选择后立即应用到全部已打开窗口，并写入本工作区配置（ui.font.*）。等宽字体影响代码块、token 计数与时间戳；密度影响对话正文字号与行高。"
                       wrapText="true" styleClass="sec-hint"/>
            </children>
        </VBox>
    </content>
</ScrollPane>
