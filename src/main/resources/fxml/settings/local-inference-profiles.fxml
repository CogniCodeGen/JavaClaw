<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.settings.InferenceProfileSettingsController">
    <children>
        <VBox fx:id="catalogPanel" spacing="12.0">
            <children>
                <VBox spacing="3.0">
                    <children>
                        <Label fx:id="modelPurposeLabel" text="推理模型"
                               styleClass="settings-section-title"/>
                        <Label text="选择模型即可加载、卸载或调整设置；其他选项按需展开。"
                               wrapText="true" styleClass="settings-hint"/>
                    </children>
                </VBox>
                <VBox fx:id="emptyProfileState" alignment="CENTER" spacing="9.0"
                      minHeight="190.0" visible="false" managed="false"
                      styleClass="service-plugin-empty-state, service-plugin-model-empty-state">
                    <children>
                        <Label text="尚未加载模型" styleClass="service-plugin-empty-title"/>
                        <Label text="添加本地模型或从 Hugging Face 下载后即可加载。"
                               wrapText="true" styleClass="settings-hint"/>
                        <Label text="使用上方“加载模型”或快捷键 ⌘/Ctrl + L。"
                               wrapText="true" styleClass="settings-hint"/>
                    </children>
                </VBox>
                <ListView fx:id="profileList" minHeight="160.0" prefHeight="220.0"
                          maxHeight="320.0" styleClass="service-plugin-model-list"/>
                <HBox spacing="8.0" alignment="CENTER_LEFT"
                      styleClass="service-plugin-form-actions">
                    <children>
                        <Button fx:id="runtimeProfileButton" text="加载"
                                onAction="#runtimeProfileRequested"
                                styleClass="jc-btn, jc-btn-primary, jc-btn-sm"/>
                        <Button fx:id="editProfileButton" text="设置…"
                                onAction="#parametersRequested"
                                styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <MenuButton fx:id="profileActionsMenu" text="更多"
                                    styleClass="jc-btn, jc-btn-ghost, jc-btn-sm">
                            <items>
                                <MenuItem fx:id="deleteProfileItem" text="删除模型配置"
                                          onAction="#deleteProfileRequested"/>
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
                <TitledPane fx:id="workspaceRoutingPane"
                            text="工作区模型路由 · 自动保存" expanded="false"
                            animated="false" styleClass="service-plugin-disclosure">
                    <content>
                        <VBox spacing="10.0">
                            <padding><Insets top="10.0" right="2.0" bottom="4.0" left="2.0"/></padding>
                            <children>
                                <VBox fx:id="generationBindingsBox" spacing="8.0">
                                    <children>
                                        <Label text="为高性能、默认和轻量场景选择已验证模型。"
                                               wrapText="true" styleClass="settings-hint"/>
                                        <GridPane hgap="10.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="82.0"/>
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="180.0"/>
                                            </columnConstraints>
                                            <children>
                                                <Label text="高性能" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                                <ComboBox fx:id="highBindingCombo" maxWidth="Infinity"
                                                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                                <Label text="默认" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                                <ComboBox fx:id="normalBindingCombo" maxWidth="Infinity"
                                                          GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                                <Label text="轻量" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                                <ComboBox fx:id="lightBindingCombo" maxWidth="Infinity"
                                                          GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>
                                <VBox fx:id="embeddingBindingBox" spacing="8.0"
                                      visible="false" managed="false">
                                    <children>
                                        <Label text="选择用于语义检索和文本向量化的模型。"
                                               wrapText="true" styleClass="settings-hint"/>
                                        <ComboBox fx:id="embeddingBindingCombo" maxWidth="Infinity"/>
                                    </children>
                                </VBox>
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="bindingStatusLabel" text="更改后自动保存"
                                               wrapText="true" maxWidth="Infinity"
                                               HBox.hgrow="ALWAYS" styleClass="settings-hint"/>
                                        <Button fx:id="retryBindingsButton" text="重试"
                                                visible="false" managed="false"
                                                onAction="#retryBindingsRequested"
                                                styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
            </children>
        </VBox>

        <VBox fx:id="parametersPanel" spacing="12.0" visible="false" managed="false">
            <children>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="backToModelsFromParametersButton"
                                text="← 返回模型" onAction="#catalogRequested"
                                styleClass="jc-btn, jc-btn-ghost, jc-btn-sm"/>
                        <Label text="加载模型" styleClass="settings-section-title"/>
                    </children>
                </HBox>
                <VBox spacing="4.0" styleClass="service-plugin-model-load-summary">
                    <padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding>
                    <children>
                        <Label fx:id="modelLoadSummaryLabel" text="选择要加载的模型"
                               wrapText="true" styleClass="settings-group-title"/>
                        <Label text="默认使用推荐运行组件和参数；需要时再展开高级设置。"
                               wrapText="true" styleClass="settings-hint"/>
                    </children>
                </VBox>
                <VBox spacing="6.0" styleClass="jc-card, service-plugin-capacity-summary">
                    <padding><Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/></padding>
                    <children>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="本机推荐" styleClass="settings-group-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="恢复本机推荐值" onAction="#restoreRecommendedRequested"
                                        styleClass="jc-btn, jc-btn-soft, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <Label fx:id="recommendedCapacityLabel" text="等待读取本机容量"
                               wrapText="true" styleClass="settings-hint"/>
                        <Label fx:id="memoryWarningLabel" text="" wrapText="true"
                               visible="false" managed="false"/>
                    </children>
                </VBox>
                <GridPane hgap="10.0" vgap="10.0" styleClass="jc-card">
                    <padding><Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/></padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="108.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="220.0"/>
                    </columnConstraints>
                    <children>
                        <Label text="名称" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="profileNameField" maxWidth="Infinity"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="用途" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="profilePurposeLabel" text="推理模型"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="模型" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="profileAssetCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="运行组件" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <ComboBox fx:id="profileRuntimeCombo" onAction="#runtimeForProfileChanged"
                                  maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="上下文（0=自动）" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextField fx:id="contextLengthField" text="0"
                                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <VBox fx:id="embeddingDimensionsBox" spacing="5.0"
                              visible="false" managed="false"
                              GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
                            <children>
                                <Label text="实际向量维度"/>
                                <TextField fx:id="embeddingDimensionsField" editable="false"
                                           promptText="测试后自动填写" maxWidth="Infinity"/>
                            </children>
                        </VBox>
                    </children>
                </GridPane>
                <TitledPane fx:id="profileAdvancedPane" text="高级加载设置"
                            expanded="false" animated="false"
                            styleClass="service-plugin-disclosure">
                    <content>
                        <VBox spacing="12.0">
                            <padding><Insets top="10.0" right="2.0" bottom="4.0" left="2.0"/></padding>
                            <children>
                                <Label text="运行资源与精度" styleClass="settings-group-title"/>
                                <VBox fx:id="loadParametersBox" spacing="8.0"/>
                                <VBox fx:id="generationParametersSection" spacing="8.0">
                                    <children>
                                        <Separator/>
                                        <Label text="默认生成参数" styleClass="settings-group-title"/>
                                        <VBox fx:id="generationParametersBox" spacing="8.0"/>
                                    </children>
                                </VBox>
                                <Label text="可用设置由当前运行组件提供，并随组件能力自动更新。"
                                       wrapText="true" styleClass="settings-hint"/>
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
                <HBox spacing="12.0" alignment="CENTER_LEFT"
                      styleClass="service-plugin-form-actions">
                    <children>
                        <Label text="加载前会进行真实探测和校验。"
                               wrapText="true" maxWidth="Infinity"
                               HBox.hgrow="ALWAYS" styleClass="settings-hint"/>
                        <Button text="取消" onAction="#catalogRequested"
                                styleClass="jc-btn, jc-btn-soft"/>
                        <Button fx:id="parameterSaveProfileButton" text="加载模型"
                                onAction="#saveAndVerifyProfileRequested"
                                styleClass="jc-btn, jc-btn-primary"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label fx:id="statusLabel" text="模型服务已就绪" wrapText="true"
               styleClass="settings-hint"/>
    </children>
</VBox>
