<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="root" fitToWidth="true" hbarPolicy="NEVER"
            styleClass="scroll-pane, settings-scroll-pane"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.settings.ModelSettingsController">
    <fx:define>
        <ToggleGroup fx:id="subTabs"/>
        <ToggleGroup fx:id="httpVersions"/>
    </fx:define>
    <content>
        <VBox spacing="12.0" maxWidth="760.0">
            <padding><Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/></padding>
            <children>
                <Label text="模型配置" styleClass="settings-section-title"/>
                <HBox spacing="0.0" styleClass="settings-sub-tab-bar">
                    <children>
                        <ToggleButton fx:id="basicTab" text="基本配置" selected="true"
                                      toggleGroup="$subTabs"
                                      styleClass="toggle-button, settings-sub-tab, settings-sub-tab-left"
                                      onAction="#basicRequested"/>
                        <ToggleButton fx:id="advancedTab" text="高级配置"
                                      toggleGroup="$subTabs"
                                      styleClass="toggle-button, settings-sub-tab, settings-sub-tab-right"
                                      onAction="#advancedRequested"/>
                    </children>
                </HBox>
                <VBox fx:id="basicPanel" spacing="12.0">
                    <children>
                        <Label text="模型提供商" styleClass="settings-group-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="提供商：" minWidth="70.0" styleClass="settings-label"/>
                                <HBox spacing="2.0" styleClass="seg-container">
                                    <children>
                                        <ToggleButton text="OpenAI" selected="true"
                                                      styleClass="toggle-button, seg-btn"/>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                        <Label text="切换提供商会自动填充推荐的 API 地址和模型名称"
                               styleClass="settings-hint"/>
                        <Separator/>
                        <Label text="API 连接" styleClass="settings-group-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="API 地址：" minWidth="70.0" styleClass="settings-label"/>
                                <TextField fx:id="baseUrlField" promptText="API 地址" prefWidth="350.0"
                                           styleClass="text-input, text-field, settings-field"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="模型名称：" minWidth="70.0" styleClass="settings-label"/>
                                <TextField fx:id="modelNameField" promptText="模型名称" prefWidth="350.0"
                                           styleClass="text-input, text-field, settings-field"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="API 密钥：" minWidth="70.0" styleClass="settings-label"/>
                                <fx:include fx:id="apiKeyField" source="../control/secret-field.fxml"/>
                            </children>
                        </HBox>
                        <Separator/>
                        <Label text="模型参数" styleClass="settings-group-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="row-toggle">
                            <children>
                                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="思考模式" styleClass="rt-main"/>
                                        <Label text="支持的模型生效；OpenAI 兼容端启用会被忽略"
                                               wrapText="true" styleClass="rt-sub"/>
                                    </children>
                                </VBox>
                                <ToggleSwitch fx:id="thinkingEnabledCheck"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="思考预算：" minWidth="70.0" styleClass="settings-label"/>
                                <TextField fx:id="thinkingBudgetField" promptText="token 数" prefWidth="120.0"
                                           styleClass="text-input, text-field, settings-field"/>
                            </children>
                        </HBox>
                        <Separator/>
                        <Label fx:id="storageLabel" styleClass="settings-hint"/>
                        <Label text="修改保存后立即生效，当前对话的智能体服务将重建"
                               styleClass="settings-hint"/>
                        <Button fx:id="resetButton" text="恢复默认"
                                styleClass="button, settings-reset-button"
                                onAction="#resetRequested"/>
                    </children>
                </VBox>
                <VBox fx:id="advancedPanel" spacing="12.0" visible="false" managed="false">
                    <children>
                        <Label text="HTTP 版本" styleClass="settings-group-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <RadioButton fx:id="http11Radio" text="HTTP/1.1" selected="true"
                                             toggleGroup="$httpVersions" styleClass="radio-button, settings-checkbox"/>
                                <RadioButton fx:id="http2Radio" text="HTTP/2"
                                             toggleGroup="$httpVersions" styleClass="radio-button, settings-checkbox"/>
                            </children>
                        </HBox>
                        <Separator/>
                        <Label text="超时配置（秒）" styleClass="settings-group-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="连接：" minWidth="40.0" styleClass="settings-label"/>
                                <TextField fx:id="connectTimeoutField" promptText="连接超时" prefWidth="80.0"
                                           styleClass="text-input, text-field, settings-field"/>
                                <Label text="读取：" minWidth="40.0" styleClass="settings-label"/>
                                <TextField fx:id="readTimeoutField" promptText="读取超时" prefWidth="80.0"
                                           styleClass="text-input, text-field, settings-field"/>
                                <Label text="写入：" minWidth="40.0" styleClass="settings-label"/>
                                <TextField fx:id="writeTimeoutField" promptText="写入超时" prefWidth="80.0"
                                           styleClass="text-input, text-field, settings-field"/>
                            </children>
                        </HBox>
                        <Separator/>
                        <Label text="智能体最大迭代次数" styleClass="settings-group-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="编排：" minWidth="40.0" styleClass="settings-label"/>
                                <TextField fx:id="orchestratorMaxItersField" prefWidth="80.0"
                                           styleClass="text-input, text-field, settings-field"/>
                                <Label text="Web：" minWidth="40.0" styleClass="settings-label"/>
                                <TextField fx:id="webAgentMaxItersField" prefWidth="80.0"
                                           styleClass="text-input, text-field, settings-field"/>
                                <Label text="邮件：" minWidth="40.0" styleClass="settings-label"/>
                                <TextField fx:id="emailAgentMaxItersField" prefWidth="80.0"
                                           styleClass="text-input, text-field, settings-field"/>
                            </children>
                        </HBox>
                        <Separator/>
                        <Label text="循环检测" styleClass="settings-group-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="最大重复：" minWidth="70.0" styleClass="settings-label"/>
                                <TextField fx:id="maxRepeatedCallsField" prefWidth="80.0"
                                           styleClass="text-input, text-field, settings-field"/>
                                <Label text="相似阈值：" minWidth="70.0" styleClass="settings-label"/>
                                <TextField fx:id="loopThresholdField" prefWidth="120.0"
                                           styleClass="text-input, text-field, settings-field"/>
                            </children>
                        </HBox>
                        <Separator/>
                        <Label text="任务评估" styleClass="settings-group-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="通过阈值：" minWidth="70.0" styleClass="settings-label"/>
                                <TextField fx:id="evaluatorThresholdField" prefWidth="80.0"
                                           styleClass="text-input, text-field, settings-field"/>
                                <Label text="最大重试：" minWidth="70.0" styleClass="settings-label"/>
                                <TextField fx:id="evaluatorMaxRetriesField" prefWidth="80.0"
                                           styleClass="text-input, text-field, settings-field"/>
                            </children>
                        </HBox>
                        <Label text="启用评估后建议将编排最大迭代次数调整至 15 以上"
                               styleClass="settings-hint"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
