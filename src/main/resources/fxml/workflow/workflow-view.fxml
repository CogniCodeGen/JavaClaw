<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" accessibleText="工作流中心"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javaclaw.ui.javafx.workflow.WorkflowViewController">
    <children>
        <HBox styleClass="root, workflow-center">
            <children>
                <VBox prefWidth="258.0" styleClass="modal-left-pane, workflow-left">
                    <children>
                        <VBox spacing="3.0" styleClass="workflow-left-head">
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <Label text="⌘" styleClass="workflow-brand-glyph"/>
                                        <Label text="工作流中心" styleClass="modal-left-title"/>
                                    </children>
                                </HBox>
                                <Label text="本地状态图 · 自动保存" styleClass="workflow-left-hint"/>
                            </children>
                        </VBox>
                        <HBox styleClass="workflow-create-row">
                            <children>
                                <Button text="＋ 新建工作流" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                        onAction="#createRequested"
                                        styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <Label text="工作流" styleClass="modal-nav-group"/>
                        <ListView fx:id="workflowList" prefWidth="258.0" VBox.vgrow="ALWAYS"
                                  styleClass="workflow-list" accessibleText="工作流列表"/>
                    </children>
                </VBox>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="workflow-toolbar">
                            <children>
                                <VBox spacing="3.0">
                                    <children>
                                        <HBox spacing="8.0">
                                            <children>
                                                <Label fx:id="titleLabel" text="工作流中心"
                                                       styleClass="workflow-title"/>
                                                <Label fx:id="saveStateLabel"
                                                       styleClass="jc-badge, workflow-save-badge"/>
                                            </children>
                                        </HBox>
                                        <Label fx:id="titleHint" text="选择一个工作流开始编排"
                                               styleClass="workflow-title-hint"/>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="↶" onAction="#undoRequested" accessibleText="撤销"
                                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm, workflow-icon-btn">
                                    <tooltip><Tooltip text="撤销"/></tooltip>
                                </Button>
                                <Button text="↷" onAction="#redoRequested" accessibleText="重做"
                                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm, workflow-icon-btn">
                                    <tooltip><Tooltip text="重做"/></tooltip>
                                </Button>
                                <Button text="⧉ 复制为草稿" onAction="#cloneRequested"
                                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                <MenuButton fx:id="nodePalette" text="＋ 添加节点"
                                            styleClass="menu-button, jc-btn, jc-btn-soft, workflow-add-node">
                                    <items>
                                        <MenuItem text="✦  智能体" onAction="#addAgent"/>
                                        <MenuItem text="⌁  本地工具" onAction="#addTool"/>
                                        <MenuItem text="◇  条件分支" onAction="#addCondition"/>
                                        <MenuItem text="⇄  状态转换" onAction="#addTransform"/>
                                        <MenuItem text="?  人工输入" onAction="#addHumanInput"/>
                                        <MenuItem text="↗  输出" onAction="#addOutput"/>
                                    </items>
                                </MenuButton>
                            </children>
                        </HBox>
                        <HBox VBox.vgrow="ALWAYS">
                            <children>
                                <fx:include fx:id="canvas" source="workflow-canvas.fxml" HBox.hgrow="ALWAYS"/>
                                <fx:include fx:id="inspector" source="workflow-inspector.fxml"/>
                            </children>
                        </HBox>
                        <fx:include fx:id="runtime" source="workflow-runtime.fxml"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="modal-foot">
                            <children>
                                <Label text="⌘/Ctrl + 滚轮缩放 · 右键节点创建连线 · 右键连线删除"
                                       styleClass="workflow-footer-hint"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="校验" onAction="#validateRequested"
                                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                                <Button fx:id="publishButton" text="发布版本" onAction="#publishRequested"
                                        styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                                <Button fx:id="testButton" text="▶ 测试运行" onAction="#testRequested"
                                        styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                                <Button text="关闭" onAction="#closeRequested"
                                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
        <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                   styleClass="loading-overlay" accessibleText="正在处理工作流">
            <children><ProgressIndicator maxWidth="44.0" maxHeight="44.0"/></children>
        </StackPane>
    </children>
</StackPane>
