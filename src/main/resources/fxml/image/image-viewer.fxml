<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.image.ImageViewerController"
            styleClass="image-viewer-root"
            accessibleText="图片查看器"
            onKeyPressed="#keyPressed">
    <center>
        <StackPane fx:id="viewport" minWidth="0.0" minHeight="0.0"
                   styleClass="image-viewer-viewport">
            <children>
                <Pane fx:id="canvas" minWidth="0.0" minHeight="0.0"
                      styleClass="image-viewer-canvas"
                      onScroll="#canvasScrolled"
                      onZoom="#canvasZoomed"
                      onMousePressed="#dragStarted"
                      onMouseDragged="#dragContinued"
                      onMouseReleased="#dragFinished">
                    <children>
                        <Group fx:id="imageGroup">
                            <children>
                                <ImageView fx:id="imageView" preserveRatio="true" smooth="true"/>
                            </children>
                        </Group>
                    </children>
                </Pane>
            </children>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="image-viewer-toolbar">
            <padding><Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/></padding>
            <children>
                <Label fx:id="fileNameLabel" styleClass="image-viewer-name"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="zoomOutButton" text="－" styleClass="button, jc-btn-ghost"
                        accessibleText="缩小图片" onAction="#zoomOutRequested"/>
                <Button fx:id="zoomInButton" text="＋" styleClass="button, jc-btn-ghost"
                        accessibleText="放大图片" onAction="#zoomInRequested"/>
                <Button fx:id="fitButton" text="适应窗口" styleClass="button, jc-btn-ghost"
                        accessibleText="使图片适应窗口" onAction="#fitRequested"/>
                <Button fx:id="closeButton" text="关闭" styleClass="button, jc-btn-ghost"
                        accessibleText="关闭图片查看器" onAction="#closeRequested"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
