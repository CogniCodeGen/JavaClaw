<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="10.0" visible="false" managed="false"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.agent.AgentEditorController">
    <children>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane, agent-settings-scroll"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="14.0">
                    <padding><Insets top="2.0" right="2.0" bottom="2.0" left="2.0"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="agent-section-card">
                            <children>
                                <Label fx:id="headerAvatar" text="🤖" styleClass="agent-header-avatar"/>
                                <VBox alignment="CENTER_LEFT" spacing="4.0" maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label fx:id="headerNameLabel" styleClass="agent-header-name"/>
                                                <Label fx:id="headerBadge" styleClass="agent-header-badge"/>
                                            </children>
                                        </HBox>
                                        <Label fx:id="headerSubLabel" styleClass="agent-header-sub"/>
                                    </children>
                                </VBox>
                                <CheckBox fx:id="enabledCheck" text="启用"
                                          styleClass="check-box, settings-checkbox"/>
                            </children>
                        </HBox>
                        <VBox spacing="12.0" styleClass="agent-section-card">
                            <children>
                                <Label text="基本信息" styleClass="agent-card-title"/>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="名称" styleClass="agent-field-label"/>
                                        <TextField fx:id="nameField" promptText="例如：Java 编程专家"
                                                   maxWidth="Infinity" styleClass="text-input, text-field, settings-field"/>
                                    </children>
                                </VBox>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="工具名" styleClass="agent-field-label"/>
                                        <TextField fx:id="toolNameField" promptText="英文+下划线，如 my_expert"
                                                   maxWidth="Infinity" styleClass="text-input, text-field, settings-field"/>
                                        <Label text="编排器调用此智能体时使用的标识，需保证唯一"
                                               wrapText="true" styleClass="settings-hint"/>
                                    </children>
                                </VBox>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="最大迭代" styleClass="agent-field-label"/>
                                        <Spinner fx:id="maxItersSpinner" editable="true" prefWidth="120.0"
                                                 styleClass="spinner, settings-field"/>
                                        <Label text="智能体每次执行的最大推理轮次"
                                               wrapText="true" styleClass="settings-hint"/>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="agent-section-card">
                            <children>
                                <Label text="智能体描述" styleClass="agent-card-title"/>
                                <Label text="告诉编排器何时调用此智能体，建议简洁概括能力边界"
                                       wrapText="true" styleClass="settings-hint"/>
                                <TextArea fx:id="descriptionArea" prefRowCount="6" wrapText="true"
                                          promptText="例如：处理 Java 项目相关的代码编写、调试、重构、依赖管理任务"
                                          styleClass="text-input, text-area, settings-field"/>
                            </children>
                        </VBox>
                        <VBox spacing="10.0" styleClass="agent-section-card" VBox.vgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <VBox spacing="2.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="系统提示词" styleClass="agent-card-title"/>
                                                <Label text="定义智能体的角色、能力和行为准则"
                                                       wrapText="true" styleClass="settings-hint"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="optimizePromptButton" text="✨ AI 补全"
                                                accessibleText="使用模型补全系统提示词"
                                                styleClass="button, agent-optimize-btn"
                                                onAction="#optimizeRequested">
                                            <tooltip><Tooltip text="根据名称和描述调用模型生成系统提示词"/></tooltip>
                                        </Button>
                                    </children>
                                </HBox>
                                <TextArea fx:id="systemPromptArea" prefRowCount="12" wrapText="true"
                                          styleClass="text-input, text-area, skill-content-editor"
                                          VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>
                        <VBox spacing="10.0" styleClass="agent-section-card">
                            <children>
                                <Label text="Agent 能力" styleClass="agent-card-title"/>
                                <Label text="能力面板由已安装扩展的 JSON Schema 自动生成；保存后发布为新版本，仅影响新 Run。"
                                       wrapText="true" styleClass="settings-hint"/>
                                <VBox fx:id="capabilityFormsBox" spacing="10.0"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="agent-action-bar">
            <children>
                <Label fx:id="statusLabel" visible="false" managed="false"
                       styleClass="settings-hint"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="deleteButton" text="删除" styleClass="button, skill-delete-btn"
                        onAction="#deleteRequested"/>
                <Button fx:id="saveButton" text="保存" styleClass="button, settings-save-button"
                        onAction="#saveRequested"/>
            </children>
        </HBox>
    </children>
</VBox>
