<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" visible="false" managed="false" styleClass="sdd-create-panel"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.task.SddTaskCreateController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                    styleClass="settings-scroll-pane, sdd-detail-scroll">
            <content>
                <VBox spacing="10.0" styleClass="sdd-create-form">
                    <padding><Insets top="22.0" right="28.0" bottom="22.0" left="28.0"/></padding>
                    <children>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children><Label text="✦" styleClass="sdd-create-glyph"/><Label text="新建托管任务" styleClass="sdd-create-title"/></children>
                        </HBox>
                        <Label wrapText="true" text="描述目标即可。托管任务以 OpenSpec 流程推进：提案 → 规格 → 设计 → 任务拆解 → 实现 → 验收。" styleClass="sec-hint"/>
                        <Label text="需求描述 *" styleClass="task-dialog-field-label"/>
                        <TextArea fx:id="descriptionField" prefRowCount="5" wrapText="true"
                                  promptText="例如：为执行轨迹导出增加 CSV 格式。"
                                  styleClass="task-dialog-textarea"/>
                        <Label text="标题" styleClass="task-dialog-field-label"/>
                        <TextField fx:id="titleField" promptText="留空将由需求自动生成标题" styleClass="task-dialog-field"/>
                        <Label text="工作目录" styleClass="task-dialog-field-label"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="directoryField" HBox.hgrow="ALWAYS" promptText="留空默认在项目 task/ 下新建" styleClass="task-dialog-field"/>
                                <Button text="选择…" onAction="#chooseDirectory" styleClass="button, task-dialog-browse-btn"/>
                            </children>
                        </HBox>
                        <HBox spacing="16.0">
                            <children>
                                <VBox spacing="6.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Token 预算" styleClass="task-dialog-field-label"/>
                                        <ComboBox fx:id="budgetBox" maxWidth="Infinity" styleClass="settings-combo"/>
                                        <TextField fx:id="customBudgetField" promptText="自定义预算；0 表示不限" styleClass="task-dialog-field"/>
                                    </children>
                                </VBox>
                                <VBox spacing="6.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="能力工具集" styleClass="task-dialog-field-label"/>
                                        <ComboBox fx:id="capabilityBox" maxWidth="Infinity" styleClass="settings-combo"/>
                                        <TextField fx:id="customCapabilityField" promptText="逗号分隔，如 system,command,web" styleClass="task-dialog-field"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Label text="完成通知渠道" styleClass="task-dialog-field-label"/>
                        <ComboBox fx:id="notificationBox" maxWidth="Infinity" styleClass="settings-combo"/>
                        <Label fx:id="errorLabel" visible="false" managed="false" wrapText="true" styleClass="field-error"/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <padding><Insets top="8.0"/></padding>
                            <children>
                                <Button fx:id="submitButton" text="创建并开始" onAction="#submitRequested" styleClass="button, jc-btn, jc-btn-primary"/>
                                <Button text="取消" onAction="#cancelRequested" styleClass="button, jc-btn, jc-btn-ghost"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
