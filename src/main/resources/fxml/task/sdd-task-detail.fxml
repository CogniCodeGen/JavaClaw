<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.ArcType?>
<?import javafx.scene.shape.Circle?>

<VBox fx:id="root" visible="false" managed="false"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.task.SddTaskDetailController">
    <children>
        <VBox styleClass="sdd-head-zone">
            <children>
                <HBox spacing="14.0" alignment="TOP_LEFT">
                    <children>
                        <StackPane minWidth="76.0" minHeight="76.0" maxWidth="76.0" maxHeight="76.0">
                            <children>
                                <Pane minWidth="76.0" minHeight="76.0" maxWidth="76.0" maxHeight="76.0">
                                    <children>
                                        <Circle centerX="38.0" centerY="38.0" radius="34.5"
                                                strokeWidth="7.0" styleClass="sdd-donut-track"/>
                                        <Arc fx:id="donutArc" centerX="38.0" centerY="38.0"
                                             radiusX="34.5" radiusY="34.5" startAngle="90.0"
                                             length="0.0" type="OPEN" strokeWidth="7.0"
                                             styleClass="sdd-donut-arc"/>
                                    </children>
                                </Pane>
                                <VBox spacing="-2.0" alignment="CENTER">
                                    <children>
                                        <Label fx:id="donutPercent" text="0" styleClass="sdd-donut-pct"/>
                                        <Label text="\%" styleClass="sdd-donut-sign"/>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="titleLabel" maxWidth="Infinity" wrapText="true"
                                               HBox.hgrow="ALWAYS" styleClass="sdd-header-title"/>
                                        <Label fx:id="stateBadge" styleClass="jc-badge"/>
                                    </children>
                                </HBox>
                                <Label fx:id="descriptionLabel" wrapText="true" styleClass="sdd-header-desc"/>
                                <HBox spacing="8.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="sdd-stat-tile">
                                            <children><Label text="阶段" styleClass="sdd-stat-label"/><Label fx:id="stageValue" styleClass="sdd-stat-value"/></children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="sdd-stat-tile">
                                            <children><Label text="实现清单" styleClass="sdd-stat-label"/><Label fx:id="checklistValue" styleClass="sdd-stat-value"/></children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="sdd-stat-tile">
                                            <children>
                                                <Label text="Token" styleClass="sdd-stat-label"/>
                                                <Label fx:id="tokenValue" styleClass="sdd-stat-value"/>
                                                <ProgressBar fx:id="tokenBar" maxWidth="Infinity" styleClass="sdd-stat-bar"/>
                                                <Label fx:id="tokenHint" styleClass="sdd-stat-hint"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="sdd-stat-tile">
                                            <children>
                                                <Label text="耗时" styleClass="sdd-stat-label"/>
                                                <Label fx:id="elapsedValue" styleClass="sdd-stat-value"/>
                                                <Label fx:id="elapsedHint" styleClass="sdd-stat-hint"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="TOP_LEFT" styleClass="sdd-pipeline">
                    <VBox alignment="TOP_CENTER" spacing="6.0" minWidth="48.0"><children><Label fx:id="pipeDot0" text="1" styleClass="sdd-pipe-dot, sdd-pipe-dot-pending"/><Label fx:id="pipeName0" text="提案" styleClass="sdd-pipe-name, sdd-pipe-name-pending"/></children></VBox>
                    <Region fx:id="pipeLine0" translateY="12.0" HBox.hgrow="ALWAYS" styleClass="sdd-pipe-line"/>
                    <VBox alignment="TOP_CENTER" spacing="6.0" minWidth="48.0"><children><Label fx:id="pipeDot1" text="2" styleClass="sdd-pipe-dot, sdd-pipe-dot-pending"/><Label fx:id="pipeName1" text="规格" styleClass="sdd-pipe-name, sdd-pipe-name-pending"/></children></VBox>
                    <Region fx:id="pipeLine1" translateY="12.0" HBox.hgrow="ALWAYS" styleClass="sdd-pipe-line"/>
                    <VBox alignment="TOP_CENTER" spacing="6.0" minWidth="48.0"><children><Label fx:id="pipeDot2" text="3" styleClass="sdd-pipe-dot, sdd-pipe-dot-pending"/><Label fx:id="pipeName2" text="设计" styleClass="sdd-pipe-name, sdd-pipe-name-pending"/></children></VBox>
                    <Region fx:id="pipeLine2" translateY="12.0" HBox.hgrow="ALWAYS" styleClass="sdd-pipe-line"/>
                    <VBox alignment="TOP_CENTER" spacing="6.0" minWidth="48.0"><children><Label fx:id="pipeDot3" text="4" styleClass="sdd-pipe-dot, sdd-pipe-dot-pending"/><Label fx:id="pipeName3" text="拆解" styleClass="sdd-pipe-name, sdd-pipe-name-pending"/></children></VBox>
                    <Region fx:id="pipeLine3" translateY="12.0" HBox.hgrow="ALWAYS" styleClass="sdd-pipe-line"/>
                    <VBox alignment="TOP_CENTER" spacing="6.0" minWidth="48.0"><children><Label fx:id="pipeDot4" text="5" styleClass="sdd-pipe-dot, sdd-pipe-dot-pending"/><Label fx:id="pipeName4" text="实现" styleClass="sdd-pipe-name, sdd-pipe-name-pending"/></children></VBox>
                    <Region fx:id="pipeLine4" translateY="12.0" HBox.hgrow="ALWAYS" styleClass="sdd-pipe-line"/>
                    <VBox alignment="TOP_CENTER" spacing="6.0" minWidth="48.0"><children><Label fx:id="pipeDot5" text="6" styleClass="sdd-pipe-dot, sdd-pipe-dot-pending"/><Label fx:id="pipeName5" text="验收" styleClass="sdd-pipe-name, sdd-pipe-name-pending"/></children></VBox>
                    <VBox.margin><Insets top="16.0" bottom="12.0"/></VBox.margin>
                </HBox>
                <HBox spacing="2.0" styleClass="sdd-tab-bar">
                    <children>
                        <Button fx:id="overviewTab" text="概览" onAction="#showOverview" styleClass="button, sdd-tab"/>
                        <Button fx:id="acceptanceTab" text="验收场景" onAction="#showAcceptance" styleClass="button, sdd-tab"/>
                        <Button fx:id="checklistTab" text="实现清单" onAction="#showChecklist" styleClass="button, sdd-tab"/>
                        <Button fx:id="logTab" text="实时日志" onAction="#showLog" styleClass="button, sdd-tab"/>
                    </children>
                </HBox>
            </children>
        </VBox>
        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <VBox fx:id="overviewPane" styleClass="sdd-tab-pane">
                    <children>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="settings-scroll-pane, sdd-detail-scroll">
                            <content>
                                <VBox spacing="14.0">
                                    <padding><Insets top="12.0" right="18.0" bottom="16.0" left="18.0"/></padding>
                                    <children>
                                        <VBox fx:id="resultCard" visible="false" managed="false" spacing="4.0" styleClass="sdd-result-card">
                                            <children><Label fx:id="resultTitle" styleClass="sdd-result-title"/><Label fx:id="resultContent" wrapText="true" styleClass="sdd-result-content"/></children>
                                        </VBox>
                                        <Label fx:id="overviewEmpty" text="（尚无任务规格：任务未开始或尚未生成 OpenSpec 文档）" wrapText="true" styleClass="sdd-muted-text"/>
                                        <VBox fx:id="proposalPanel" visible="false" managed="false" spacing="14.0">
                                            <children>
                                                <VBox spacing="8.0" styleClass="sdd-why-card"><children><Label text="为什么做（why）" styleClass="sdd-section-title"/><Label fx:id="whyLabel" wrapText="true" styleClass="sdd-body-text"/></children></VBox>
                                                <VBox spacing="8.0"><children><Label text="变更内容（whatChanges）" styleClass="sdd-section-title"/><ListView fx:id="changesList" prefHeight="170.0" styleClass="sdd-change-list"/></children></VBox>
                                                <VBox fx:id="outOfScopeCard" visible="false" managed="false" spacing="8.0" styleClass="sdd-why-card"><children><Label text="不做（outOfScope）" styleClass="sdd-section-title"/><Label fx:id="outOfScopeLabel" wrapText="true" styleClass="sdd-body-text"/></children></VBox>
                                                <Label fx:id="truthPathLabel" styleClass="sdd-truth-path"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
                <VBox fx:id="acceptancePane" visible="false" managed="false" styleClass="sdd-tab-pane">
                    <children>
                        <Label fx:id="acceptanceEmpty" text="（尚未生成验收场景）" styleClass="sdd-muted-text"/>
                        <ListView fx:id="scenarioList" visible="false" managed="false" VBox.vgrow="ALWAYS" styleClass="sdd-scenario-list"/>
                    </children>
                </VBox>
                <VBox fx:id="checklistPane" visible="false" managed="false" spacing="10.0" styleClass="sdd-tab-pane">
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children><Label text="tasks.md" styleClass="sdd-checklist-md"/><ProgressBar fx:id="checklistProgress" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="sdd-checklist-bar"/><Label fx:id="checklistCounter" styleClass="sdd-checklist-counter"/></children>
                        </HBox>
                        <Label fx:id="checklistEmpty" text="（尚未拆解任务）" styleClass="sdd-muted-text"/>
                        <ListView fx:id="checklistList" visible="false" managed="false" VBox.vgrow="ALWAYS" styleClass="sdd-checklist-list"/>
                    </children>
                </VBox>
                <VBox fx:id="logPane" visible="false" managed="false" styleClass="sdd-tab-pane, sdd-log-timeline">
                    <children><ListView fx:id="logList" VBox.vgrow="ALWAYS" styleClass="sdd-log-list"/></children>
                </VBox>
            </children>
        </StackPane>
    </children>
</VBox>
