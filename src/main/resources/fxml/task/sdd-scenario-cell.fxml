<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" styleClass="sdd-scenario-card"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="sdd-scenario-head">
            <children>
                <Label fx:id="capabilityLabel" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="sdd-scenario-cap"/>
                <Label fx:id="verdictLabel" styleClass="jc-badge, sdd-card-badge"/>
            </children>
        </HBox>
        <VBox spacing="8.0" styleClass="sdd-scenario-body">
            <children>
                <HBox spacing="10.0" alignment="TOP_LEFT"><children><Label text="Given" styleClass="sdd-gwt-key, sdd-gwt-key-given"/><Label fx:id="givenLabel" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="sdd-gwt-value"/></children></HBox>
                <HBox spacing="10.0" alignment="TOP_LEFT"><children><Label text="When" styleClass="sdd-gwt-key, sdd-gwt-key-when"/><Label fx:id="whenLabel" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="sdd-gwt-value"/></children></HBox>
                <HBox spacing="10.0" alignment="TOP_LEFT"><children><Label text="Then" styleClass="sdd-gwt-key, sdd-gwt-key-then"/><Label fx:id="thenLabel" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="sdd-gwt-value"/></children></HBox>
            </children>
        </VBox>
    </children>
</VBox>
