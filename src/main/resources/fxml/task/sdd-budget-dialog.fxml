<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" styleClass="task-dialog-root"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.task.SddBudgetDialogController">
    <padding><Insets top="20.0" right="22.0" bottom="18.0" left="22.0"/></padding>
    <children>
        <Label text="修改 Token 预算" styleClass="task-dialog-title"/>
        <Label fx:id="usageLabel" wrapText="true" styleClass="task-dialog-hint"/>
        <Label text="Token 预算 *" styleClass="task-dialog-field-label"/>
        <TextField fx:id="budgetField" styleClass="task-dialog-field"/>
        <Label fx:id="errorLabel" visible="false" managed="false" styleClass="field-error"/>
        <HBox spacing="8.0" alignment="CENTER_RIGHT">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="取消" onAction="#cancelRequested" styleClass="button, task-dialog-ghost-btn"/>
                <Button text="保存" onAction="#saveRequested" styleClass="button, task-dialog-primary-btn"/>
            </children>
        </HBox>
    </children>
</VBox>
