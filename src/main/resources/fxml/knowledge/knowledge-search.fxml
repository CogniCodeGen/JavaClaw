<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" visible="false" managed="false"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.knowledge.KnowledgeSearchController">
    <children>
        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="18.0" maxWidth="820.0" alignment="TOP_CENTER">
                    <padding><Insets top="32.0" right="30.0" bottom="28.0" left="30.0"/></padding>
                    <children>
                        <VBox spacing="4.0" maxWidth="Infinity">
                            <children>
                                <Label text="检索测试" styleClass="kc-pane-title"/>
                                <Label text="直接验证向量召回结果，不会写入会话或触发智能体。"
                                       wrapText="true" styleClass="kc-pane-sub"/>
                            </children>
                        </VBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" maxWidth="Infinity">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="9.0" HBox.hgrow="ALWAYS"
                                      styleClass="kc-search-box">
                                    <children>
                                        <Label text="⌕" styleClass="kc-emb-tag"/>
                                        <TextField fx:id="queryField" HBox.hgrow="ALWAYS"
                                                   promptText="输入要检索的问题或关键词"
                                                   onAction="#searchRequested"
                                                   styleClass="kc-field-input, kc-search-input"/>
                                    </children>
                                </HBox>
                                <Button fx:id="searchButton" text="检索" onAction="#searchRequested"
                                        styleClass="button, jc-btn, jc-btn-primary, kc-search-btn"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0" maxWidth="Infinity">
                            <children>
                                <Label text="当前模型" styleClass="kc-search-meta"/>
                                <Label fx:id="modelLabel" text="—" styleClass="kc-search-meta-accent"/>
                                <Label text="·" styleClass="kc-search-meta"/>
                                <Label fx:id="documentCountLabel" text="0 个文档参与检索"
                                       styleClass="kc-search-meta"/>
                                <Region HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                        <Label fx:id="summaryLabel" maxWidth="Infinity" wrapText="true"
                               styleClass="kc-result-summary"/>
                        <ListView fx:id="resultList" VBox.vgrow="ALWAYS" maxWidth="Infinity"
                                  styleClass="kc-doc-list" accessibleText="检索命中片段"/>
                    </children>
                </VBox>
                <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                           styleClass="loading-overlay" accessibleText="正在检索知识库">
                    <children><ProgressIndicator maxWidth="40.0" maxHeight="40.0"/></children>
                </StackPane>
            </children>
        </StackPane>
    </children>
</VBox>
