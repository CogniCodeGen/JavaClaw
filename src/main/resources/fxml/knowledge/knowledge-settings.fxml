<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" visible="false" managed="false"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.knowledge.KnowledgeSettingsController">
    <children>
        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="kc-scroll">
                    <content>
                        <VBox alignment="TOP_CENTER">
                            <children>
                                <VBox spacing="22.0" maxWidth="760.0" styleClass="kc-centered-col">
                                    <padding><Insets top="32.0" right="30.0" bottom="32.0" left="30.0"/></padding>
                                    <children>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label text="索引设置" styleClass="kc-pane-title"/>
                                                <Label wrapText="true"
                                                       text="控制文档如何被切分并建立向量索引。嵌入模型在设置中统一配置。"
                                                       styleClass="kc-pane-sub"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="14.0" styleClass="kc-emb-card">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label text="🧬" styleClass="kc-emb-card-icon"/>
                                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="7.0">
                                                                    <children>
                                                                        <Label text="嵌入模型" styleClass="kc-emb-card-title"/>
                                                                        <Region fx:id="healthDot"
                                                                                styleClass="kc-health-dot, kc-health-checking"/>
                                                                        <Label fx:id="healthLabel" text="检查中"
                                                                               styleClass="kc-emb-connected, kc-health-checking"/>
                                                                    </children>
                                                                </HBox>
                                                                <Label fx:id="modelLabel" text="未配置"
                                                                       styleClass="kc-emb-card-model"/>
                                                                <Label fx:id="providerLabel" text="—"
                                                                       maxWidth="520.0" textOverrun="ELLIPSIS"
                                                                       styleClass="kc-emb-card-provider"/>
                                                            </children>
                                                        </VBox>
                                                        <Button text="前往模型设置 →" onAction="#modelSettingsRequested"
                                                                styleClass="button, jc-btn, jc-btn-soft, kc-emb-go"/>
                                                    </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="20.0"
                                                      styleClass="kc-emb-card-bottom">
                                                    <children>
                                                        <VBox spacing="2.0">
                                                            <children>
                                                                <Label text="向量维度" styleClass="kc-meta-label"/>
                                                                <Label fx:id="dimensionsLabel" text="0"
                                                                       styleClass="kc-mini-stat-mono"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="2.0">
                                                            <children>
                                                                <Label text="距离度量" styleClass="kc-meta-label"/>
                                                                <Label text="COSINE" styleClass="kc-mini-stat"/>
                                                            </children>
                                                        </VBox>
                                                        <Label text="切换模型后需要重建索引" wrapText="true"
                                                               HBox.hgrow="ALWAYS" styleClass="kc-emb-note"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <VBox spacing="22.0" styleClass="kc-param-card">
                                            <children>
                                                <VBox spacing="10.0">
                                                    <children>
                                                        <HBox alignment="BASELINE_LEFT" spacing="8.0">
                                                            <children>
                                                                <Label text="分块大小" styleClass="kc-param-title"/>
                                                                <Label text="每个片段的最大字符数" HBox.hgrow="ALWAYS"
                                                                       styleClass="kc-param-sub"/>
                                                                <Label fx:id="chunkValueLabel" text="512 字符"
                                                                       styleClass="kc-param-value"/>
                                                            </children>
                                                        </HBox>
                                                        <Slider fx:id="chunkSlider" min="128.0" max="1024.0"
                                                                blockIncrement="64.0" majorTickUnit="64.0"
                                                                snapToTicks="true"
                                                                onMouseReleased="#chunkSettingsReleased"/>
                                                        <HBox styleClass="kc-slider-scale">
                                                            <children>
                                                                <Label text="128"/>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Label text="推荐 512"/>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Label text="1024"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <Region styleClass="kc-param-divider"/>
                                                <VBox spacing="10.0">
                                                    <children>
                                                        <HBox alignment="BASELINE_LEFT" spacing="8.0">
                                                            <children>
                                                                <Label text="片段重叠" styleClass="kc-param-title"/>
                                                                <Label text="保持相邻片段的上下文连续" HBox.hgrow="ALWAYS"
                                                                       styleClass="kc-param-sub"/>
                                                                <Label fx:id="overlapValueLabel" text="64 字符 · 12%"
                                                                       styleClass="kc-param-value"/>
                                                            </children>
                                                        </HBox>
                                                        <Slider fx:id="overlapSlider" min="0.0" max="256.0"
                                                                blockIncrement="8.0" majorTickUnit="8.0"
                                                                snapToTicks="true"
                                                                onMouseReleased="#chunkSettingsReleased"/>
                                                        <HBox styleClass="kc-slider-scale">
                                                            <children>
                                                                <Label text="0"/>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Label text="推荐 10%~20%"/>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Label text="256"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="kc-param-foot">
                                                    <children>
                                                        <Label wrapText="true" HBox.hgrow="ALWAYS"
                                                               text="修改参数仅对新导入文档生效；已有文档需重建索引。"
                                                               styleClass="kc-param-foot-text"/>
                                                        <Button fx:id="rebuildButton" text="重建索引"
                                                                onAction="#rebuildRequested"
                                                                styleClass="button, jc-btn, jc-btn-soft"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kc-danger-zone">
                                            <children>
                                                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="清空知识库" styleClass="kc-danger-title"/>
                                                        <Label wrapText="true"
                                                               text="删除全局与当前工作区的全部文档和向量片段，操作不可撤销。"
                                                               styleClass="kc-danger-desc"/>
                                                    </children>
                                                </VBox>
                                                <Button fx:id="clearButton" text="清空全部" onAction="#clearRequested"
                                                        styleClass="button, jc-btn, jc-btn-danger-soft"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
                <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                           styleClass="loading-overlay" accessibleText="正在更新知识库索引设置">
                    <children><ProgressIndicator maxWidth="40.0" maxHeight="40.0"/></children>
                </StackPane>
            </children>
        </StackPane>
    </children>
</VBox>
