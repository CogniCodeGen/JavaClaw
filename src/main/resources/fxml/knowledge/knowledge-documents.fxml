<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.knowledge.KnowledgeDocumentsController">
    <children>
        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <HBox>
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="kc-toolbar">
                                    <children>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label fx:id="titleLabel" text="全部文档" styleClass="kc-pane-title"/>
                                                <Label fx:id="subtitleLabel" text="共 0 个文档" styleClass="kc-pane-sub"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <HBox alignment="CENTER_LEFT" spacing="7.0" styleClass="kc-filter-box">
                                            <children>
                                                <Label text="⌕" styleClass="kc-emb-tag"/>
                                                <TextField fx:id="filterField" prefWidth="220.0"
                                                           promptText="筛选文档…" styleClass="kc-field-input"/>
                                            </children>
                                        </HBox>
                                        <Button fx:id="importButton" text="＋ 导入" onAction="#importMenuRequested"
                                                styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"/>
                                    </children>
                                </HBox>
                                <VBox fx:id="importPopover" spacing="10.0" styleClass="kc-import-popover">
                                    <VBox.margin><Insets left="24.0" right="24.0" bottom="12.0"/></VBox.margin>
                                    <children>
                                        <Label text="导入到当前范围" styleClass="kc-import-title"/>
                                        <HBox spacing="10.0">
                                            <children>
                                                <Button text="▣ 选择文件&#10;PDF / TXT / Markdown"
                                                        onAction="#importFilesRequested" maxWidth="Infinity"
                                                        HBox.hgrow="ALWAYS" wrapText="true"
                                                        styleClass="button, kc-import-card"/>
                                                <Button text="▤ 导入目录&#10;扫描支持的文档"
                                                        onAction="#importDirectoryRequested" maxWidth="Infinity"
                                                        HBox.hgrow="ALWAYS" wrapText="true"
                                                        styleClass="button, kc-import-card"/>
                                                <Button text="✎ 粘贴文本&#10;创建一个文本知识文档"
                                                        onAction="#importTextRequested" maxWidth="Infinity"
                                                        HBox.hgrow="ALWAYS" wrapText="true"
                                                        styleClass="button, kc-import-card"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kc-col-header">
                                    <children>
                                        <Label text="检索" minWidth="40.0" styleClass="kc-col-head"/>
                                        <Label text="文档" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                               styleClass="kc-col-head"/>
                                        <Label text="片段" minWidth="74.0" styleClass="kc-col-head"/>
                                        <Label text="导入时间" minWidth="96.0" styleClass="kc-col-head"/>
                                        <Region minWidth="24.0"/>
                                    </children>
                                </HBox>
                                <ListView fx:id="documentList" VBox.vgrow="ALWAYS"
                                          styleClass="kc-doc-list" accessibleText="知识库文档列表"/>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="kc-bulk-hint">
                                    <VBox.margin><Insets left="24.0" right="24.0" bottom="14.0"/></VBox.margin>
                                    <children>
                                        <Label text="勾选的文档参与对话检索，可在此统一管理当前范围"
                                               wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                               styleClass="kc-bulk-text"/>
                                        <Hyperlink text="全部启用" onAction="#enableAllRequested"
                                                   styleClass="kc-bulk-link"/>
                                        <Label text="|" styleClass="kc-bulk-sep"/>
                                        <Hyperlink text="全部停用" onAction="#disableAllRequested"
                                                   styleClass="kc-bulk-link"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox fx:id="detailDrawer" prefWidth="368.0" minWidth="368.0"
                              visible="false" managed="false" styleClass="kc-detail-drawer">
                            <children>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="kc-detail-head">
                                    <children>
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox spacing="8.0">
                                                    <children>
                                                        <Label fx:id="detailTypeLabel" text="TXT"
                                                               styleClass="kc-type-badge, kc-type-txt"/>
                                                        <Label fx:id="detailScopeLabel" text="工作区"
                                                               styleClass="kc-scope-tag, kc-scope-workspace"/>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="detailNameLabel" wrapText="true"
                                                       styleClass="kc-detail-name"/>
                                            </children>
                                        </VBox>
                                        <Button text="×" onAction="#closeDetailsRequested"
                                                styleClass="button, kc-detail-close"/>
                                    </children>
                                </HBox>
                                <VBox spacing="12.0" VBox.vgrow="ALWAYS">
                                    <padding><Insets top="18.0" right="20.0" bottom="18.0" left="20.0"/></padding>
                                    <children>
                                        <HBox spacing="12.0">
                                            <children>
                                                <VBox spacing="3.0" HBox.hgrow="ALWAYS" styleClass="kc-meta-card">
                                                    <children>
                                                        <Label text="向量片段" styleClass="kc-meta-label"/>
                                                        <Label fx:id="detailChunksLabel" text="0"
                                                               styleClass="kc-meta-value-lg"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="3.0" HBox.hgrow="ALWAYS" styleClass="kc-meta-card">
                                                    <children>
                                                        <Label text="参与检索" styleClass="kc-meta-label"/>
                                                        <Label fx:id="detailEnabledLabel" text="已启用"
                                                               styleClass="kc-meta-value-accent"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <VBox spacing="3.0" styleClass="kc-meta-card">
                                            <children>
                                                <Label text="导入时间" styleClass="kc-meta-label"/>
                                                <Label fx:id="detailTimeLabel" text="—"
                                                       styleClass="kc-meta-value-time"/>
                                            </children>
                                        </VBox>
                                        <Label text="片段预览" styleClass="kc-detail-section"/>
                                        <ListView fx:id="previewList" VBox.vgrow="ALWAYS"
                                                  styleClass="kc-doc-list" accessibleText="文档片段预览"/>
                                    </children>
                                </VBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="kc-detail-actions">
                                    <children>
                                        <ToggleSwitch fx:id="detailToggle" accessibleText="参与检索"/>
                                        <Label text="参与检索" HBox.hgrow="ALWAYS" styleClass="kc-bulk-text"/>
                                        <Button text="删除" onAction="#deleteRequested"
                                                styleClass="button, jc-btn, jc-btn-danger-soft"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                           styleClass="loading-overlay" accessibleText="正在处理知识文档">
                    <children><ProgressIndicator maxWidth="40.0" maxHeight="40.0"/></children>
                </StackPane>
            </children>
        </StackPane>
    </children>
</VBox>
