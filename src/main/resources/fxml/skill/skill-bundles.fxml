<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" visible="false" managed="false" styleClass="skill-bundles"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javaclaw.ui.javafx.skill.SkillBundlesController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="skill-content-scroll">
            <content>
                <VBox spacing="10.0">
                    <padding><Insets top="4.0" right="2.0" bottom="8.0" left="2.0"/></padding>
                    <children>
                        <Label text="技能包管理" styleClass="sec-title"/>
                        <Label text="技能包是一组配合使用的技能（按技能名引用）+ 可选附加指令；路由命中包时整包注入，包内缺失的技能自动跳过。"
                               wrapText="true" styleClass="sec-hint"/>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Button text="＋ 新建包" onAction="#newRequested"
                                        styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <ListView fx:id="bundleList" prefHeight="180.0" styleClass="skill-card, skill-bundle-list"/>
                        <Label text="编辑包" styleClass="grp-title"/>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="name" styleClass="skill-field-label"/>
                                <TextField fx:id="nameField" promptText="包名" maxWidth="Infinity"
                                           styleClass="skill-field"/>
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="description" styleClass="skill-field-label"/>
                                <TextField fx:id="descriptionField" promptText="包描述：一句话说明何时该用这个包"
                                           maxWidth="Infinity" styleClass="skill-field"/>
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="skills" styleClass="skill-field-label"/>
                                <TextField fx:id="skillsField" promptText="包内技能名，逗号分隔（按技能 name 引用）"
                                           maxWidth="Infinity" styleClass="skill-field"/>
                                <Label text="按技能 name 引用，逗号分隔" styleClass="skill-inline-hint"/>
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="附加指令" styleClass="skill-field-label"/>
                                <TextArea fx:id="instructionsArea" prefRowCount="3" wrapText="true"
                                          promptText="附加指令（可选）：加载包时拼在技能正文之后"
                                          styleClass="text-input, text-area, skill-content-editor"/>
                            </children>
                        </VBox>
                        <CheckBox fx:id="enabledCheck" text="启用此包" selected="true"
                                  styleClass="settings-checkbox"/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="saveButton" text="保存包" onAction="#saveRequested"
                                        styleClass="button, jc-btn, jc-btn-save"/>
                                <Button fx:id="deleteButton" text="删除包" onAction="#deleteRequested"
                                        styleClass="button, jc-btn, jc-btn-danger"/>
                                <Label fx:id="statusLabel" styleClass="settings-status"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
        <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                   styleClass="loading-overlay" accessibleText="正在处理技能包">
            <children><ProgressIndicator maxWidth="36.0" maxHeight="36.0"/></children>
        </StackPane>
    </children>
</StackPane>
