<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" text="脚本检查与测试（scripts/）" expanded="false"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.skill.SkillScriptController">
    <content>
        <VBox spacing="8.0">
            <padding><Insets top="8.0" right="4.0" bottom="4.0" left="4.0"/></padding>
            <children>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                        <ComboBox fx:id="scriptCombo" promptText="选择脚本" prefWidth="200.0"/>
                        <Button text="＋ 新建脚本" onAction="#createRequested"
                                styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                        <Button fx:id="saveButton" text="保存脚本" onAction="#saveRequested"
                                styleClass="button, jc-btn, jc-btn-save, jc-btn-sm"/>
                        <Button text="删除脚本" onAction="#deleteRequested"
                                styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"/>
                    </children>
                </HBox>
                <TextArea fx:id="scriptEditor" wrapText="false" prefRowCount="8"
                          promptText="脚本内容（.jsh / .java，JShell 片段语法）&#10;&#10;可直接使用预绑定变量：&#10;  String SKILL_DIR — 技能目录绝对路径&#10;  String[] ARGS — 测试参数"
                          styleClass="text-input, text-area, skill-content-editor"/>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="scriptArgsField" HBox.hgrow="ALWAYS"
                                   promptText="测试参数（ARGS，逗号分隔，可空）" styleClass="skill-field"/>
                        <Button text="检查" onAction="#checkRequested"
                                styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm">
                            <tooltip><Tooltip text="结构检查（片段切分 + 完整性），不执行任何代码"/></tooltip>
                        </Button>
                        <Button fx:id="runButton" text="▶ 运行测试" onAction="#runRequested"
                                styleClass="button, jc-btn, jc-btn-save, jc-btn-sm">
                            <tooltip><Tooltip text="在独立 JVM 中运行编辑器内的脚本内容"/></tooltip>
                        </Button>
                        <Label fx:id="statusLabel" styleClass="settings-status"/>
                        <Label text="独立 JVM 求值 · 超时见设置" styleClass="skill-inline-hint"/>
                    </children>
                </HBox>
                <TextArea fx:id="scriptOutputArea" editable="false" wrapText="true" prefRowCount="6"
                          promptText="检查 / 运行结果将显示在这里"
                          styleClass="text-input, text-area, skill-content-editor"/>
            </children>
        </VBox>
    </content>
</TitledPane>
