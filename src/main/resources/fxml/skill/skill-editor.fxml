<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" visible="false" managed="false" styleClass="skill-editor"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javaclaw.ui.javafx.skill.SkillEditorController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="skill-content-scroll">
            <content>
                <VBox spacing="10.0">
                    <padding><Insets top="4.0" right="2.0" bottom="4.0" left="2.0"/></padding>
                    <children>
                        <Label text="编辑技能" styleClass="sec-title"/>
                        <Label text="每个技能是一个独立目录，核心文件为 SKILL.md。启用后提示词注入到智能体系统指令。"
                               wrapText="true" styleClass="sec-hint"/>
                        <Label text="基本信息（SKILL.md Front Matter）" styleClass="grp-title"/>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="name" styleClass="skill-field-label"/>
                                <TextField fx:id="nameField" promptText="技能名称" maxWidth="Infinity"
                                           styleClass="skill-field"/>
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="description" styleClass="skill-field-label"/>
                                <TextField fx:id="descriptionField" promptText="技能描述（简要说明用途）"
                                           maxWidth="Infinity" styleClass="skill-field"/>
                            </children>
                        </VBox>
                        <HBox spacing="16.0">
                            <children>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="category" styleClass="skill-field-label"/>
                                        <TextField fx:id="categoryField" promptText="分类（如：编码/浏览器/系统/办公）"
                                                   maxWidth="Infinity" styleClass="skill-field"/>
                                    </children>
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="tags" styleClass="skill-field-label"/>
                                        <TextField fx:id="tagsField" promptText="标签，逗号分隔"
                                                   maxWidth="Infinity" styleClass="skill-field"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <padding><Insets top="10.0"/></padding>
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="启用此技能" styleClass="settings-checkbox"/>
                                        <Label text="路由命中时注入正文" styleClass="skill-toggle-sub"/>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ToggleSwitch fx:id="enabledToggle"/>
                            </children>
                        </HBox>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <padding><Insets top="10.0"/></padding>
                            <children>
                                <Label fx:id="versionLabel" styleClass="jc-badge, jc-badge-soft"/>
                                <Label fx:id="sourceLabel" styleClass="jc-badge, jc-badge-stopped"/>
                                <Label fx:id="usageLabel" styleClass="jc-badge, jc-badge-stopped, skill-usage-badge"/>
                            </children>
                        </HBox>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="版本历史" styleClass="skill-field-label"/>
                                <ComboBox fx:id="historyCombo" promptText="历史版本" prefWidth="140.0"/>
                                <Button text="回滚到此版本" onAction="#rollbackRequested"
                                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"/>
                            </children>
                        </HBox>
                        <Separator/>
                        <Label text="提示词正文（SKILL.md 正文部分）" styleClass="grp-title"/>
                        <TextArea fx:id="contentEditor" wrapText="true" prefRowCount="10"
                                  promptText="在此编写提示词指令..."
                                  styleClass="text-input, text-area, skill-content-editor"/>
                        <Separator/>
                        <fx:include fx:id="script" source="skill-script.fxml"/>
                        <Separator/>
                        <Label text="目录结构" styleClass="grp-title"/>
                        <Label fx:id="directoryStructureLabel" wrapText="true" maxWidth="Infinity"
                               styleClass="skill-dir-block"/>
                        <Separator/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="saveButton" text="保存" onAction="#saveRequested"
                                        styleClass="button, jc-btn, jc-btn-save"/>
                                <Button text="打开目录" onAction="#openDirectoryRequested"
                                        styleClass="button, jc-btn, jc-btn-ghost"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="statusLabel" styleClass="settings-status"/>
                                <Button text="删除" onAction="#deleteRequested"
                                        styleClass="button, jc-btn, jc-btn-danger"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
        <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                   styleClass="loading-overlay" accessibleText="正在保存技能">
            <children><ProgressIndicator maxWidth="36.0" maxHeight="36.0"/></children>
        </StackPane>
    </children>
</StackPane>
