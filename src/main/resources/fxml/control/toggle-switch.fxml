<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="track" alignment="CENTER_LEFT" onMouseClicked="#toggleRequested"
           styleClass="jc-switch" accessibleText="开关"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets right="2.0" left="2.0"/>
    </padding>
    <children>
        <Region fx:id="thumb" styleClass="jc-switch-thumb" mouseTransparent="true"/>
    </children>
</StackPane>
