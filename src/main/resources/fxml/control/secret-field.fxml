<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="root" prefWidth="350.0" maxWidth="Infinity"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javaclaw.ui.javafx.control.SecretFieldController">
    <children>
        <PasswordField fx:id="secretField" maxWidth="Infinity"
                       styleClass="text-input, text-field, password-field, settings-field"/>
        <TextField fx:id="plainField" maxWidth="Infinity" visible="false" managed="false"
                   styleClass="text-input, text-field, settings-field"/>
        <HBox alignment="CENTER_RIGHT" spacing="4.0" mouseTransparent="false"
              pickOnBounds="false" StackPane.alignment="CENTER_RIGHT">
            <padding><Insets right="6.0"/></padding>
            <children>
                <Button fx:id="revealButton" text="显示" focusTraversable="false"
                        styleClass="button, field-adorn" onAction="#revealRequested"/>
                <Button fx:id="copyButton" text="复制" focusTraversable="false"
                        styleClass="button, field-adorn" onAction="#copyRequested"/>
            </children>
        </HBox>
    </children>
</StackPane>
