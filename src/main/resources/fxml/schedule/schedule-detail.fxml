<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="12.0" visible="false" managed="false"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.schedule.ScheduleDetailController">
    <padding><Insets top="2.0" right="2.0" bottom="2.0" left="2.0"/></padding>
    <fx:define><ToggleGroup fx:id="triggerGroup"/></fx:define>
    <children>
        <VBox fx:id="builtinPanel" spacing="12.0" visible="false" managed="false">
            <children>
                <VBox spacing="12.0" styleClass="jc-card">
                    <padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding>
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="builtinName" styleClass="jc-stat-value, schedule-builtin-name"/>
                                <Label text="系统内置" styleClass="jc-badge, jc-badge-stopped"/>
                            </children>
                        </HBox>
                        <Label fx:id="builtinDescription" maxWidth="Infinity" wrapText="true"
                               styleClass="sec-hint"/>
                        <HBox spacing="24.0" alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="4.0">
                                    <children><Label text="触发" styleClass="jc-stat-label"/>
                                        <Label fx:id="builtinTrigger" styleClass="jc-stat-value"/></children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children><Label text="来源模块" styleClass="jc-stat-label"/>
                                        <Label fx:id="builtinSource" styleClass="jc-stat-value"/></children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children><Label text="状态" styleClass="jc-stat-label"/>
                                        <Label text="常驻运行" styleClass="sec-hint"/></children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Label fx:id="builtinNote" maxWidth="Infinity" wrapText="true"
                       styleClass="sec-hint, empty-state-hint"/>
                <Separator/>
            </children>
        </VBox>

        <VBox fx:id="editablePanel" spacing="12.0" visible="false" managed="false">
            <children>
                <VBox spacing="14.0" styleClass="jc-card">
                    <padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding>
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="nameField" promptText="任务名称" maxWidth="Infinity"
                                           HBox.hgrow="ALWAYS" styleClass="schedule-name-field"/>
                                <Label fx:id="stateLabel" styleClass="sec-hint"/>
                                <ToggleSwitch fx:id="enabledToggle" accessibleText="启用定时任务"/>
                            </children>
                        </HBox>
                        <HBox spacing="24.0" alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="4.0">
                                    <children><Label text="触发" styleClass="jc-stat-label"/>
                                        <Label fx:id="triggerStat" styleClass="jc-stat-value"/></children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children><Label text="下次运行" styleClass="jc-stat-label"/>
                                        <Label fx:id="nextStat" styleClass="jc-stat-value"/>
                                        <Label fx:id="nextSub" styleClass="jc-stat-sub"/></children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children><Label text="上次运行" styleClass="jc-stat-label"/>
                                        <HBox spacing="6.0" alignment="CENTER_LEFT">
                                            <children><Label fx:id="lastStat" styleClass="jc-stat-value"/>
                                                <Label fx:id="lastBadge" visible="false" managed="false"
                                                       styleClass="jc-badge"/></children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children><Label text="累计 / 失败" styleClass="jc-stat-label"/>
                                        <Label fx:id="runsStat" styleClass="jc-stat-value"/></children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label text="触发方式" styleClass="grp-title"/>
                <HBox spacing="3.0" styleClass="seg-container">
                    <children>
                        <ToggleButton fx:id="onceButton" text="一次性" userData="once"
                                      toggleGroup="$triggerGroup" onAction="#triggerRequested"
                                      styleClass="toggle-button, seg-btn"/>
                        <ToggleButton fx:id="intervalButton" text="间隔" userData="interval"
                                      toggleGroup="$triggerGroup" onAction="#triggerRequested"
                                      styleClass="toggle-button, seg-btn"/>
                        <ToggleButton fx:id="dailyButton" text="每日" userData="daily"
                                      toggleGroup="$triggerGroup" onAction="#triggerRequested"
                                      styleClass="toggle-button, seg-btn"/>
                        <ToggleButton fx:id="cronButton" text="Cron" userData="cron"
                                      toggleGroup="$triggerGroup" onAction="#triggerRequested"
                                      styleClass="toggle-button, seg-btn"/>
                    </children>
                </HBox>
                <VBox fx:id="onceFields" spacing="8.0" visible="false" managed="false">
                    <padding><Insets top="10.0"/></padding>
                    <children>
                        <HBox spacing="12.0" alignment="BOTTOM_LEFT">
                            <children>
                                <VBox spacing="4.0"><children><Label text="日期" styleClass="jc-stat-label"/>
                                    <TextField fx:id="onceDateField" promptText="日期" prefWidth="130.0"
                                               styleClass="settings-field"/></children></VBox>
                                <VBox spacing="4.0"><children><Label text="时间" styleClass="jc-stat-label"/>
                                    <TextField fx:id="onceTimeField" promptText="时间" prefWidth="90.0"
                                               styleClass="settings-field"/></children></VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox fx:id="intervalFields" spacing="8.0" visible="false" managed="false">
                    <padding><Insets top="10.0"/></padding>
                    <children>
                        <HBox spacing="12.0" alignment="BOTTOM_LEFT">
                            <children>
                                <VBox spacing="4.0"><children><Label text="每隔" styleClass="jc-stat-label"/>
                                    <TextField fx:id="intervalValueField" promptText="每隔" prefWidth="90.0"
                                               styleClass="settings-field"/></children></VBox>
                                <VBox spacing="4.0"><children><Label text="单位" styleClass="jc-stat-label"/>
                                    <ComboBox fx:id="intervalUnitCombo"/></children></VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox fx:id="dailyFields" spacing="8.0" visible="false" managed="false">
                    <padding><Insets top="10.0"/></padding>
                    <children>
                        <HBox spacing="8.0" alignment="BOTTOM_LEFT">
                            <children>
                                <VBox spacing="4.0"><children><Label text="时间" styleClass="jc-stat-label"/>
                                    <TextField fx:id="dailyTimeField" promptText="时间" prefWidth="100.0"
                                               styleClass="settings-field"/></children></VBox>
                                <Label text="（24 小时制，如 09:30）" styleClass="sec-hint"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox fx:id="cronFields" spacing="8.0" visible="false" managed="false">
                    <padding><Insets top="10.0"/></padding>
                    <children>
                        <VBox spacing="4.0"><children><Label text="Cron 表达式" styleClass="jc-stat-label"/>
                            <TextField fx:id="cronField" promptText="Cron 表达式" prefWidth="280.0"
                                       styleClass="settings-field"/></children></VBox>
                        <Label fx:id="cronHint" styleClass="sec-hint"/>
                        <FlowPane hgap="6.0" vgap="6.0">
                            <children>
                                <Button text="每天 09:00 → 0 0 9 * * ?" userData="0 0 9 * * ?"
                                        onAction="#cronPresetRequested" styleClass="button, jc-chip"/>
                                <Button text="每周一 18:00 → 0 0 18 ? * MON" userData="0 0 18 ? * MON"
                                        onAction="#cronPresetRequested" styleClass="button, jc-chip"/>
                                <Button text="每小时 → 0 0 * * * ?" userData="0 0 * * * ?"
                                        onAction="#cronPresetRequested" styleClass="button, jc-chip"/>
                                <Button text="每 15 分 → 0 0/15 * * * ?" userData="0 0/15 * * * ?"
                                        onAction="#cronPresetRequested" styleClass="button, jc-chip"/>
                            </children>
                        </FlowPane>
                    </children>
                </VBox>

                <Separator/>
                <Label text="执行内容" styleClass="grp-title"/>
                <Label text="提示词 / 指令" styleClass="jc-stat-label"/>
                <Label text="任务触发时，以下内容将作为用户消息发送给智能体执行" styleClass="sec-hint"/>
                <TextArea fx:id="promptArea" wrapText="true" prefRowCount="3"
                          promptText="描述要自动执行的任务…&#10;例如：检索今天的中文科技要闻 Top 8 并推送到钉钉"
                          styleClass="skill-content-editor"/>

                <Separator/>
                <Label text="完成后通知" styleClass="grp-title"/>
                <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="jc-card-sunken">
                    <padding><Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/></padding>
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children><Label text="运行完成后推送通知" styleClass="jc-stat-value"/>
                                <Label text="选择渠道，任务每次结束时发送执行结果" styleClass="sec-hint"/></children>
                        </VBox>
                        <ComboBox fx:id="channelCombo"/>
                        <ToggleSwitch fx:id="notifyToggle" accessibleText="完成后通知"/>
                    </children>
                </HBox>

                <Separator/>
                <Label text="无人值守授权" styleClass="grp-title"/>
                <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="jc-card-sunken">
                    <padding><Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/></padding>
                    <children>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <children><Label text="允许无人值守执行高风险工具" styleClass="jc-stat-value"/>
                                <Label maxWidth="Infinity" wrapText="true" styleClass="sec-hint"
                                       text="开启后，本任务定时执行时遇到 jshell、命令执行等高风险确认将自动放行。仅对本任务生效，请只在信任其提示词时开启；工具审核模式为「手动」时本授权失效。"/></children>
                        </VBox>
                        <ToggleSwitch fx:id="authorizeToggle" accessibleText="无人值守高风险工具授权"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <Separator/>
        <Label text="运行历史" styleClass="grp-title"/>
        <VBox styleClass="jc-card, schedule-history-card">
            <children>
                <GridPane styleClass="jc-table-head">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="38.0"/><ColumnConstraints percentWidth="18.0"/>
                        <ColumnConstraints percentWidth="18.0"/><ColumnConstraints percentWidth="26.0"/>
                    </columnConstraints>
                    <children>
                        <Label text="时间" GridPane.columnIndex="0" styleClass="jc-table-head-cell"/>
                        <Label text="状态" GridPane.columnIndex="1" styleClass="jc-table-head-cell"/>
                        <Label text="耗时" GridPane.columnIndex="2" styleClass="jc-table-head-cell"/>
                        <Label text="Token / 备注" GridPane.columnIndex="3" styleClass="jc-table-head-cell"/>
                    </children>
                </GridPane>
                <Label fx:id="historyPlaceholder" text="暂无执行记录" styleClass="sec-hint">
                    <padding><Insets top="10.0" right="13.0" bottom="10.0" left="13.0"/></padding>
                </Label>
                <ListView fx:id="historyList" prefHeight="150.0" fixedCellSize="38.0"
                          styleClass="schedule-history-list" accessibleText="运行历史"/>
            </children>
        </VBox>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="8.0" bottom="4.0"/></padding>
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="deleteButton" text="删除任务" onAction="#deleteRequested"
                        styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"/>
            </children>
        </HBox>
    </children>
</VBox>
