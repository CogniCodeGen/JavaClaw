<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="root" styleClass="settings-root" accessibleText="定时任务中心"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.schedule.ScheduleViewController">
    <children>
        <VBox prefWidth="264.0" minWidth="220.0" styleClass="modal-left-pane">
            <children>
                <Label text="定时任务" styleClass="modal-left-title">
                    <padding><Insets top="18.0" right="16.0" bottom="4.0" left="16.0"/></padding>
                </Label>
                <Label fx:id="listSubtitle" styleClass="sec-hint">
                    <padding><Insets right="16.0" bottom="8.0" left="16.0"/></padding>
                </Label>
                <VBox>
                    <padding><Insets right="12.0" bottom="10.0" left="12.0"/></padding>
                    <children>
                        <Button text="＋ 新建定时任务" maxWidth="Infinity" onAction="#createRequested"
                                styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                    </children>
                </VBox>
                <ListView fx:id="taskList" VBox.vgrow="ALWAYS" fixedCellSize="92.0"
                          styleClass="schedule-task-list" accessibleText="定时任务列表"/>
            </children>
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <children>
                <StackPane VBox.vgrow="ALWAYS" styleClass="modal-content-area">
                    <padding><Insets top="20.0" right="24.0" bottom="12.0" left="24.0"/></padding>
                    <children>
                        <VBox fx:id="emptyPanel" spacing="12.0" alignment="CENTER">
                            <children>
                                <Label text="⏰" styleClass="empty-state-icon"/>
                                <Label text="选择或新建一个定时任务" styleClass="empty-state-text"/>
                                <Label maxWidth="340.0" wrapText="true" textAlignment="CENTER"
                                       text="定时任务可按一次性、固定间隔、每日定时或 Cron 触发；&#10;触发时把配置的提示词发送给智能体自动执行。"
                                       styleClass="sec-hint, empty-state-hint"/>
                            </children>
                        </VBox>
                        <ScrollPane fx:id="detailScroll" fitToWidth="true" hbarPolicy="NEVER"
                                    visible="false" managed="false"
                                    styleClass="settings-scroll-pane">
                            <content>
                                <fx:include fx:id="details" source="schedule-detail.fxml"/>
                            </content>
                        </ScrollPane>
                        <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                                   styleClass="loading-overlay" accessibleText="正在处理定时任务">
                            <children><ProgressIndicator maxWidth="40.0" maxHeight="40.0"/></children>
                        </StackPane>
                    </children>
                </StackPane>
                <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="modal-foot">
                    <children>
                        <Button fx:id="runButton" text="▶ 立即运行一次" onAction="#runRequested"
                                styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"/>
                        <Label fx:id="statusLabel" maxWidth="360.0" wrapText="true"
                               styleClass="sec-hint"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="关闭" onAction="#requestClose"
                                styleClass="button, jc-btn, jc-btn-ghost"/>
                        <Button fx:id="saveButton" text="保存" onAction="#saveRequested"
                                styleClass="button, jc-btn, jc-btn-save"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>
