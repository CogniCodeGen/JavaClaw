<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="root" fitToWidth="true" hbarPolicy="NEVER"
            visible="false" managed="false" styleClass="scroll-pane, settings-scroll-pane"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javaclaw.ui.javafx.plugin.PluginDetailController">
    <content>
        <StackPane>
            <children>
                <VBox fx:id="detailContent" spacing="12.0">
                    <padding><Insets top="18.0" right="22.0" bottom="16.0" left="22.0"/></padding>
                    <children>
                        <Button text="← 返回列表" accessibleText="返回插件列表"
                                styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"
                                onAction="#backRequested"/>
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                            <children>
                                <Label fx:id="glyphLabel" styleClass="plugin-glyph-lg"/>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label fx:id="nameLabel" styleClass="sec-title"/>
                                                <Label fx:id="stateBadge"
                                                       styleClass="jc-badge, jc-badge-stopped"
                                                       style="-fx-font-size:9.5px; -fx-padding:1 7 1 7;"/>
                                            </children>
                                        </HBox>
                                        <Label fx:id="metadataLabel" styleClass="plugin-card-meta"/>
                                    </children>
                                </VBox>
                                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                    <children>
                                        <Label fx:id="stateTextLabel" styleClass="sec-hint"/>
                                        <ToggleSwitch fx:id="enabledToggle"
                                                      accessibleText="启用或停用当前插件"/>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                        <Label fx:id="descriptionLabel" wrapText="true" styleClass="plugin-detail-desc"/>
                        <Label text="所需权限" styleClass="grp-title"/>
                        <Label fx:id="permissionEmptyLabel" text="该插件未申请任何宿主能力。"
                               styleClass="sec-hint"/>
                        <VBox fx:id="permissionsBox" spacing="6.0"/>
                        <VBox fx:id="skillsSection" spacing="6.0" visible="false" managed="false">
                            <children>
                                <Label fx:id="skillsTitle" styleClass="grp-title"/>
                                <VBox fx:id="skillsItems" spacing="2.0"/>
                            </children>
                        </VBox>
                        <VBox fx:id="toolsSection" spacing="6.0" visible="false" managed="false">
                            <children>
                                <Label fx:id="toolsTitle" styleClass="grp-title"/>
                                <VBox fx:id="toolsItems" spacing="2.0"/>
                            </children>
                        </VBox>
                        <Label fx:id="exposureHint" wrapText="true" styleClass="sec-hint"/>
                        <VBox fx:id="configSection" spacing="8.0" visible="false" managed="false">
                            <children>
                                <Label text="插件配置" styleClass="grp-title"/>
                                <VBox fx:id="configFields" spacing="8.0"/>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Button fx:id="saveConfigButton" text="保存配置"
                                                styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"
                                                onAction="#saveConfigRequested"/>
                                        <Label fx:id="configSavedLabel" styleClass="sec-hint"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <Label fx:id="failureLabel" wrapText="true" visible="false" managed="false"
                               styleClass="sec-hint, status-error"/>
                        <Label fx:id="statusLabel" visible="false" managed="false"
                               styleClass="sec-hint"/>
                        <Separator/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button text="打开插件目录"
                                        styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"
                                        onAction="#openDirectoryRequested"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="uninstallButton" text="卸载"
                                        styleClass="button, jc-btn, jc-btn-danger, jc-btn-sm"
                                        onAction="#uninstallRequested"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                           styleClass="loading-overlay" accessibleText="正在加载插件详情">
                    <children><ProgressIndicator maxWidth="40.0" maxHeight="40.0"/></children>
                </StackPane>
            </children>
        </StackPane>
    </content>
</ScrollPane>
