<?xml version="1.0" encoding="UTF-8"?>

<?import com.javaclaw.ui.javafx.control.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="330.0" spacing="10.0" styleClass="plugin-card"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.plugin.PluginCardController">
    <padding><Insets top="13.0" right="13.0" bottom="13.0" left="13.0"/></padding>
    <children>
        <HBox fx:id="headerRow" alignment="CENTER_LEFT" spacing="11.0"
              style="-fx-cursor: hand;" onMouseClicked="#detailsRequested"
              accessibleText="打开插件详情">
            <children>
                <Label fx:id="glyphLabel" text="⧉" styleClass="plugin-glyph"/>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <Label fx:id="nameLabel" maxWidth="160.0" styleClass="plugin-card-name"/>
                                <Label fx:id="stateBadge" styleClass="jc-badge, jc-badge-stopped"
                                       style="-fx-font-size:9.5px; -fx-padding:1 7 1 7;"/>
                            </children>
                        </HBox>
                        <Label fx:id="metadataLabel" styleClass="plugin-card-meta"/>
                    </children>
                </VBox>
            </children>
        </HBox>
        <Label fx:id="descriptionLabel" wrapText="true" maxWidth="280.0" maxHeight="40.0"
               styleClass="plugin-card-desc"/>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="failureBadge" text="启用失败" visible="false" managed="false"
                       styleClass="jc-badge, jc-badge-failed"
                       style="-fx-font-size:10px; -fx-padding:1 8 1 8;"/>
                <Button fx:id="approvalButton" text="批准并注册"
                        visible="false" managed="false"
                        accessibleText="批准并注册服务插件"
                        styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"
                        onAction="#approvalRequested"/>
                <ToggleSwitch fx:id="enabledToggle" accessibleText="启用或停用插件"/>
            </children>
        </HBox>
    </children>
</VBox>
