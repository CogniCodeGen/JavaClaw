<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="root" styleClass="settings-root"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javaclaw.ui.javafx.plugin.PluginCenterController">
    <fx:define>
        <ToggleGroup fx:id="tabGroup"/>
    </fx:define>
    <children>
        <VBox prefWidth="228.0" minWidth="210.0" styleClass="modal-left-pane">
            <children>
                <VBox spacing="4.0" styleClass="plugin-nav-heading">
                    <padding><Insets top="20.0" right="18.0" bottom="14.0" left="18.0"/></padding>
                    <children>
                        <Label text="插件中心" styleClass="modal-left-title"/>
                        <Label text="扩展 JavaClaw 的能力" styleClass="sec-hint"/>
                    </children>
                </VBox>
                <VBox spacing="3.0" styleClass="plugin-nav-list">
                    <padding><Insets right="12.0" bottom="12.0" left="12.0"/></padding>
                    <children>
                        <Label text="插件" styleClass="modal-nav-group"/>
                        <ToggleButton fx:id="installedTab" text="已安装插件" selected="true"
                                      maxWidth="Infinity" toggleGroup="$tabGroup"
                                      styleClass="toggle-button, modal-nav-btn"
                                      onAction="#installedTabRequested"/>
                        <ToggleButton fx:id="marketTab" text="插件市场" maxWidth="Infinity"
                                      toggleGroup="$tabGroup"
                                      styleClass="toggle-button, modal-nav-btn"
                                      onAction="#marketTabRequested"/>
                        <Label text="扩展能力" styleClass="modal-nav-group"/>
                        <ToggleButton fx:id="agentExtensionsTab" text="Agent 扩展"
                                      maxWidth="Infinity" toggleGroup="$tabGroup"
                                      styleClass="toggle-button, modal-nav-btn"
                                      onAction="#agentExtensionsTabRequested"/>
                        <ToggleButton fx:id="servicePluginsTab" text="服务插件"
                                      maxWidth="Infinity" toggleGroup="$tabGroup"
                                      styleClass="toggle-button, modal-nav-btn"
                                      onAction="#servicePluginsTabRequested"/>
                    </children>
                </VBox>
                <Region VBox.vgrow="ALWAYS"/>
                <VBox spacing="6.0" styleClass="plugin-nav-bottom">
                    <padding><Insets top="10.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                    <children>
                        <Button fx:id="installButton" text="＋ 从文件安装…" maxWidth="Infinity"
                                accessibleText="从 jar 文件安装插件"
                                styleClass="button, jc-btn, jc-btn-soft, jc-btn-sm"
                                onAction="#installRequested"/>
                        <Button fx:id="refreshButton" text="刷新当前页面" maxWidth="Infinity"
                                accessibleText="刷新插件目录"
                                styleClass="button, jc-btn, jc-btn-ghost, jc-btn-sm"
                                onAction="#refreshRequested"/>
                    </children>
                </VBox>
            </children>
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <children>
                <StackPane styleClass="modal-content-area" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox fx:id="listView" spacing="12.0">
                            <children>
                                <VBox spacing="12.0" styleClass="plugin-page-header">
                                    <padding><Insets top="22.0" right="24.0" bottom="0.0" left="24.0"/></padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="已安装插件" styleClass="plugin-page-title"/>
                                                        <Label text="管理进程内插件、权限和工作区启用状态"
                                                               styleClass="sec-hint"/>
                                                    </children>
                                                </VBox>
                                                <Label fx:id="countLabel"
                                                       styleClass="jc-badge, jc-badge-soft"/>
                                            </children>
                                        </HBox>
                                        <TextField fx:id="searchField" promptText="搜索插件名称或描述"
                                                   accessibleText="搜索已安装插件"
                                                   maxWidth="520.0"
                                                   styleClass="text-input, text-field, settings-field"/>
                                    </children>
                                </VBox>
                                <StackPane VBox.vgrow="ALWAYS">
                                    <children>
                                        <ScrollPane fx:id="cardScroll" fitToWidth="true"
                                                    hbarPolicy="NEVER" styleClass="scroll-pane, settings-scroll-pane">
                                            <content>
                                                <FlowPane fx:id="cardGrid" hgap="12.0" vgap="12.0">
                                                    <padding><Insets top="8.0" right="22.0" bottom="16.0" left="22.0"/></padding>
                                                </FlowPane>
                                            </content>
                                        </ScrollPane>
                                        <VBox fx:id="marketPlaceholder" alignment="CENTER" spacing="12.0"
                                              visible="false" managed="false" accessibleText="插件市场尚未上线">
                                            <children>
                                                <Label text="⧉" styleClass="empty-state-icon"/>
                                                <Label text="插件市场即将上线" styleClass="empty-state-text"/>
                                                <Label maxWidth="360.0" wrapText="true"
                                                       text="在线插件市场（搜索 / 一键安装 / 自动更新）尚未接入。&#10;当前可通过「从文件安装…」加载本地插件 jar。"
                                                       styleClass="sec-hint, empty-state-hint"/>
                                            </children>
                                        </VBox>
                                        <VBox fx:id="emptyPlaceholder" alignment="CENTER" spacing="10.0"
                                              visible="false" managed="false">
                                            <children>
                                                <Label text="⧉" styleClass="empty-state-icon"/>
                                                <Label fx:id="emptyMessage" maxWidth="360.0" wrapText="true"
                                                       styleClass="sec-hint, empty-state-hint"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </StackPane>
                            </children>
                        </VBox>
                        <VBox fx:id="agentExtensionView" visible="false" managed="false"
                              spacing="16.0">
                            <padding><Insets top="22.0" right="24.0" bottom="20.0" left="24.0"/></padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Agent 扩展" styleClass="plugin-page-title"/>
                                                <Label text="外部 JAR 以内容哈希缓存；停用只影响新 Run，已锁定 Run 继续使用原 artifact。"
                                                       wrapText="true" styleClass="sec-hint"/>
                                            </children>
                                        </VBox>
                                        <Label fx:id="agentExtensionCount"
                                               styleClass="jc-badge, jc-badge-soft"/>
                                        <Button fx:id="installAgentExtensionButton"
                                                text="从 JAR 安装…"
                                                styleClass="button, jc-btn, jc-btn-primary, jc-btn-sm"
                                                onAction="#installAgentExtensionRequested"/>
                                    </children>
                                </HBox>
                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                            styleClass="scroll-pane, settings-scroll-pane"
                                            VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox fx:id="agentExtensionList" spacing="10.0">
                                            <padding><Insets top="8.0" right="4.0" bottom="12.0" left="4.0"/></padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                        <VBox fx:id="servicePluginView" visible="false" managed="false"
                              spacing="16.0">
                            <padding><Insets top="22.0" right="24.0" bottom="20.0" left="24.0"/></padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="服务插件" styleClass="plugin-page-title"/>
                                                <Label text="重型能力在独立 JVM 中运行，与 Desktop 通过鉴权 Socket 通信"
                                                       wrapText="true" styleClass="sec-hint"/>
                                            </children>
                                        </VBox>
                                        <Label fx:id="servicePluginCount"
                                               styleClass="jc-badge, jc-badge-soft"/>
                                    </children>
                                </HBox>
                                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                                            styleClass="scroll-pane, settings-scroll-pane"
                                            VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox fx:id="servicePluginList" spacing="12.0"
                                              styleClass="service-plugin-list">
                                            <padding><Insets top="8.0" right="4.0" bottom="16.0" left="4.0"/></padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                        <fx:include fx:id="servicePluginConfiguration"
                                    source="service-plugin-configuration.fxml"/>
                        <fx:include fx:id="detailPanel" source="plugin-detail.fxml"/>
                        <StackPane fx:id="loadingOverlay" visible="false" managed="false"
                                   styleClass="loading-overlay" accessibleText="插件操作进行中">
                            <children><ProgressIndicator maxWidth="40.0" maxHeight="40.0"/></children>
                        </StackPane>
                    </children>
                </StackPane>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="modal-foot">
                    <children>
                        <Label fx:id="directoryLabel" maxWidth="560.0" textOverrun="CENTER_ELLIPSIS"
                               styleClass="sec-hint, plugin-directory-label"/>
                        <Label fx:id="statusLabel" visible="false" managed="false"
                               styleClass="sec-hint"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="关闭" styleClass="button, jc-btn, jc-btn-ghost"
                                onAction="#closeRequested"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>
